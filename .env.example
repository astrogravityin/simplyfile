# Every setting this portal reads from its environment - names only, never a real value (owner 2026-11-12, chip
# standards.naming env_file). The real values live in the service's environment (systemd Environment= / start.cmd).
# Copy to .env only on a developer machine; .env is never committed. selfcheck 'standards' fails a setting read by the
# code and missing here.

# ---- where it runs
PORTAL_DATA=data                      # data folder (TV_DATA is the older name, still read)
TV_DATA=
PORTAL_BASE=                          # "/tv" when hosted under a path
PORTAL_HTTPS=1                        # cookies marked Secure behind HTTPS
PORTAL_TRUSTED_PROXY=nginx            # whose forwarded address to believe
PORTAL_COOKIE=portal_session
PORTAL_SESSION_DAYS=
PORTAL_AUTH_PER_MINUTE=
WEB_CONCURRENCY=1                     # more than 1 = several workers (jobs then run once, on the first)
PORTAL_MEMORY_LIMIT_MB=
PORTAL_DISK_PATHS=                    # extra disks the health check watches (os.pathsep between)

# ---- who and which product
PORTAL_OWNER_EMAIL=owner@example.invalid
PORTAL_EDITION=                       # which row of chip edition.settings (TV_EDITION is the older name)
TV_EDITION=
PORTAL_PRODUCT_NAME=

# ---- demo site (PORTAL_DEMO=1)
PORTAL_DEMO=
PORTAL_DEMO_OWNER=

# ---- secrets (set on the server only)
PORTAL_DATABASE_URL=                  # only when chip store.engine says postgres (its url_env)
SSO_SITE_KEY=CHANGE_ME
CONNECT_STORE_KEY=CHANGE_ME

# ---- optional features
PORTAL_GEOIP=                         # off = no visitor country
PORTAL_GEOIP_DB=
PORTAL_AGENTS_CLOCK=                  # off = agents never run on their schedule (tests)
TV_SCAN_ROOTS=
TV_VIDEO_ROOT=

# ---- tools only (tour videos, screen sweeps), on a developer machine
TOUR_AUTH=
TOUR_USER=
TOUR_PASSWORD=
TOUR_MASK=
TOUR_MASK_WORDS=
SWEEP_EMAIL=
SWEEP_PASSWORD=
AUDIT_LANG=
AUDIT_LOGINS=
AUDIT_VIEWS=
SC_PORT=
# tools/restore_drill.py (monthly cron, DEPLOY.md step 6b): the app folder and the backups folder it drills
SF_APP=
SF_BACKUPS=
