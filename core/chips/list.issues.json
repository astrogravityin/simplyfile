{
  "chip_id": "list.issues",
  "kind": "accessor",
  "set": "list",
  "label": "Reported issues: the admin's queue",
  "aliases": [
    "issue queue"
  ],
  "params": [
    {
      "name": "search_keys",
      "type": "list",
      "default": [
        "title",
        "text",
        "name",
        "email",
        "surface",
        "context"
      ],
      "label": "search keys"
    },
    {
      "name": "sort_key",
      "type": "text",
      "default": "at",
      "label": "sort key"
    },
    {
      "name": "sort_desc",
      "type": "boolean",
      "default": true,
      "label": "sort desc"
    },
    {
      "name": "sorts",
      "type": "list",
      "default": [
        "at",
        "status",
        "surface"
      ],
      "label": "sorts"
    },
    {
      "name": "page_size",
      "type": "number",
      "default": 20,
      "label": "page size"
    },
    {
      "name": "max_page_size",
      "type": "number",
      "default": 100,
      "label": "max page size"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "search_keys": "$search_keys",
      "sort_key": "$sort_key",
      "sort_desc": "$sort_desc",
      "sorts": "$sorts",
      "page_size": "$page_size",
      "max_page_size": "$max_page_size"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-09-28. The Reported issues queue, searched, sorted and paged on the server (core/lists.py).",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "search_keys": [
          "title",
          "text",
          "name",
          "email",
          "surface",
          "context"
        ],
        "sort_key": "at",
        "sort_desc": true,
        "sorts": [
          "at",
          "status",
          "surface"
        ],
        "page_size": 20,
        "max_page_size": 100
      }
    }
  ]
}
