{
  "chip_id": "ui.menus",
  "kind": "accessor",
  "set": "ui",
  "label": "Every word on the Menu builder screen",
  "aliases": [],
  "params": [
    {
      "name": "title",
      "type": "text",
      "default": "Menu builder"
    },
    {
      "name": "lede",
      "type": "text",
      "default": "The menu {product} shows its members, as folders and screens. Drag a row by its grip to move it; a screen dropped under a folder joins it. Removing a screen takes it off the menu only - its page stays. A new screen arrives as a <b>Draft</b> only you see until you make it <b>Live</b>."
    },
    {
      "name": "find_placeholder",
      "type": "text",
      "default": "Find a screen"
    },
    {
      "name": "no_match",
      "type": "text",
      "default": "No screen matches."
    },
    {
      "name": "col_name",
      "type": "text",
      "default": "Name"
    },
    {
      "name": "col_group",
      "type": "text",
      "default": "Group"
    },
    {
      "name": "col_icon",
      "type": "text",
      "default": "Icon"
    },
    {
      "name": "col_state",
      "type": "text",
      "default": "Shown to"
    },
    {
      "name": "live",
      "type": "text",
      "default": "Live"
    },
    {
      "name": "draft",
      "type": "text",
      "default": "Draft"
    },
    {
      "name": "owner_only",
      "type": "text",
      "default": "Owner only"
    },
    {
      "name": "drafts_waiting",
      "type": "text",
      "default": "{n} new {n:screen|screens} waiting to go live."
    },
    {
      "name": "reset",
      "type": "text",
      "default": "Back to the original"
    },
    {
      "name": "reset_q",
      "type": "text",
      "default": "Put this screen back?"
    },
    {
      "name": "reset_body",
      "type": "text",
      "default": "\"{label}\" goes back to the name, group and icon the portal gave it."
    },
    {
      "name": "drag",
      "type": "text",
      "default": "Drag to move (Alt + arrow keys too)"
    },
    {
      "name": "drag_off",
      "type": "text",
      "default": "Clear the search to reorder."
    },
    {
      "name": "save",
      "type": "text",
      "default": "Save the menu"
    },
    {
      "name": "saved",
      "type": "text",
      "default": "Menu saved."
    },
    {
      "name": "unsaved",
      "type": "text",
      "default": "Changes not saved yet."
    },
    {
      "name": "make_live",
      "type": "text",
      "default": "Click to put it live: Access Control then decides who sees it"
    },
    {
      "name": "make_draft",
      "type": "text",
      "default": "Click to make it a draft again: only you see it"
    },
    {
      "name": "pick_icon",
      "type": "text",
      "default": "Pick an icon"
    },
    {
      "name": "col_screen",
      "type": "text",
      "default": "Screen"
    },
    {
      "name": "col_under",
      "type": "text",
      "default": "Under"
    },
    {
      "name": "col_label",
      "type": "text",
      "default": "Menu label"
    },
    {
      "name": "col_order",
      "type": "text",
      "default": "Order"
    },
    {
      "name": "new_group",
      "type": "text",
      "default": "New folder"
    },
    {
      "name": "new_group_name",
      "type": "text",
      "default": "New folder"
    },
    {
      "name": "no_group",
      "type": "text",
      "default": "— No folder —"
    },
    {
      "name": "group_name",
      "type": "text",
      "default": "Folder name"
    },
    {
      "name": "group_count",
      "type": "text",
      "default": "{n} {n:screen|screens}"
    },
    {
      "name": "move_up",
      "type": "text",
      "default": "Move up"
    },
    {
      "name": "move_down",
      "type": "text",
      "default": "Move down"
    },
    {
      "name": "delete_group",
      "type": "text",
      "default": "Delete this folder"
    },
    {
      "name": "group_not_empty",
      "type": "text",
      "default": "Move its screens to another folder first"
    },
    {
      "name": "delete_group_q",
      "type": "text",
      "default": "Delete this folder?"
    },
    {
      "name": "delete_group_body",
      "type": "text",
      "default": "\"{name}\" has no screens. It leaves the menu when you save."
    },
    {
      "name": "group_empty",
      "type": "text",
      "default": "Empty - kept once a screen is under it"
    },
    {
      "name": "hide",
      "type": "text",
      "default": "Remove from the menu (the page stays)"
    },
    {
      "name": "hide_q",
      "type": "text",
      "default": "Remove from the menu?"
    },
    {
      "name": "hide_body",
      "type": "text",
      "default": "\"{label}\" leaves the menu. Its page is not deleted: it still opens by its link, Access Control still decides who may open it, and you can put it back from Not in the menu."
    },
    {
      "name": "hide_yes",
      "type": "text",
      "default": "Remove from menu"
    },
    {
      "name": "off_menu_title",
      "type": "text",
      "default": "Not in the menu"
    },
    {
      "name": "off_menu_note",
      "type": "text",
      "default": "Pages kept, no menu entry"
    },
    {
      "name": "put_back",
      "type": "text",
      "default": "Put back"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "title": "$title",
      "lede": "$lede",
      "find_placeholder": "$find_placeholder",
      "no_match": "$no_match",
      "col_name": "$col_name",
      "col_group": "$col_group",
      "col_icon": "$col_icon",
      "col_state": "$col_state",
      "live": "$live",
      "draft": "$draft",
      "owner_only": "$owner_only",
      "drafts_waiting": "$drafts_waiting",
      "reset": "$reset",
      "reset_q": "$reset_q",
      "reset_body": "$reset_body",
      "drag": "$drag",
      "drag_off": "$drag_off",
      "save": "$save",
      "saved": "$saved",
      "unsaved": "$unsaved",
      "make_live": "$make_live",
      "make_draft": "$make_draft",
      "pick_icon": "$pick_icon",
      "col_screen": "$col_screen",
      "col_under": "$col_under",
      "col_label": "$col_label",
      "col_order": "$col_order",
      "new_group": "$new_group",
      "new_group_name": "$new_group_name",
      "no_group": "$no_group",
      "group_name": "$group_name",
      "group_count": "$group_count",
      "move_up": "$move_up",
      "move_down": "$move_down",
      "delete_group": "$delete_group",
      "group_not_empty": "$group_not_empty",
      "delete_group_q": "$delete_group_q",
      "delete_group_body": "$delete_group_body",
      "group_empty": "$group_empty",
      "hide": "$hide",
      "hide_q": "$hide_q",
      "hide_body": "$hide_body",
      "hide_yes": "$hide_yes",
      "off_menu_title": "$off_menu_title",
      "off_menu_note": "$off_menu_note",
      "put_back": "$put_back"
    }
  },
  "returns": "record",
