{
  "chip_id": "ui.menus",
  "kind": "accessor",
  "set": "ui",
  "label": "Every word on the Menu builder screen",
  "aliases": [],
  "params": [
    {
      "name": "title",
      "type": "text",
      "default": "Menu builder"
    },
    {
      "name": "lede",
      "type": "text",
      "default": "Name, group, icon and order of every screen in the menu. A new screen arrives as a <b>Draft</b> that only you can see; press it to put it <b>Live</b>, and Access Control decides who sees it."
    },
    {
      "name": "find_placeholder",
      "type": "text",
      "default": "Find a screen"
    },
    {
      "name": "no_match",
      "type": "text",
      "default": "No screen matches."
    },
    {
      "name": "col_name",
      "type": "text",
      "default": "Name"
    },
    {
      "name": "col_group",
      "type": "text",
      "default": "Group"
    },
    {
      "name": "col_icon",
      "type": "text",
      "default": "Icon"
    },
    {
      "name": "col_state",
      "type": "text",
      "default": "Shown to"
    },
    {
      "name": "live",
      "type": "text",
      "default": "Live"
    },
    {
      "name": "draft",
      "type": "text",
      "default": "Draft - only you"
    },
    {
      "name": "owner_only",
      "type": "text",
      "default": "Owner only"
    },
    {
      "name": "drafts_waiting",
      "type": "text",
      "default": "{n} new {n:screen|screens} waiting to go live."
    },
    {
      "name": "reset",
      "type": "text",
      "default": "Back to the original"
    },
    {
      "name": "reset_q",
      "type": "text",
      "default": "Put this screen back?"
    },
    {
      "name": "reset_body",
      "type": "text",
      "default": "\"{label}\" goes back to the name, group and icon the portal gave it."
    },
    {
      "name": "drag",
      "type": "text",
      "default": "Drag to move (Alt + arrow keys too)"
    },
    {
      "name": "drag_off",
      "type": "text",
      "default": "Clear the search to reorder."
    },
    {
      "name": "save",
      "type": "text",
      "default": "Save the menu"
    },
    {
      "name": "saved",
      "type": "text",
      "default": "Menu saved."
    },
    {
      "name": "unsaved",
      "type": "text",
      "default": "Changes not saved yet."
    },
    {
      "name": "make_live",
      "type": "text",
      "default": "Click to put it live: Access Control then decides who sees it"
    },
    {
      "name": "make_draft",
      "type": "text",
      "default": "Click to make it a draft again: only you see it"
    },
    {
      "name": "pick_icon",
      "type": "text",
      "default": "Pick an icon"
    }
