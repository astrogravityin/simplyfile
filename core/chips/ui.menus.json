      "lede": "$lede",
      "find_placeholder": "$find_placeholder",
      "no_match": "$no_match",
      "col_name": "$col_name",
      "col_group": "$col_group",
      "col_icon": "$col_icon",
      "col_state": "$col_state",
      "live": "$live",
      "draft": "$draft",
      "owner_only": "$owner_only",
      "drafts_waiting": "$drafts_waiting",
      "reset": "$reset",
      "reset_q": "$reset_q",
      "reset_body": "$reset_body",
      "drag": "$drag",
      "drag_off": "$drag_off",
      "save": "$save",
      "saved": "$saved",
      "unsaved": "$unsaved",
      "make_live": "$make_live",
      "make_draft": "$make_draft",
      "pick_icon": "$pick_icon"
