        "geo_off": "Location lookup is turned off on this server (<code>PORTAL_GEOIP=off</code>), and no CDN in front of it sends a place.",
        "dbip_credit": "<a href=\"https://db-ip.com\" target=\"_blank\" rel=\"noopener\">IP geolocation by DB-IP</a>",
