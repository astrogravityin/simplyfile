{
  "chip_id": "list.access_people",
  "kind": "accessor",
  "set": "list",
  "label": "People & access: everyone with an account",
  "aliases": [
    "people list",
    "users list"
  ],
  "params": [
    {
      "name": "search_keys",
      "type": "list",
      "default": [
        "name",
        "email",
        "username",
        "role"
      ],
      "label": "search keys"
    },
    {
      "name": "sort_key",
      "type": "text",
      "default": "created_at",
      "label": "sort key"
    },
    {
      "name": "sort_desc",
      "type": "boolean",
      "default": false,
      "label": "sort desc"
    },
    {
      "name": "sorts",
      "type": "list",
      "default": [
        "name",
        "email",
        "role",
        "created_at"
      ],
      "label": "sorts"
    },
    {
      "name": "page_size",
      "type": "number",
      "default": 25,
      "label": "page size"
    },
    {
      "name": "max_page_size",
      "type": "number",
      "default": 200,
      "label": "max page size"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "search_keys": "$search_keys",
      "sort_key": "$sort_key",
      "sort_desc": "$sort_desc",
      "sorts": "$sorts",
      "page_size": "$page_size",
      "max_page_size": "$max_page_size"
    }
  },
  "returns": "record",
  "version": 2,
  "status": "published",
  "description_nl": "2026-09-28. A list that grows with the number of people: searched, sorted and paged on the server by op rows_view (core/lists.py); one page reaches the screen. search_keys = the fields a search looks in; sort_key/sort_desc = the order it opens in; sorts = the other fields a viewer may sort by; page_size rows a page (max_page_size at most). 2026-10-19: deliberately exact (no fuzzy_min) - people are found by email/user name, and a forgiving search over 5,000 look-alike emails returned 1,769 for one address (tv selfcheck access scale test).",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "search_keys": [
          "name",
          "email",
          "username",
          "role"
        ],
        "sort_key": "created_at",
        "sort_desc": false,
        "sorts": [
          "name",
          "email",
          "role",
          "created_at"
        ],
        "page_size": 25,
        "max_page_size": 200
      }
    }
  ]
}
