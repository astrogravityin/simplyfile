{
  "chip_id": "auth.password_problem",
  "kind": "accessor",
  "set": "auth",
  "audience": "admin",
  "label": "What is wrong with this password (blank = nothing)",
  "aliases": [
    "password policy"
  ],
  "params": [
    {
      "name": "password",
      "type": "text",
      "default": ""
    },
    {
      "name": "confirm",
      "type": "text",
      "default": ""
    },
    {
      "name": "password_lower",
      "type": "text",
      "default": ""
    },
    {
      "name": "username",
      "type": "text",
      "default": ""
    },
    {
      "name": "email",
      "type": "text",
      "default": ""
    },
    {
      "name": "min_length",
      "type": "number",
      "default": 8
    },
    {
      "name": "max_length",
      "type": "number",
      "default": 128
    },
    {
      "name": "common",
      "type": "list",
      "default": [
        "password",
        "password1",
        "12345678",
        "123456789",
        "qwerty123",
        "11111111",
        "iloveyou",
        "abcd1234"
      ]
    },
    {
      "name": "msg_short",
      "type": "text",
      "default": "Use at least {min_length} characters."
    },
    {
      "name": "msg_long",
      "type": "text",
      "default": "Use at most {max_length} characters."
    },
    {
      "name": "msg_mismatch",
      "type": "text",
      "default": "The two passwords do not match."
    },
    {
      "name": "msg_same_as_name",
      "type": "text",
      "default": "Your password cannot be your user name or email address."
    },
    {
      "name": "msg_common",
      "type": "text",
      "default": "That password is one of the first ones anyone would try. Choose another."
    }
  ],
  "expr": {
    "vop": "choose",
    "cases": [
      {
        "when": {
          "op": "lt",
          "left": {
            "vop": "text_length",
            "text": "$password"
          },
          "right": "$min_length"
        },
        "then": {
          "vop": "template",
          "text": "$msg_short",
          "values": {
            "min_length": "$min_length"
          }
        }
      },
      {
        "when": {
          "op": "gt",
          "left": {
            "vop": "text_length",
            "text": "$password"
          },
          "right": "$max_length"
        },
        "then": {
          "vop": "template",
          "text": "$msg_long",
          "values": {
            "max_length": "$max_length"
          }
        }
      },
      {
        "when": {
          "op": "ne",
          "left": "$password",
          "right": "$confirm"
        },
        "then": "$msg_mismatch"
      },
      {
        "when": {
          "op": "any",
          "items": [
            {
              "op": "eq",
              "left": "$password_lower",
              "right": "$username"
            },
            {
              "op": "eq",
              "left": "$password_lower",
              "right": "$email"
            }
          ]
        },
        "then": "$msg_same_as_name"
      },
      {
        "when": {
          "op": "in_set",
          "value": "$password_lower",
          "set": "$common"
        },
        "then": "$msg_common"
      }
    ],
    "else": ""
  },
  "returns": "text",
  "version": 1,
  "status": "published",
  "description_nl": "Checked on the server for sign-up, reset, change and the owner's reset. password_lower is the password lower-cased (the server passes it) so a common password or the user name is caught in any case.",
  "test_cases": [
    {
      "args": {
        "password": "a-good-password",
        "confirm": "a-good-password",
        "password_lower": "a-good-password",
        "username": "ravi",
        "email": "r@x.io"
      },
      "expect_value": ""
    },
    {
      "args": {
        "password": "short",
        "confirm": "short",
        "password_lower": "short"
      },
      "expect_value": "Use at least 8 characters."
    },
    {
      "args": {
        "password": "a-good-password",
        "confirm": "a-good-passwork",
        "password_lower": "a-good-password"
      },
      "expect_value": "The two passwords do not match."
    },
    {
      "args": {
        "password": "Password1",
        "confirm": "Password1",
        "password_lower": "password1"
      },
      "expect_value": "That password is one of the first ones anyone would try. Choose another."
    },
    {
      "args": {
        "password": "ravikumar",
        "confirm": "ravikumar",
        "password_lower": "ravikumar",
        "username": "ravikumar"
      },
      "expect_value": "Your password cannot be your user name or email address."
    }
  ],
  "weight_basis": "Platform access primitive, no business content. The knobs ARE the policy — edit them here, never in Python."
}
