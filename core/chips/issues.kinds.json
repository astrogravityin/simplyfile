            }
          },
          "katha_feedback": {
            "settings": "katha.feedback",
            "words": "ui.katha_reader",
            "store": "katha_feedback/{ref}",
            "shots": "katha_feedback_shots/{ref}",
            "per_ref": true,
            "chips": {
              "file": "katha.may_give_feedback",
              "answer": "katha.may_answer_feedback",
              "see": "katha.may_see_feedback",
              "remove": "katha.may_remove_comment"
            },
            "screen": "",
            "tell_answerer": "bell",
            "tell_giver": "bell",
            "show_email": false,
            "label_word": "kind_katha_feedback",
            "messages": {
              "off": "This work is not taking feedback.",
              "no_body": "Say what should change (or stay).",
              "filed": "Feedback sent - the maker has been told.",
              "saved": "Answer saved - the reader has been told.",
              "removed": "Feedback removed.",
              "not_yours": "Only the maker answers this feedback.",
              "no_issue": "That feedback is not there any more.",
              "bell_new": "{who} sent feedback on {title}",
              "bell_reply": "The maker answered your feedback on {title}",
              "too_fast": "One note every {s} seconds - try again in a moment."
            }
          }
        },
        "legacy_keys": {
          "user_id": "by",
          "body": "text",
          "created_at": "at",
          "resolved_by": "answered_by",
          "seen_maker": "seen_answerer"
        },
        "default_kind": "issue",
        "queue_kind": "issue",
        "index_store": "issues_by/{uid}",
        "unseen_store": "issues_unseen/{uid}",
        "data_url_pattern": "^data:image/([a-z]+);base64,(.+)$",
        "public_fields": [
