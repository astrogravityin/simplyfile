{
  "chip_id": "issues.may_answer",
  "kind": "predicate",
  "set": "issues",
  "label": "May this person answer a reported issue",
  "aliases": [
    "may answer"
  ],
  "params": [
    {
      "name": "may_screen",
      "type": "boolean",
      "default": false,
      "label": "Holds the Reported issues screen"
    },
    {
      "name": "is_giver",
      "type": "boolean",
      "default": false,
      "label": "Filed it themselves"
    }
  ],
  "expr": {
    "op": "all",
    "items": [
      {
        "op": "eq",
        "left": "$may_screen",
        "right": true
      },
      {
        "op": "not",
        "item": "$is_giver"
      }
    ]
  },
  "returns": "boolean",
  "version": 2,
  "status": "published",
  "description_nl": "2026-10-03 owner: \"We already have Report Issue framework - why can't we use that ... chip ops only\" - Report an issue and reader feedback are ONE framework (core/issues.py); a kind is a row here.",
  "test_cases": [
    {
      "args": {
        "may_screen": true
      },
      "expect_value": true
    },
    {
      "args": {
        "may_screen": true,
        "is_giver": true
      },
      "expect_value": false
    },
    {
      "args": {},
      "expect_value": false
    }
  ]
}
