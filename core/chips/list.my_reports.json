{
  "chip_id": "list.my_reports",
  "kind": "accessor",
  "set": "list",
  "label": "My reports: every note this person sent (reported issues and feedback), newest first",
  "aliases": [
    "my reports",
    "my feedback"
  ],
  "params": [
    {
      "name": "search_keys",
      "type": "list",
      "default": [
        "title",
        "about",
        "text",
        "reply",
        "status_label",
        "kind_label"
      ],
      "label": "search keys"
    },
    {
      "name": "sort_key",
      "type": "text",
      "default": "at",
      "label": "sort key"
    },
    {
      "name": "sort_desc",
      "type": "boolean",
      "default": true,
      "label": "sort desc"
    },
    {
      "name": "sorts",
      "type": "list",
      "default": [
        "at"
      ],
      "label": "sorts"
    },
    {
      "name": "page_size",
      "type": "number",
      "default": 20,
      "label": "page size"
    },
    {
      "name": "max_page_size",
      "type": "number",
      "default": 100,
      "label": "max page size"
    },
    {
      "name": "fuzzy_min",
      "type": "number",
      "default": 0.75,
      "label": "Forgiving search: how close a typo or half word must be (0 = exact words only; op fuzzy_rows)"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "search_keys": "$search_keys",
      "sort_key": "at",
      "sort_desc": "$sort_desc",
      "sorts": "$sorts",
      "page_size": "$page_size",
      "max_page_size": "$max_page_size",
      "fuzzy_min": "$fuzzy_min"
    }
  },
  "returns": "record",
  "version": 3,
  "status": "published",
  "description_nl": "2026-10-03 owner: \"Where I as reader can see all my feedbacks?\" 2026-10-03 owner merged reader feedback into Report an issue (core/issues.py).",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "search_keys": [
          "title",
          "about",
          "text",
          "reply",
          "status_label",
          "kind_label"
        ],
        "sort_key": "at",
        "sort_desc": true,
        "sorts": [
          "at"
        ],
        "page_size": 20,
        "max_page_size": 100,
        "fuzzy_min": 0.75
      }
    }
  ]
}
