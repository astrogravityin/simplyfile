{
  "chip_id": "ui.memory",
  "kind": "accessor",
  "set": "ui",
  "label": "Every word on the Memory watch screen",
  "aliases": [
    "memory screen words"
  ],
  "params": [
    {
      "name": "title",
      "type": "text",
      "default": "Memory watch"
    },
    {
      "name": "lede",
      "type": "text",
      "default": "What this portal weighs, the whole server around it, and which request moved memory. A process killed for memory prints no error anywhere, so this keeps its own record. Nothing here is saved: a restart starts it again."
    },
    {
      "name": "level_ok",
      "type": "text",
      "default": "Healthy"
    },
    {
      "name": "level_watch",
      "type": "text",
      "default": "Watch"
    },
    {
      "name": "level_warn",
      "type": "text",
      "default": "Warning"
    },
    {
      "name": "level_kill",
      "type": "text",
      "default": "About to be killed"
    },
    {
      "name": "collecting",
      "type": "text",
      "default": "Collecting readings… the first two arrive within a minute of the portal starting."
    },
    {
      "name": "line_now",
      "type": "text",
      "default": "{label}: {value} now"
    },
    {
      "name": "usage_portal",
      "type": "text",
      "default": "Portal {n}"
    },
    {
      "name": "usage_other",
      "type": "text",
      "default": "Other {n}"
    },
    {
      "name": "usage_total",
      "type": "text",
      "default": "Total {n}"
    },
    {
      "name": "auto_on",
      "type": "text",
      "default": "Auto-refresh on"
    },
    {
      "name": "auto_off",
      "type": "text",
      "default": "Auto-refresh off"
    },
    {
      "name": "clear_tip",
      "type": "text",
      "default": "Forget recorded request moves; readings stay"
    },
    {
      "name": "clear_moves",
      "type": "text",
      "default": "Clear moves"
    },
    {
      "name": "tile_resident",
      "type": "text",
      "default": "Resident now"
    },
    {
      "name": "tile_resident_sub",
      "type": "text",
      "default": "{pct}% of {limit} MB ({source})"
    },
    {
      "name": "tile_headroom",
      "type": "text",
      "default": "Headroom"
    },
    {
      "name": "tile_headroom_sub",
      "type": "text",
      "default": "before the kill"
    },
    {
      "name": "tile_peak",
      "type": "text",
      "default": "Peak since start"
    },
    {
      "name": "tile_up",
      "type": "text",
      "default": "Up for"
    },
    {
      "name": "tile_up_sub",
      "type": "text",
      "default": "since {since} · pid {pid}"
    },
    {
      "name": "tile_reader",
      "type": "text",
      "default": "Reader"
    },
    {
      "name": "tile_reader_sub",
      "type": "text",
      "default": "every {s} s · Python {python}"
    },
    {
      "name": "server_title",
      "type": "text",
      "default": "Whole server — this portal against other services"
    },
    {
      "name": "legend_portal",
      "type": "text",
      "default": "Portal (and what it started)"
    },
    {
      "name": "legend_other",
      "type": "text",
      "default": "Other"
    },
    {
      "name": "cpu_usage",
      "type": "text",
      "default": "CPU usage"
    },
    {
      "name": "cores",
      "type": "text",
      "default": "{n} {n:core|cores}"
    },
    {
      "name": "memory_usage",
      "type": "text",
      "default": "Memory usage"
    },
    {
      "name": "of",
      "type": "text",
      "default": "of {n}"
    },
    {
      "name": "disk_usage",
      "type": "text",
      "default": "Disk usage"
    },
    {
      "name": "disk_measuring",
      "type": "text",
      "default": "measuring… (every 10 min)"
    },
    {
      "name": "bandwidth",
      "type": "text",
      "default": "Bandwidth"
    },
    {
      "name": "bandwidth_sub",
      "type": "text",
      "default": "network in+out · Portal = request and response payload"
    },
    {
      "name": "needs_linux",
      "type": "text",
      "default": "The per-process tables and bandwidth need Linux (/proc). This machine shows the portal's own figures only."
    },
    {
      "name": "cpu_pct",
      "type": "text",
      "default": "CPU %"
    },
    {
      "name": "total",
      "type": "text",
      "default": "Total"
    },
    {
      "name": "portal",
      "type": "text",
      "default": "Portal"
    },
    {
      "name": "portal_procs",
      "type": "text",
      "default": "Portal processes"
    },
    {
      "name": "col_role",
      "type": "text",
      "default": "Role"
    },
    {
      "name": "col_process",
      "type": "text",
      "default": "Process"
    },
    {
      "name": "col_pid",
      "type": "text",
      "default": "PID"
    },
    {
      "name": "col_cpu",
      "type": "text",
      "default": "CPU"
    },
    {
      "name": "col_memory",
      "type": "text",
      "default": "Memory"
    },
    {
      "name": "no_portal_procs",
      "type": "text",
      "default": "No portal process read yet."
    },
    {
      "name": "other_procs",
      "type": "text",
      "default": "Other services — busiest first"
    },
    {
      "name": "col_service",
      "type": "text",
      "default": "Service"
    },
    {
      "name": "col_procs",
      "type": "text",
      "default": "Procs"
    },
    {
      "name": "no_other_procs",
      "type": "text",
      "default": "Nothing else read."
    },
    {
      "name": "resident_title",
      "type": "text",
      "default": "Resident memory, last {n} min"
    },
    {
      "name": "resident_key",
      "type": "text",
      "default": "Drop to zero = restart. Red line = limit."
    },
    {
      "name": "resident",
      "type": "text",
      "default": "Resident"
    },
    {
      "name": "limit_line",
      "type": "text",
      "default": "limit {n}"
    },
    {
      "name": "offenders_title",
      "type": "text",
      "default": "Offenders — requests ranked by the most memory one call moved"
    },
    {
      "name": "col_request",
      "type": "text",
      "default": "Request"
    },
    {
      "name": "col_max_move",
      "type": "text",
      "default": "Max move"
    },
    {
      "name": "col_calls",
      "type": "text",
      "default": "Calls"
    },
    {
      "name": "col_last",
      "type": "text",
      "default": "Last"
    },
    {
      "name": "no_offenders",
      "type": "text",
      "default": "Nothing has moved memory noticeably since the last clear. Click through the screens you suspect."
    },
    {
      "name": "recent_title",
      "type": "text",
      "default": "Recent moves — newest first"
    },
    {
      "name": "col_when",
      "type": "text",
      "default": "When"
    },
    {
      "name": "col_before_after",
      "type": "text",
      "default": "Before → after"
    },
    {
      "name": "col_move",
      "type": "text",
      "default": "Move"
    },
    {
      "name": "col_took",
      "type": "text",
      "default": "Took"
    },
    {
      "name": "no_moves",
      "type": "text",
      "default": "No request has moved memory noticeably yet."
    },
    {
      "name": "moves_note",
      "type": "text",
      "default": "Requests run side by side, so a move is where memory changed, not proof of who caused it."
    },
    {
      "name": "clear_title",
      "type": "text",
      "default": "Clear recorded moves?"
    },
    {
      "name": "clear_body",
      "type": "text",
      "default": "The request moves and the peak start again. Readings stay."
    },
    {
      "name": "cleared",
      "type": "text",
      "default": "Cleared."
    },
    {
      "name": "clear",
      "type": "text",
      "default": "Clear"
    }
