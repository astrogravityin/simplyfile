      "no_other_procs": "$no_other_procs",
      "resident_title": "$resident_title",
      "resident_key": "$resident_key",
      "resident": "$resident",
      "limit_line": "$limit_line",
      "offenders_title": "$offenders_title",
      "col_request": "$col_request",
      "col_max_move": "$col_max_move",
      "col_calls": "$col_calls",
      "col_last": "$col_last",
      "no_offenders": "$no_offenders",
      "recent_title": "$recent_title",
      "col_when": "$col_when",
      "col_before_after": "$col_before_after",
      "col_move": "$col_move",
      "col_took": "$col_took",
      "no_moves": "$no_moves",
      "moves_note": "$moves_note",
      "clear_title": "$clear_title",
      "clear_body": "$clear_body",
      "cleared": "$cleared",
      "clear": "$clear"
    }
  },
