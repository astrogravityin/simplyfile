{
  "chip_id": "limits.clip",
  "kind": "accessor",
  "set": "limits",
  "label": "A text, spaces tidied and cut to the longest allowed",
  "aliases": [
    "clip"
  ],
  "params": [
    {
      "name": "text",
      "type": "text",
      "default": "",
      "label": "The text"
    },
    {
      "name": "most",
      "type": "number",
      "default": 0,
      "label": "The most characters (a chip's knob)"
    }
  ],
  "expr": {
    "vop": "truncate",
    "length": "$most",
    "text": {
      "vop": "sub_text",
      "pattern": "^\\s+|\\s+$",
      "replacement": "",
      "text": {
        "vop": "sub_text",
        "text": "$text",
        "pattern": "\\s+",
        "replacement": " "
      }
    }
  },
  "returns": "text",
  "description_nl": "2026-09-28 owner (\"chips and ops only\"): a module never compares a count, a time or a text with a chip's number in Python - it asks this chip. The text with every run of spaces made one, the ends trimmed, cut to most characters.",
  "test_cases": [
    {
      "args": {
        "text": "  a   b  ",
        "most": 10
      },
      "expect_value": "a b"
    },
    {
      "args": {
        "text": "abcdef",
        "most": 3
      },
      "expect_value": "abc"
    },
    {
      "args": {
        "text": "   ",
        "most": 5
      },
      "expect_value": ""
    }
  ],
  "version": 1,
  "status": "published"
}
