{
  "chip_id": "mcp.settings",
  "kind": "accessor",
  "set": "mcp",
  "audience": "admin",
  "label": "Agent & MCP door: knobs",
  "aliases": [
    "agent & mcp door: knobs"
  ],
  "params": [
    {
      "name": "header",
      "type": "text",
      "default": "X-Portal-Agent-Key",
      "label": "header"
    },
    {
      "name": "env_url",
      "type": "text",
      "default": "PORTAL_MCP_URL",
      "label": "env url"
    },
    {
      "name": "env_key",
      "type": "text",
      "default": "PORTAL_MCP_KEY",
      "label": "env key"
    },
    {
      "name": "key_prefix",
      "type": "text",
      "default": "pak_",
      "label": "key prefix"
    },
    {
      "name": "key_bytes",
      "type": "json",
      "default": 32,
      "label": "key bytes"
    },
    {
      "name": "hint_len",
      "type": "json",
      "default": 4,
      "label": "hint len"
    },
    {
      "name": "who_role",
      "type": "text",
      "default": "owner",
      "label": "who role"
    },
    {
      "name": "session_s",
      "type": "json",
      "default": 600,
      "label": "session s"
    },
    {
      "name": "per_minute",
      "type": "json",
      "default": 120,
      "label": "per minute"
    },
    {
      "name": "timeout_s",
      "type": "json",
      "default": 30,
      "label": "timeout s"
    },
    {
      "name": "max_chars",
      "type": "json",
      "default": 12000,
      "label": "max chars"
    },
    {
      "name": "always_open",
      "type": "json",
      "default": [
        "GET /api/mcp/tools",
        "GET /api/mcp/about"
      ],
      "label": "always open"
    },
    {
      "name": "local_hosts",
      "type": "json",
      "default": [
        "127.0.0.1",
        "localhost",
        "::1"
      ],
      "label": "local hosts"
    },
    {
      "name": "protocol_version",
      "type": "text",
      "default": "2025-06-18",
      "label": "protocol version"
    },
    {
      "name": "server_name",
      "type": "text",
      "default": "{product}",
      "label": "server name"
    },
    {
      "name": "client_path",
      "type": "text",
      "default": "tools/mcp/server.py",
      "label": "client path"
    },
    {
      "name": "site_file",
      "type": "text",
      "default": "valuestream.site.json",
      "label": "site file"
    },
    {
      "name": "user_agent",
      "type": "text",
      "default": "{product}-mcp/1",
      "label": "user agent"
    },
    {
      "name": "command",
      "type": "text",
      "default": "claude mcp add {name} --scope user -e {env_url}={url} -e {env_key}={key} -- python \"{client}\"",
      "label": "command"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "header": "$header",
      "env_url": "$env_url",
      "env_key": "$env_key",
      "key_prefix": "$key_prefix",
      "key_bytes": "$key_bytes",
      "hint_len": "$hint_len",
      "who_role": "$who_role",
      "session_s": "$session_s",
      "per_minute": "$per_minute",
      "timeout_s": "$timeout_s",
      "max_chars": "$max_chars",
      "always_open": "$always_open",
      "local_hosts": "$local_hosts",
      "protocol_version": "$protocol_version",
      "server_name": "$server_name",
      "client_path": "$client_path",
      "site_file": "$site_file",
      "user_agent": "$user_agent",
      "command": "$command"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-10-23 owner: one owner-only MCP door for every portal of the family. header = where Claude Code's client sends the owner key; env_url / env_key = the names it reads them from; key_prefix / key_bytes / hint_len = how a key is made and how much of it is shown; who_role = whose key works (checked on EVERY call: the Portal Admin); session_s = how long the door's own short sign-in for a key lasts; per_minute = calls per key per minute; timeout_s / max_chars = the client's wait and answer size; always_open = the door's own routes a key reaches beside the tools (chip mcp.tools); local_hosts = where plain http may carry the key; command = the one line the owner pastes on the laptop ({name} {env_url} {url} {env_key} {key} {client}); site_file = where the laptop folder is read.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "header": "X-Portal-Agent-Key",
        "env_url": "PORTAL_MCP_URL",
        "env_key": "PORTAL_MCP_KEY",
        "key_prefix": "pak_",
        "key_bytes": 32,
        "hint_len": 4,
        "who_role": "owner",
        "session_s": 600,
        "per_minute": 120,
        "timeout_s": 30,
        "max_chars": 12000,
        "always_open": [
          "GET /api/mcp/tools",
          "GET /api/mcp/about"
        ],
        "local_hosts": [
          "127.0.0.1",
          "localhost",
          "::1"
        ],
        "protocol_version": "2025-06-18",
        "server_name": "{product}",
        "client_path": "tools/mcp/server.py",
        "site_file": "valuestream.site.json",
        "user_agent": "{product}-mcp/1",
        "command": "claude mcp add {name} --scope user -e {env_url}={url} -e {env_key}={key} -- python \"{client}\""
      }
    }
  ]
}
