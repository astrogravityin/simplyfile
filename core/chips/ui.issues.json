{
  "chip_id": "ui.issues",
  "kind": "accessor",
  "set": "ui",
  "label": "Every word on the Reported issues screen",
  "aliases": [
    "issues words"
  ],
  "params": [
    {
      "name": "title",
      "type": "text",
      "default": "Reported issues",
      "label": "title"
    },
    {
      "name": "lede",
      "type": "long",
      "default": "What people reported from any screen - broken things, wrong answers, rights-holder takedowns. Resolve with a reply: they see it in the portal.",
      "label": "lede"
    },
    {
      "name": "open",
      "type": "text",
      "default": "Open",
      "label": "open"
    },
    {
      "name": "resolved",
      "type": "text",
      "default": "Resolved",
      "label": "resolved"
    },
    {
      "name": "all",
      "type": "text",
      "default": "All",
      "label": "all"
    },
    {
      "name": "from",
      "type": "text",
      "default": "{name} ({email})",
      "label": "from"
    },
    {
      "name": "where",
      "type": "text",
      "default": "From {surface} {context}",
      "label": "where"
    },
    {
      "name": "filed",
      "type": "text",
      "default": "Filed {at}",
      "label": "filed"
    },
    {
      "name": "reply",
      "type": "text",
      "default": "Your reply (they see this in the portal)",
      "label": "reply"
    },
    {
      "name": "resolve",
      "type": "text",
      "default": "Resolve",
      "label": "resolve"
    },
    {
      "name": "reopen",
      "type": "text",
      "default": "Open again",
      "label": "reopen"
    },
    {
      "name": "shot",
      "type": "text",
      "default": "Screenshot",
      "label": "shot"
    },
    {
      "name": "none",
      "type": "text",
      "default": "No reports here.",
      "label": "none"
    },
    {
      "name": "answered",
      "type": "text",
      "default": "Answered by {by} on {at}: {reply}",
      "label": "answered"
    },
    {
      "name": "kind_issue",
      "type": "text",
      "default": "Reported issue"
    },
    {
      "name": "push",
      "type": "text",
      "default": "Push to",
      "label": "push"
    },
    {
      "name": "push_title",
      "type": "text",
      "default": "Push to {target}",
      "label": "push title"
    },
    {
      "name": "push_lede",
      "type": "text",
      "default": "{target} turns this issue into a request; its build machine writes the change and opens a pull request for your review.",
      "label": "push lede"
    },
    {
      "name": "push_to",
      "type": "text",
      "default": "Destination",
      "label": "push to"
    },
    {
      "name": "push_company",
      "type": "text",
      "default": "{company} · {project}",
      "label": "push company"
    },
    {
      "name": "push_type",
      "type": "text",
      "default": "Kind",
      "label": "push type"
    },
    {
      "name": "type_enhancement",
      "type": "text",
      "default": "Enhancement",
      "label": "type enhancement"
    },
    {
      "name": "type_fix",
      "type": "text",
      "default": "Fix",
      "label": "type fix"
    },
    {
      "name": "type_new_module",
      "type": "text",
      "default": "New module",
      "label": "type new module"
    },
    {
      "name": "push_req_title",
      "type": "text",
      "default": "Title",
      "label": "push req title"
    },
    {
      "name": "push_text",
      "type": "text",
      "default": "Details",
      "label": "push text"
    },
    {
      "name": "push_send",
      "type": "text",
      "default": "Push",
      "label": "push send"
    },
    {
      "name": "push_cancel",
      "type": "text",
      "default": "Cancel",
      "label": "push cancel"
    },
    {
      "name": "push_key",
      "type": "text",
      "default": "{target} key",
      "label": "push key"
    },
    {
      "name": "push_key_hint",
      "type": "text",
      "default": "In {target}: Admin > Connect your AI > Make a key.",
      "label": "push key hint"
    },
    {
      "name": "push_key_save",
      "type": "text",
      "default": "Check and keep",
      "label": "push key save"
    },
    {
      "name": "push_key_ok",
      "type": "text",
      "default": "{target} key works - kept.",
      "label": "push key ok"
    },
    {
      "name": "push_key_bad",
      "type": "text",
      "default": "{target} did not take this key: {why}",
      "label": "push key bad"
    },
    {
      "name": "push_no_key",
      "type": "text",
      "default": "Connect {target} first - one click, here.",
      "label": "push no key"
    },
    {
      "name": "push_done",
      "type": "text",
      "default": "Pushed to {target} as {ref}.",
      "label": "push done"
    },
    {
      "name": "push_failed",
      "type": "text",
      "default": "{target} said: {why}",
      "label": "push failed"
    },
    {
      "name": "push_again",
      "type": "text",
      "default": "Already pushed to {target} as {ref} on {at}. Pushing again makes a second request.",
      "label": "push again"
    },
    {
      "name": "pushed",
      "type": "text",
      "default": "{target} {ref}",
      "label": "pushed"
    },
    {
      "name": "pushed_stage",
      "type": "text",
      "default": "{ref}: {stage}",
      "label": "pushed stage"
    },
    {
      "name": "push_open",
      "type": "text",
      "default": "Open in {target}",
      "label": "push open"
    },
    {
      "name": "push_unknown",
      "type": "text",
      "default": "No such place to push to.",
      "label": "push unknown"
    },
    {
      "name": "push_paste_instead",
      "type": "text",
      "default": "Have a key? Paste it instead",
      "label": "push paste instead"
    },
    {
      "name": "push_popup_blocked",
      "type": "text",
      "default": "The browser blocked the window - allow pop-ups for this site, then press Connect again.",
      "label": "push popup blocked"
    },
    {
      "name": "push_connected",
      "type": "text",
      "default": "Connected to {target}. You can close this window.",
      "label": "push connected"
    },
    {
      "name": "push_connect_done",
      "type": "text",
      "default": "Connected to {target} - ready to push.",
      "label": "push connect done"
    },
    {
      "name": "push_connect_no",
      "type": "text",
      "default": "{target} was not connected - Allow was not pressed.",
      "label": "push connect no"
    },
    {
      "name": "push_connect_stale",
      "type": "text",
      "default": "This Connect link has run out - press Connect again.",
      "label": "push connect stale"
    },
    {
      "name": "push_connect_wait",
      "type": "text",
      "default": "Waiting for {target} - finish in the window that opened.",
      "label": "push connect wait"
    },
    {
      "name": "push_connect_lede",
      "type": "text",
      "default": "One time only: sign in to {target} and press Allow. Nothing to copy.",
      "label": "push connect lede"
    },
    {
      "name": "push_connect",
      "type": "text",
      "default": "Connect {target}",
      "label": "push connect"
    },
    {
      "name": "push_not_ready",
      "type": "text",
      "default": "Not connected",
      "label": "push not ready"
    },
    {
      "name": "push_ready",
      "type": "text",
      "default": "Connected",
      "label": "push ready"
    },
    {
      "name": "push_flow_label",
      "type": "text",
      "default": "This issue becomes a {target} request, its build machine writes the change, and a pull request comes back for review.",
      "label": "push flow label"
    },
    {
      "name": "push_flow_pr",
      "type": "text",
      "default": "Pull request",
      "label": "push flow pr"
    },
    {
      "name": "push_flow_build",
      "type": "text",
      "default": "Build machine",
      "label": "push flow build"
    },
    {
      "name": "push_flow_request",
      "type": "text",
      "default": "Request",
      "label": "push flow request"
    },
    {
      "name": "push_flow_issue",
      "type": "text",
      "default": "This issue",
      "label": "push flow issue"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "title": "$title",
      "lede": "$lede",
      "open": "$open",
      "resolved": "$resolved",
      "all": "$all",
      "from": "$from",
      "where": "$where",
      "filed": "$filed",
      "reply": "$reply",
      "resolve": "$resolve",
      "reopen": "$reopen",
      "shot": "$shot",
      "none": "$none",
      "answered": "$answered",
      "kind_issue": "$kind_issue",
      "push": "$push",
      "push_title": "$push_title",
      "push_lede": "$push_lede",
      "push_to": "$push_to",
      "push_company": "$push_company",
      "push_type": "$push_type",
      "type_enhancement": "$type_enhancement",
      "type_fix": "$type_fix",
      "type_new_module": "$type_new_module",
      "push_req_title": "$push_req_title",
      "push_text": "$push_text",
      "push_send": "$push_send",
      "push_cancel": "$push_cancel",
      "push_key": "$push_key",
      "push_key_hint": "$push_key_hint",
      "push_key_save": "$push_key_save",
      "push_key_ok": "$push_key_ok",
      "push_key_bad": "$push_key_bad",
      "push_no_key": "$push_no_key",
      "push_done": "$push_done",
      "push_failed": "$push_failed",
      "push_again": "$push_again",
      "pushed": "$pushed",
      "pushed_stage": "$pushed_stage",
      "push_open": "$push_open",
      "push_unknown": "$push_unknown",
      "push_flow_issue": "$push_flow_issue",
      "push_flow_request": "$push_flow_request",
      "push_flow_build": "$push_flow_build",
      "push_flow_pr": "$push_flow_pr",
      "push_flow_label": "$push_flow_label",
      "push_ready": "$push_ready",
      "push_not_ready": "$push_not_ready",
      "push_connect": "$push_connect",
      "push_connect_lede": "$push_connect_lede",
      "push_connect_wait": "$push_connect_wait",
      "push_connect_stale": "$push_connect_stale",
      "push_connect_no": "$push_connect_no",
      "push_connected": "$push_connected",
      "push_popup_blocked": "$push_popup_blocked",
      "push_paste_instead": "$push_paste_instead",
      "push_connect_done": "$push_connect_done"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
