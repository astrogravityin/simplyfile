{
  "chip_id": "access.decide",
  "kind": "accessor",
  "set": "access",
  "audience": "admin",
  "label": "May this person open this screen (or use this function) — and why",
  "aliases": [
    "access resolver",
    "deny wins",
    "catch all"
  ],
  "params": [
    {
      "name": "signed_in",
      "type": "boolean",
      "default": false
    },
    {
      "name": "role",
      "type": "text",
      "default": "member"
    },
    {
      "name": "known",
      "type": "boolean",
      "default": true
    },
    {
      "name": "admin",
      "type": "boolean",
      "default": false
    },
    {
      "name": "available",
      "type": "text",
      "default": "yes",
      "label": "yes or no - has this person anything on that screen at all"
    },
    {
      "name": "gate",
      "type": "text",
      "default": "none",
      "label": "none, yes or no"
    },
    {
      "name": "lent",
      "type": "text",
      "default": "",
      "label": "yes = the owner lent this admin screen to this person today (delegation)"
    },
    {
      "name": "in_group",
      "type": "boolean",
      "default": false,
      "label": "The person is in at least one group other than Catch All"
    },
    {
      "name": "has_personal",
      "type": "boolean",
      "default": false,
      "label": "The person has at least one rule of their own"
    },
    {
      "name": "personal_rule_manages",
      "type": "boolean",
      "default": false,
      "label": "Knob: a personal rule alone makes a person managed (off: an account in no group keeps Catch All, its own rules on top)"
    },
    {
      "name": "open_unless_denied",
      "type": "boolean",
      "default": false,
      "label": "The row is on for everyone until a rule denies it (the bottom bar, chip access.dock)"
    },
    {
      "name": "screen",
      "type": "text",
      "default": ""
    },
    {
      "name": "label",
      "type": "text",
      "default": ""
    },
    {
      "name": "deny_by",
      "type": "text",
      "default": "",
      "label": "A deny from the person, their groups or a group those inherit from"
    },
    {
      "name": "deny_on",
      "type": "text",
      "default": ""
    },
    {
      "name": "allow_by",
      "type": "text",
      "default": "",
      "label": "An allow from the person, their groups or a group those inherit from"
    },
    {
      "name": "allow_on",
      "type": "text",
      "default": ""
    },
    {
      "name": "ca_deny_by",
      "type": "text",
      "default": "",
      "label": "A deny on Catch All itself"
    },
    {
      "name": "ca_deny_on",
      "type": "text",
      "default": ""
    },
    {
      "name": "ca_allow_by",
      "type": "text",
      "default": "",
      "label": "An allow on Catch All itself"
    },
    {
      "name": "ca_allow_on",
      "type": "text",
      "default": ""
    },
    {
      "name": "msg_signed_out",
      "type": "text",
      "default": "Not signed in."
    },
    {
      "name": "msg_owner",
      "type": "text",
      "default": "Owners can open everything."
    },
    {
      "name": "msg_unknown",
      "type": "text",
      "default": "\"{screen}\" is not a screen in this portal."
    },
    {
      "name": "msg_admin",
      "type": "text",
      "default": "Only the portal owner can open this."
    },
    {
      "name": "msg_gate",
      "type": "text",
      "default": "A {role} cannot use {label}. Ask the portal owner to make you an author or an editor."
    },
    {
      "name": "msg_unavailable",
      "type": "text",
      "default": "{label} is not open yet - there is nothing on it for you."
    },
    {
      "name": "msg_lent",
      "type": "text",
      "default": "The portal owner lent you {label}.",
      "label": "msg lent"
    },
    {
      "name": "msg_denied",
      "type": "text",
      "default": "Denied for {deny_by} on {deny_on}."
    },
    {
      "name": "msg_allowed",
      "type": "text",
      "default": "Allowed for {allow_by} on {allow_on}."
    },
    {
      "name": "msg_not_granted",
      "type": "text",
      "default": "Nothing allows {label}: none of this person's groups (or the groups they inherit from) or own rules does."
    },
    {
      "name": "msg_ca_denied",
      "type": "text",
      "default": "In no group, so Catch All decides: denied for {ca_deny_by} on {ca_deny_on}."
    },
    {
      "name": "msg_ca_allowed",
      "type": "text",
      "default": "In no group, so Catch All decides: allowed for {ca_allow_by} on {ca_allow_on}."
    },
    {
      "name": "msg_not_in_catch_all",
      "type": "text",
      "default": "In no group, so Catch All decides, and it does not allow {label}."
    },
    {
      "name": "msg_open",
      "type": "text",
      "default": "{label} is on for everyone until a rule switches it off."
    }
  ],
  "expr": {
    "vop": "choose",
    "cases": [
      {
        "when": {
          "op": "eq",
          "left": "$signed_in",
          "right": false
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": false,
            "why": {
              "vop": "template",
              "text": "$msg_signed_out",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "eq",
          "left": "$known",
          "right": false
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": false,
            "why": {
              "vop": "template",
              "text": "$msg_unknown",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "eq",
          "left": "$available",
          "right": "no"
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": false,
            "why": {
              "vop": "template",
              "text": "$msg_unavailable",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "eq",
          "left": "$role",
          "right": "owner"
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": true,
            "why": {
              "vop": "template",
              "text": "$msg_owner",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "eq",
              "left": "$admin",
              "right": true
            },
            {
              "op": "eq",
              "left": "$lent",
              "right": "yes"
            }
          ]
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": true,
            "why": {
              "vop": "template",
              "text": "$msg_lent",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "eq",
          "left": "$admin",
          "right": true
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": false,
            "why": {
              "vop": "template",
              "text": "$msg_admin",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "eq",
          "left": "$gate",
          "right": "no"
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": false,
            "why": {
              "vop": "template",
              "text": "$msg_gate",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "ne",
          "left": "$deny_by",
          "right": ""
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": false,
            "why": {
              "vop": "template",
              "text": "$msg_denied",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "eq",
              "left": "$open_unless_denied",
              "right": true
            },
            {
              "op": "any",
              "items": [
                {
                  "op": "any",
                  "items": [
                    {
                      "op": "eq",
                      "left": "$in_group",
                      "right": true
                    },
                    {
                      "op": "all",
                      "items": [
                        {
                          "op": "eq",
                          "left": "$personal_rule_manages",
                          "right": true
                        },
                        {
                          "op": "eq",
                          "left": "$has_personal",
                          "right": true
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "eq",
                  "left": "$ca_deny_by",
                  "right": ""
                }
              ]
            }
          ]
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": true,
            "why": {
              "vop": "template",
              "text": "$msg_open",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "any",
              "items": [
                {
                  "op": "eq",
                  "left": "$in_group",
                  "right": true
                },
                {
                  "op": "all",
                  "items": [
                    {
                      "op": "eq",
                      "left": "$personal_rule_manages",
                      "right": true
                    },
                    {
                      "op": "eq",
                      "left": "$has_personal",
                      "right": true
                    }
                  ]
                }
              ]
            },
            {
              "op": "ne",
              "left": "$allow_by",
              "right": ""
            }
          ]
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": true,
            "why": {
              "vop": "template",
              "text": "$msg_allowed",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "any",
          "items": [
            {
              "op": "eq",
              "left": "$in_group",
              "right": true
            },
            {
              "op": "all",
              "items": [
                {
                  "op": "eq",
                  "left": "$personal_rule_manages",
                  "right": true
                },
                {
                  "op": "eq",
                  "left": "$has_personal",
                  "right": true
                }
              ]
            }
          ]
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": false,
            "why": {
              "vop": "template",
              "text": "$msg_not_granted",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "ne",
          "left": "$ca_deny_by",
          "right": ""
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": false,
            "why": {
              "vop": "template",
              "text": "$msg_ca_denied",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "ne",
          "left": "$allow_by",
          "right": ""
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": true,
            "why": {
              "vop": "template",
              "text": "$msg_allowed",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      },
      {
        "when": {
          "op": "ne",
          "left": "$ca_allow_by",
          "right": ""
        },
        "then": {
          "vop": "record",
          "fields": {
            "allowed": true,
            "why": {
              "vop": "template",
              "text": "$msg_ca_allowed",
              "values": {
                "screen": "$screen",
                "label": "$label",
                "role": "$role",
                "deny_by": "$deny_by",
                "deny_on": "$deny_on",
                "allow_by": "$allow_by",
                "allow_on": "$allow_on",
                "ca_deny_by": "$ca_deny_by",
                "ca_deny_on": "$ca_deny_on",
                "ca_allow_by": "$ca_allow_by",
                "ca_allow_on": "$ca_allow_on"
              }
            }
          }
        }
      }
    ],
    "else": {
      "vop": "record",
      "fields": {
        "allowed": false,
        "why": {
          "vop": "template",
          "text": "$msg_not_in_catch_all",
          "values": {
            "screen": "$screen",
            "label": "$label",
            "role": "$role",
            "deny_by": "$deny_by",
            "deny_on": "$deny_on",
            "allow_by": "$allow_by",
            "allow_on": "$allow_on",
            "ca_deny_by": "$ca_deny_by",
            "ca_deny_on": "$ca_deny_on",
            "ca_allow_by": "$ca_allow_by",
            "ca_allow_on": "$ca_allow_on"
          }
        }
      }
    }
  },
  "returns": "record",
  "version": 4,
  "status": "published",
  "description_nl": "The one resolver behind the menu, every API guard and 'Check a person' (model 2026-10-19, the studio's model, as SteadyMove's core). Order: signed out -> no; unknown screen -> no (the owner too); a screen with nothing on it for this person (available no) -> no; owner -> always (the way back in can never be locked); admin screen -> owner only; a role gate chip says no -> no. Then DENY WINS: any deny for the person, a group they are in, or a group those inherit from -> no. MANAGED = in a group other than Catch All (or, with knob personal_rule_manages on, holding a rule of their own): they see ONLY what their groups, the groups those INHERIT from (one parent each, read live) and their own rules allow - anything else -> no. UNASSIGNED = in no group: Catch All decides - its deny -> no, their own allow -> yes, Catch All's allow -> yes, anything else -> no. Catch All is the built-in, non-deletable, renamable group (id catch_all) for every account in no group, new sign-ups included. The old built-in group Everyone is retired: on day one its denies became Catch All denies, its allows became the Catch All allow list, every existing group was set to inherit Catch All, and an 'Only allowed' screen was simply left out of Catch All - so every menu stayed the same. personal_rule_manages is off so that approving a request (a personal allow) never empties an unassigned person's menu. A screen nobody allowed is closed; access.settings new_screens_to_catch_all adds a newly catalogued screen to Catch All once. A function check honours rules on the whole screen and on that function; a screen check ignores function-only rules. register_available screens answer 'no' before everything else, and hide_when_denied leaves them out of the menu. 2026-10-04 owner: an Admin screen the owner LENT to this person today (delegation, fact lent) opens for them - checked after owner, before admin; register_available(functions=True) answers per button (a tenant's role).",
  "test_cases": [
    {
      "args": {
        "signed_in": true,
        "role": "owner",
        "admin": true
      },
      "expect_value": {
        "allowed": true,
        "why": "Owners can open everything."
      }
    },
    {
      "args": {
        "signed_in": true,
        "role": "member",
        "admin": true
      },
      "expect_value": {
        "allowed": false,
        "why": "Only the portal owner can open this."
      }
    },
    {
      "args": {
        "signed_in": true,
        "role": "member",
        "gate": "no",
        "label": "Rules"
      },
      "expect_value": {
        "allowed": false,
        "why": "A member cannot use Rules. Ask the portal owner to make you an author or an editor."
      }
    },
    {
      "args": {
        "signed_in": true,
        "in_group": true,
        "deny_by": "group \"Interns\"",
        "deny_on": "Videos",
        "allow_by": "ravi@x.io",
        "allow_on": "Videos"
      },
      "expect_value": {
        "allowed": false,
        "why": "Denied for group \"Interns\" on Videos."
      }
    },
    {
      "args": {
        "signed_in": true,
        "in_group": true,
        "allow_by": "group \"My Family\"",
        "allow_on": "Videos"
      },
      "expect_value": {
        "allowed": true,
        "why": "Allowed for group \"My Family\" on Videos."
      }
    },
    {
      "args": {
        "signed_in": true,
        "in_group": true,
        "label": "Videos",
        "ca_allow_by": "group \"Catch All\"",
        "ca_allow_on": "Videos"
      },
      "expect_value": {
        "allowed": false,
        "why": "Nothing allows Videos: none of this person's groups (or the groups they inherit from) or own rules does."
      }
    },
    {
      "args": {
        "signed_in": true,
        "label": "Videos",
        "ca_allow_by": "group \"Catch All\"",
        "ca_allow_on": "Videos"
      },
      "expect_value": {
        "allowed": true,
        "why": "In no group, so Catch All decides: allowed for group \"Catch All\" on Videos."
      }
    },
    {
      "args": {
        "signed_in": true,
        "label": "Videos"
      },
      "expect_value": {
        "allowed": false,
        "why": "In no group, so Catch All decides, and it does not allow Videos."
      }
    },
    {
      "args": {
        "signed_in": true,
