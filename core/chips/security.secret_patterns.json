{
  "chip_id": "security.secret_patterns",
  "kind": "accessor",
  "set": "security",
  "label": "What a secret looks like - the secret-scan gate and the doctor's mask both read these",
  "aliases": [
    "secret scan",
    "key patterns",
    "leaked keys"
  ],
  "params": [
    {
      "name": "patterns",
      "type": "list",
      "default": [
        {
          "kind": "Private key",
          "re": "-----BEGIN (?:RSA |DSA |EC |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?:-----)?(.{0,8})"
        },
        {
          "kind": "AWS access key",
          "re": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
        },
        {
          "kind": "GitHub token",
          "re": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b|\\bgithub_pat_[A-Za-z0-9_]{40,}"
        },
        {
          "kind": "Slack token",
          "re": "\\bxox[abposr]-[A-Za-z0-9-]{10,}"
        },
        {
          "kind": "Stripe live key",
          "re": "\\b[rs]k_live_[A-Za-z0-9]{16,}"
        },
        {
          "kind": "Razorpay live key",
          "re": "\\brzp_live_[A-Za-z0-9]{10,}"
        },
        {
          "kind": "Google API key",
          "re": "\\bAIza[0-9A-Za-z_-]{35}\\b"
        },
        {
          "kind": "SendGrid key",
          "re": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}"
        },
        {
          "kind": "Twilio key",
          "re": "\\bSK[0-9a-f]{32}\\b"
        },
        {
          "kind": "JSON web token",
          "re": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
        },
        {
          "kind": "Password in a connection string",
          "re": "\\b[a-z][a-z0-9+.-]{2,}://[^\\s:/@'\"]{1,64}:[^\\s@/'\"$<{]{4,}@[\\w.-]+"
        }
      ],
      "label": "Key and token shapes (kind + regular expression), copied from skills/portal-review/scan_rules.json secrets"
    },
    {
      "name": "files",
      "type": "list",
      "default": [
        {
          "kind": "Environment file (.env)",
          "re": "(^|/)\\.env(\\.(local|prod|production|dev|development|staging|live))?$"
        },
        {
          "kind": "Key or certificate file",
          "re": "\\.(pem|key|p12|pfx|jks|keystore|ppk)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)$"
        },
        {
          "kind": "Credentials file",
          "re": "(^|/)(credentials|service[-_]account|secrets?)\\.(json|ya?ml|xml)$|(^|/)\\.(npmrc|pypirc|netrc|htpasswd)$"
        }
      ],
      "label": "File names that hold secrets and must never be tracked (.env, key files, credential files)"
    },
    {
      "name": "allow",
      "type": "list",
      "default": [],
      "label": "Paths the scan skips on purpose (a public-by-design key, e.g. a vendored web config) - each with its reason in the path note"
    },
    {
      "name": "history_commits",
      "type": "number",
      "default": 200,
      "label": "How many recent commits the scan reads back through git history (added lines only) - a key added and removed later is still in the history and must be rotated; 0 = off"
    },
    {
      "name": "history_allow",
      "type": "list",
      "default": [
        "07a96d0 source.py",
        "52fb03c source.py"
      ],
      "label": "History hits already dealt with: \"<short commit> <path>\" rows of keys that were ROTATED (the old value is dead) - each with its reason in the commit that adds it. 07a96d0 source.py = the token-scrub self-test's made-up 'SECRET' word in a sample address (never a key; the current file no longer has it)"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "patterns": "$patterns",
      "files": "$files",
      "allow": "$allow",
      "history_commits": "$history_commits",
      "history_allow": "$history_allow"
    }
  },
  "returns": "record",
  "version": 2,
  "status": "published",
  "description_nl": "2026-11-18 gap audit C1-12: the selfcheck part `secrets` scans every tracked file plus static/ and core/static/ (vendored chunks and long lines included) for these shapes and fails on a hit; core/doctor.mask turns the same shapes into <secret> before anything reaches a log. The patterns follow portal-review's scan_rules.json (the guard says when they drift). 2026-11-18 gap audit S10: also the last history_commits commits of git history (git log -p, added lines only) - a key committed and deleted later is still readable by anyone with the repo; a rotated one goes in history_allow.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "patterns": [
          {
            "kind": "Private key",
            "re": "-----BEGIN (?:RSA |DSA |EC |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?:-----)?(.{0,8})"
          },
          {
            "kind": "AWS access key",
            "re": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
          },
          {
            "kind": "GitHub token",
            "re": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b|\\bgithub_pat_[A-Za-z0-9_]{40,}"
          },
          {
            "kind": "Slack token",
            "re": "\\bxox[abposr]-[A-Za-z0-9-]{10,}"
          },
          {
            "kind": "Stripe live key",
            "re": "\\b[rs]k_live_[A-Za-z0-9]{16,}"
          },
          {
            "kind": "Razorpay live key",
            "re": "\\brzp_live_[A-Za-z0-9]{10,}"
          },
          {
            "kind": "Google API key",
            "re": "\\bAIza[0-9A-Za-z_-]{35}\\b"
          },
          {
            "kind": "SendGrid key",
            "re": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}"
          },
          {
            "kind": "Twilio key",
            "re": "\\bSK[0-9a-f]{32}\\b"
          },
          {
            "kind": "JSON web token",
            "re": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
          },
          {
            "kind": "Password in a connection string",
            "re": "\\b[a-z][a-z0-9+.-]{2,}://[^\\s:/@'\"]{1,64}:[^\\s@/'\"$<{]{4,}@[\\w.-]+"
          }
        ],
        "files": [
          {
            "kind": "Environment file (.env)",
            "re": "(^|/)\\.env(\\.(local|prod|production|dev|development|staging|live))?$"
          },
          {
            "kind": "Key or certificate file",
            "re": "\\.(pem|key|p12|pfx|jks|keystore|ppk)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)$"
          },
          {
            "kind": "Credentials file",
            "re": "(^|/)(credentials|service[-_]account|secrets?)\\.(json|ya?ml|xml)$|(^|/)\\.(npmrc|pypirc|netrc|htpasswd)$"
          }
        ],
        "allow": [],
        "history_commits": 200,
        "history_allow": [
          "07a96d0 source.py",
          "52fb03c source.py"
        ]
      }
    }
  ]
}
