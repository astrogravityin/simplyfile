{
  "chip_id": "find.settings",
  "kind": "accessor",
  "set": "find",
  "label": "How the top search behaves",
  "aliases": [
    "command palette settings",
    "search limits"
  ],
  "params": [
    {
      "name": "min_query_length",
      "type": "number",
      "default": 1,
      "label": "Letters typed before searching"
    },
    {
      "name": "max_results",
      "type": "number",
      "default": 8,
      "label": "Hits shown at once"
    },
    {
      "name": "idle_results",
      "type": "number",
      "default": 6,
      "label": "Screens offered before anything is typed"
    },
    {
      "name": "skip_words",
      "type": "list",
      "default": [
        "how",
        "do",
        "does",
        "i",
        "we",
        "you",
        "can",
        "could",
        "to",
        "the",
        "a",
        "an",
        "of",
        "or",
        "and",
        "for",
        "my",
        "our",
        "where",
        "what",
        "which",
        "is",
        "are",
        "in",
        "on",
        "with",
        "me",
        "please",
        "want",
        "need",
        "change",
        "set",
        "edit",
        "update",
        "configure",
        "modify",
        "make",
        "get",
        "way",
        "it",
        "this",
        "that",
        "there"
      ],
      "label": "Words a typed question carries that never count (how, to, the, change...)"
    },
    {
      "name": "near_min",
      "type": "number",
      "default": 0.75,
      "label": "How alike a misspelt word must be to count (0 to 1)"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "min_query_length": "$min_query_length",
      "max_results": "$max_results",
      "idle_results": "$idle_results",
      "skip_words": "$skip_words",
      "near_min": "$near_min"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "min_query_length: how many letters before the portal starts looking. max_results: the longest list shown. idle_results: how many screens are offered the moment the box opens, before a letter is typed. skip_words: the words of a question that say nothing about WHERE ('how do I change the storage size' searches storage + size).",
