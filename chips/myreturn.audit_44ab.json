                                      "right": "$cash_pct_max"
                                    }
                                  ]
                                }
                              ]
                            },
                            "then": "$biz_limit_low_cash"
                          }
                        ],
                        "else": "$biz_limit"
                      }
                    }
                  ]
                },
                {
                  "op": "all",
                  "items": [
                    {
                      "op": "eq",
                      "left": "$pl",
                      "right": true
                    },
                    {
                      "op": "eq",
                      "left": "$presumptive_open",
                      "right": true
                    },
                    {
                      "op": "lt",
                      "left": "$net",
                      "right": "$deemed"
