                                            "b": "$pay_total"
                                          },
                                          "right": "$cash_pct_max"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            "then": "$prof_limit_low_cash"
                          },
                          {
                            "when": {
                              "op": "eq",
                              "left": "$profession",
                              "right": true
