                                  "right": true
                                },
                                {
                                  "op": "all",
                                  "items": [
                                    {
                                      "op": "any",
                                      "items": [
                                        {
                                          "op": "le",
                                          "left": "$turnover",
                                          "right": 0
                                        },
                                        {
                                          "op": "le",
                                          "left": {
                                            "vop": "div",
                                            "a": {
                                              "vop": "mul",
                                              "a": "$cash",
                                              "b": 100
                                            },
                                            "b": "$turnover"
                                          },
                                          "right": "$cash_pct_max"
                                        }
                                      ]
                                    },
                                    {
                                      "op": "any",
                                      "items": [
                                        {
                                          "op": "not",
                                          "item": {
                                            "op": "all",
                                            "items": [
                                              {
                                                "op": "ge",
                                                "left": "$pay_cash",
                                                "right": 0
                                              },
                                              {
                                                "op": "gt",
                                                "left": "$pay_total",
                                                "right": 0
