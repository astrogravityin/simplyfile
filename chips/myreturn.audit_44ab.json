                                {
                                  "op": "any",
                                  "items": [
                                    {
                                      "op": "not",
                                      "item": {
                                        "op": "all",
                                        "items": [
                                          {
                                            "op": "ge",
                                            "left": "$pay_cash",
                                            "right": 0
                                          },
                                          {
                                            "op": "gt",
                                            "left": "$pay_total",
                                            "right": 0
                                          }
                                        ]
                                      }
                                    },
                                    {
                                      "op": "le",
                                      "left": {
                                        "vop": "div",
