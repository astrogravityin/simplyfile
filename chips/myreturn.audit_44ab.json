{
  "chip_id": "myreturn.audit_44ab",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: does the business need a tax audit (s.44AB)?",
  "aliases": [
    "tax audit",
    "44ab",
    "audit limit",
    "44ad(4)",
    "cash payments"
  ],
  "params": [
    {
      "name": "pl",
      "type": "boolean",
      "default": false,
      "label": "income from the person's own profit and loss (chip myreturn.business_pl)"
    },
    {
      "name": "profession",
      "type": "boolean",
      "default": false,
      "label": "a profession (s.44AB(b)) rather than a business (s.44AB(a))"
    },
    {
      "name": "turnover",
      "type": "number",
      "default": 0,
      "label": "receipts / turnover of the year"
    },
    {
      "name": "cash",
      "type": "number",
      "default": 0,
      "label": "of which in cash"
    },
    {
      "name": "net",
      "type": "number",
      "default": 0,
      "label": "net profit"
    },
    {
      "name": "deemed",
      "type": "number",
      "default": 0,
      "label": "what the presumptive scheme would have made it (6% / 8%, 50%)"
    },
    {
      "name": "presumptive_open",
      "type": "boolean",
      "default": false,
      "label": "the presumptive scheme was open (within its limit) and not chosen"
    },
    {
      "name": "above_exemption",
      "type": "boolean",
      "default": false,
      "label": "total income above the amount not chargeable to tax"
    },
    {
      "name": "cash_pct_max",
      "type": "number",
      "default": 5,
      "label": "s.44AB provisos: cash at most this percent of receipts lifts the limit"
    },
    {
      "name": "biz_limit",
      "type": "number",
      "default": 10000000,
      "label": "s.44AB(a): business turnover above 1 crore"
    },
    {
      "name": "biz_limit_low_cash",
      "type": "number",
      "default": 100000000,
      "label": "s.44AB(a) proviso: 10 crore when cash is 5% or less"
    },
    {
      "name": "prof_limit",
      "type": "number",
      "default": 5000000,
      "label": "s.44AB(b): professional receipts above 50 lakh"
    },
    {
      "name": "prof_limit_low_cash",
      "type": "number",
      "default": 7500000,
      "label": "s.44AB(b) proviso: 75 lakh when cash is 5% or less"
    },
    {
      "name": "pay_total",
      "type": "number",
      "default": 0,
      "label": "payments of the year (all modes) - s.44AB(a) / (b) provisos"
    },
    {
      "name": "pay_cash",
      "type": "number",
      "default": -1,
      "label": "of which in cash; -1 = not typed (the receipts' share stands for both until it is)"
    },
    {
      "name": "ad_left",
      "type": "boolean",
      "default": false,
      "label": "s.44AD(4): declared income under 44AD for a year, then not under it in one of the five years after - and this year is within the five after that"
    },
    {
      "name": "ad_business",
      "type": "boolean",
      "default": false,
      "label": "an eligible business (44AD's kind: 44AD or a business on its own profit and loss), not a profession"
    },
    {
      "name": "kind_44ad",
      "type": "boolean",
      "default": false,
      "label": "44AD chosen this year"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "audit": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "any",
              "items": [
                {
                  "op": "all",
