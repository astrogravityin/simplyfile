{
  "chip_id": "list.clients",
  "kind": "accessor",
  "set": "list",
  "label": "Clients list",
  "aliases": [
    "list clients"
  ],
  "params": [
    {
      "name": "search_keys",
      "type": "list",
      "default": [
        "name",
        "pan",
        "status",
        "form",
        "stage"
      ],
      "label": "search keys"
    },
    {
      "name": "sort_key",
      "type": "text",
      "default": "name",
      "label": "sort key"
    },
    {
      "name": "sort_desc",
      "type": "boolean",
      "default": false,
      "label": "sort desc"
    },
    {
      "name": "sorts",
      "type": "list",
      "default": [
        "name",
        "pan",
        "stage",
        "updated_at"
      ],
      "label": "sorts"
    },
    {
      "name": "page_size",
      "type": "number",
      "default": 25,
      "label": "page size"
    },
    {
      "name": "max_page_size",
      "type": "number",
      "default": 100,
      "label": "max page size"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "search_keys": "$search_keys",
      "sort_key": "$sort_key",
      "sort_desc": "$sort_desc",
      "sorts": "$sorts",
      "page_size": "$page_size",
      "max_page_size": "$max_page_size"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "Every client in the register, A to Z; search by name, PAN, status, form or stage.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "search_keys": [
          "name",
          "pan",
          "status",
          "form",
          "stage"
        ],
        "sort_key": "name",
        "sort_desc": false,
        "sorts": [
          "name",
          "pan",
          "stage",
          "updated_at"
        ],
        "page_size": 25,
        "max_page_size": 100
      }
    }
  ]
}
