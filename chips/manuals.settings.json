            "muted": "#8a7a5f"
          },
          {
            "id": "slate",
            "label": "Slate",
            "css": "#f1f5f9",
            "fg": "#0f172a",
            "muted": "#64748b"
          },
          {
            "id": "ink",
            "label": "Ink",
            "css": "#0f172a",
            "fg": "#f8fafc",
            "muted": "#94a3b8"
          },
          {
            "id": "indigo",
            "label": "Indigo",
            "css": "linear-gradient(135deg,#eef2ff,#e0e7ff)",
            "fg": "#1e1b4b",
            "muted": "#4f46e5"
          },
          {
            "id": "emerald",
            "label": "Emerald",
