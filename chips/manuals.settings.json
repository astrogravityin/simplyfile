        "help_link_type": "doc",
        "body_css": ".pg{padding:44px 48px;box-sizing:border-box;}\n.pg+.pg{border-top:1px solid rgba(100,116,139,.25);}\n.desc{font-size:15px;line-height:1.7;}\n.desc p{margin:0 0 12px;}\n.desc img,.desc svg{max-width:100%;}\n.desc ul,.desc ol{margin:0 0 12px;padding-left:22px;}\n.desc table{border-collapse:collapse;max-width:100%;}\n.desc td,.desc th{border:1px solid rgba(100,116,139,.35);padding:6px 9px;}\n.manual a[href^=\"#\"]:hover{text-decoration:underline;}\n@media print{.pg{break-after:page;page-break-after:always;}.pg:last-child{break-after:auto;page-break-after:auto;}.tolink{display:none;}}",
        "document_css": "html,body{margin:0;padding:0;background:#e2e8f0;}@page{margin:12mm;}@media print{body{background:#fff;}}"
      }
