    {
      "name": "paid_ok",
      "type": "text",
      "default": "Tax paid {amount} on {date} agrees.",
      "label": "paid ok"
    },
    {
      "name": "paid_amber",
      "type": "text",
      "default": "Tax paid {amount} on {date} is in 26AS but not in the books.",
