    {
      "name": "upload",
      "type": "text",
      "default": "Upload 26AS / AIS / TIS",
      "label": "upload"
    },
    {
      "name": "no_files",
      "type": "long",
      "default": "No portal files yet. Upload the 26AS text export from TRACES, or AIS / TIS as CSV or Excel.",
      "label": "no files"
    },
    {
      "name": "src_26as",
      "type": "text",
      "default": "26AS",
      "label": "src 26as"
