{
  "chip_id": "myreturn.read",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: how each document is recognised and read",
  "aliases": [
    "my return: how each document is recogni"
  ],
  "params": [
    {
      "name": "prefill_keys",
      "type": "json",
      "default": [
        "personalInfo",
        "form24q",
        "form26as",
        "insights",
        "bankAccountDtls"
      ],
      "label": "prefill keys"
    },
    {
      "name": "prefill",
      "type": "json",
      "default": {
        "exempt_new_codes": [
          "10(10)",
          "10(10A)",
          "10(10AA)",
          "10(10B)",
          "10(10C)"
        ],
        "via": {
          "c80c": "section80C",
          "c80ccc": "section80CCC",
          "c80ccd1": "section80CCDEmployeeOrSE",
          "c80ccd1b": "section80CCD1B",
          "c80ccd2": "section80CCDEmployer",
          "c80d_self": "section80D",
          "c80e": "section80E",
          "c80g": "section80G"
        }
      },
      "label": "prefill"
    },
    {
      "name": "words_form16",
      "type": "json",
      "default": [
        "form no. 16",
        "form no.16",
        "form 16",
        "certificate under section 203"
      ],
      "label": "words form16"
    },
    {
      "name": "words_ais",
      "type": "json",
      "default": [
