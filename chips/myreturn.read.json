        {
          "field": "c80ccc",
          "pattern": "section\\s*80\\s*CCC(?![A-Z])"
        },
        {
          "field": "c80ccd1",
          "pattern": "section\\s*80\\s*CCD\\s*\\(\\s*1\\s*\\)"
        },
        {
          "field": "c80ccd1b",
          "pattern": "section\\s*80\\s*CCD\\s*\\(\\s*1B\\s*\\)"
        },
        {
          "field": "c80ccd2",
          "pattern": "section\\s*80\\s*CC+D\\s*\\(\\s*2\\s*\\)"
        },
        {
          "field": "c80d_self",
          "pattern": "section\\s*80\\s*D(?![A-Z])"
        },
        {
          "field": "c80e",
          "pattern": "section\\s*80\\s*E(?![A-Z])"
        },
        {
          "field": "c80g",
          "pattern": "section\\s*80\\s*G(?![A-Z])"
