        },
        {
          "field": "commuted",
          "pattern": "section\\s*10\\s*\\(\\s*10A\\s*\\)"
        },
        {
          "field": "leave",
          "pattern": "section\\s*10\\s*\\(\\s*10AA\\s*\\)"
        },
        {
          "field": "hra",
