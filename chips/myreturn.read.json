            "word": "fd_tax",
            "path": "ITR2.PartB_TTI.ComputationOfTaxLiability.NetTaxLiability"
          },
          {
            "word": "fd_refund",
            "path": "ITR2.PartB_TTI.Refund.RefundDue"
          }
        ]
      },
