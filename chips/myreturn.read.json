    },
    {
      "name": "parta_total_anchor",
      "type": "text",
      "default": "^Total\\s*\\(Rs\\.?\\)",
      "label": "parta total anchor"
    },
    {
      "name": "regime_out_pattern",
      "type": "text",
      "default": "opting out of taxation u/s 115BAC\\s*\\(1A\\)\\s*\\??\\s*[:\\-]?\\s*(Yes|No)",
      "label": "regime out pattern"
    },
    {
      "name": "regime_in_pattern",
      "type": "text",
