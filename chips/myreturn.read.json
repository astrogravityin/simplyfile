          },
          {
            "word": "fd_total",
            "path": "ITR1.ITR1_IncomeDeductions.TotalIncome"
          },
          {
            "word": "fd_tax",
            "path": "ITR1.ITR1_TaxComputation.NetTaxLiability"
          },
          {
            "word": "fd_refund",
            "path": "ITR1.Refund.RefundDue"
