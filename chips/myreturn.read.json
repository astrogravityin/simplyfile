      "type": "json",
      "default": {
        "pepper": "GQ39%*g",
        "iterations": 1000
      },
      "label": "ais crypt"
    },
    {
      "name": "ais_code_pattern",
      "type": "text",
      "default": "\\b(?:SFT|TDS|TCS)-\\d{3}[A-Z]{0,2}(?:\\s*\\([A-Z]+\\))?",
      "label": "ais code pattern"
    },
    {
      "name": "ais_codes",
      "type": "json",
      "default": [
        {
          "code": "SFT-016\\s*\\(SB\\)",
          "field": "savings"
        },
        {
          "code": "SFT-016\\s*\\(TD\\)",
          "field": "deposits"
        },
        {
          "code": "SFT-016\\s*\\(OTH\\)",
          "field": "other"
        },
        {
          "code": "SFT-015.*",
          "field": "dividend"
        },
        {
          "code": "TDS-192.*",
          "field": "salary"
        },
        {
          "code": "SFT-01[78].*",
          "field": "sales"
        },
        {
          "title": "interest from savings",
          "field": "savings"
        },
        {
          "title": "interest from (term )?deposit",
          "field": "deposits"
        },
        {
          "title": "^dividend",
          "field": "dividend"
        },
        {
          "title": "interest on (income.tax )?refund",
          "field": "refund_interest"
        },
        {
          "title": "^salary",
          "field": "salary"
        },
        {
          "title": "sale of securities|units of mutual fund",
          "field": "sales"
        }
      ],
      "label": "ais codes"
    },
    {
      "name": "amount_pattern",
      "type": "text",
      "default": "(?<![\\w(.])\\d{1,3}(?:,\\d{2,3})+(?:\\.\\d{1,2})?(?![\\w)])|(?<![\\w(.,])\\d+\\.\\d{2}(?![\\w)])",
      "label": "amount pattern"
    },
    {
      "name": "tan_pattern",
      "type": "text",
      "default": "\\b[A-Z]{4}[0-9]{5}[A-Z]\\b",
      "label": "tan pattern"
    },
    {
      "name": "pan_pattern",
      "type": "text",
      "default": "\\b[A-Z]{5}[0-9]{4}[A-Z]\\b",
      "label": "pan pattern"
    },
    {
      "name": "employer_anchor",
      "type": "text",
      "default": "Name and address of the Employer",
      "label": "employer anchor"
    },
    {
      "name": "parta_total_anchor",
      "type": "text",
      "default": "^Total\\s*\\(Rs\\.?\\)",
      "label": "parta total anchor"
    },
    {
      "name": "regime_out_pattern",
      "type": "text",
      "default": "opting out of taxation u/s 115BAC\\s*\\(1A\\)\\s*\\??\\s*[:\\-]?\\s*(Yes|No)",
      "label": "regime out pattern"
    },
    {
      "name": "regime_in_pattern",
      "type": "text",
      "default": "opting for taxation u/s 115BAC\\s*\\??\\s*[:\\-]?\\s*(Yes|No)",
      "label": "regime in pattern"
    },
    {
      "name": "form16_anchors",
      "type": "json",
      "default": [
        {
          "field": "gross_17_1",
          "pattern": "section\\s*17\\s*\\(\\s*1\\s*\\)"
        },
        {
          "field": "perq_17_2",
          "pattern": "section\\s*17\\s*\\(\\s*2\\s*\\)"
        },
        {
          "field": "profit_17_3",
          "pattern": "section\\s*17\\s*\\(\\s*3\\s*\\)"
        },
        {
          "field": "lta",
          "pattern": "section\\s*10\\s*\\(\\s*5\\s*\\)"
        },
        {
          "field": "gratuity",
          "pattern": "section\\s*10\\s*\\(\\s*10\\s*\\)"
        },
        {
          "field": "commuted",
          "pattern": "section\\s*10\\s*\\(\\s*10A\\s*\\)"
        },
        {
          "field": "leave",
          "pattern": "section\\s*10\\s*\\(\\s*10AA\\s*\\)"
        },
        {
          "field": "hra",
          "pattern": "section\\s*10\\s*\\(\\s*13A\\s*\\)"
