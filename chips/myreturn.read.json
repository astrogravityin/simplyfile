        {
          "field": "exempt_total",
          "pattern": "Total amount of exemption claimed under section 10"
        },
        {
          "field": "std",
          "pattern": "section\\s*16\\s*\\(\\s*ia\\s*\\)"
        },
        {
          "field": "prof_tax",
          "pattern": "section\\s*16\\s*\\(\\s*iii\\s*\\)"
