        "information code"
      ],
      "label": "words ais"
    },
    {
      "name": "words_26as",
      "type": "json",
      "default": [
        "form 26as",
        "annual tax statement",
        "tan of deductor",
        "total tax deducted"
      ],
      "label": "words 26as"
    },
    {
      "name": "ais_crypt",
      "type": "json",
      "default": {
        "pepper": "GQ39%*g",
        "iterations": 1000
      },
      "label": "ais crypt"
    },
    {
      "name": "ais_code_pattern",
      "type": "text",
      "default": "\\b(?:SFT|TDS|TCS)-\\d{3}[A-Z]{0,2}(?:\\s*\\([A-Z]+\\))?",
      "label": "ais code pattern"
    },
    {
      "name": "ais_codes",
      "type": "json",
      "default": [
        {
          "code": "SFT-016\\s*\\(SB\\)",
          "field": "savings"
        },
        {
          "code": "SFT-016\\s*\\(TD\\)",
          "field": "deposits"
        },
        {
          "code": "SFT-016\\s*\\(OTH\\)",
          "field": "other"
        },
        {
          "code": "SFT-015.*",
          "field": "dividend"
        },
        {
          "code": "TDS-192.*",
          "field": "salary"
        },
        {
          "code": "SFT-01[78].*",
          "field": "sales"
        },
        {
          "title": "interest from savings",
          "field": "savings"
        },
        {
          "title": "interest from (term )?deposit",
          "field": "deposits"
        },
        {
          "title": "^dividend",
          "field": "dividend"
        },
        {
          "title": "interest on (income.tax )?refund",
          "field": "refund_interest"
        },
        {
          "title": "^salary",
          "field": "salary"
        },
        {
          "title": "sale of securities|units of mutual fund",
          "field": "sales"
        }
      ],
      "label": "ais codes"
    },
    {
      "name": "amount_pattern",
      "type": "text",
      "default": "(?<![\\w(.])\\d{1,3}(?:,\\d{2,3})+(?:\\.\\d{1,2})?(?![\\w)])|(?<![\\w(.,])\\d+\\.\\d{2}(?![\\w)])",
      "label": "amount pattern"
    },
    {
      "name": "tan_pattern",
      "type": "text",
      "default": "\\b[A-Z]{4}[0-9]{5}[A-Z]\\b",
      "label": "tan pattern"
    },
    {
      "name": "pan_pattern",
      "type": "text",
      "default": "\\b[A-Z]{5}[0-9]{4}[A-Z]\\b",
      "label": "pan pattern"
    },
    {
      "name": "employer_anchor",
