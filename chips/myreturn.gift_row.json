{
  "chip_id": "myreturn.gift_row",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: one gift received",
  "aliases": [
    "gift",
    "56(2)(x)"
  ],
  "params": [
    {
      "name": "relation",
      "type": "text",
      "default": "",
      "label": "who gave it (chip myreturn.gift_rules relatives), blank for anyone else"
    },
    {
      "name": "occasion",
      "type": "text",
      "default": "",
      "label": "marriage / will / inheritance / death, or blank"
    },
    {
      "name": "kind",
      "type": "text",
      "default": "money",
      "label": "money / property (immovable: land, building) / movable (shares, jewellery, art ...)"
    },
    {
      "name": "value",
      "type": "number",
      "default": 0,
      "label": "the sum, or the stamp-duty value (property), or the fair market value (movable)"
    },
    {
      "name": "paid",
      "type": "number",
      "default": 0,
      "label": "what the person paid for it"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "counts": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "not",
                  "item": {
                    "op": "in_set",
                    "value": "$relation",
                    "set": {
                      "vop": "get",
                      "value": {
                        "chip": "myreturn.gift_rules",
                        "args": {}
                      },
                      "path": "relatives"
                    }
                  }
                },
                {
                  "op": "not",
                  "item": {
                    "op": "in_set",
                    "value": "$occasion",
                    "set": {
                      "vop": "get",
                      "value": {
                        "chip": "myreturn.gift_rules",
                        "args": {}
                      },
                      "path": "exempt_occasions"
                    }
                  }
                }
              ]
            },
            "then": true
          }
        ],
        "else": false
      },
      "money": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "all",
