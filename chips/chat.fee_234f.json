{
  "chip_id": "chat.fee_234f",
  "kind": "accessor",
  "set": "chat",
  "label": "Late fee under 234F",
  "aliases": [
    "late fee under 234f"
  ],
  "params": [
    {
      "name": "income",
      "type": "number",
      "default": 0,
      "label": "total income"
    },
    {
      "name": "small_upto",
      "type": "number",
      "default": 500000,
      "label": ""
    },
    {
      "name": "small_fee",
      "type": "number",
      "default": 1000,
      "label": ""
    },
    {
      "name": "fee",
      "type": "number",
      "default": 5000,
      "label": ""
    }
  ],
  "expr": {
    "vop": "choose",
    "cases": [
      {
        "when": {
          "op": "le",
          "left": "$income",
          "right": "$small_upto"
        },
        "then": "$small_fee"
      }
    ],
    "else": "$fee"
  },
  "returns": "number",
  "version": 1,
  "status": "published",
  "description_nl": "2026-10-04: s.234F - a return filed after the due date pays Rs 1,000 when total income is up to Rs 5 lakh, else Rs 5,000.",
  "test_cases": [
    {
      "args": {
        "income": 400000,
        "small_upto": 500000,
        "small_fee": 1000,
        "fee": 5000
      },
      "expect_value": 1000
    },
    {
      "args": {
        "income": 900000,
        "small_upto": 500000,
        "small_fee": 1000,
        "fee": 5000
      },
      "expect_value": 5000
    }
  ]
}
