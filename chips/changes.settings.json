{
  "chip_id": "changes.settings",
  "kind": "accessor",
  "set": "changes",
  "label": "Change log settings",
  "aliases": [
    "change log settings"
  ],
  "params": [
    {
      "name": "value_max",
      "type": "json",
      "default": 200,
      "label": "value max"
    },
    {
      "name": "keep_max",
      "type": "json",
      "default": 20000,
      "label": "keep max"
    },
    {
      "name": "list_keys",
      "type": "json",
      "default": [
        "id",
        "n"
      ],
      "label": "list keys"
    },
    {
      "name": "system_by",
      "type": "text",
      "default": "{product}",
      "label": "system by"
    },
    {
      "name": "kinds",
      "type": "json",
      "default": [
        "info",
        "doc"
      ],
      "label": "kinds"
    },
    {
      "name": "yearless_in_every_year",
      "type": "json",
      "default": true,
      "label": "yearless in every year"
    },
    {
      "name": "who_fields",
      "type": "json",
      "default": [
        "name",
        "email"
      ],
      "label": "who fields"
    },
    {
      "name": "blank",
      "type": "json",
      "default": [
        null,
        "",
        false
      ],
      "label": "blank"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "value_max": "$value_max",
      "keep_max": "$keep_max",
      "list_keys": "$list_keys",
      "system_by": "$system_by",
      "kinds": "$kinds",
      "yearless_in_every_year": "$yearless_in_every_year",
      "who_fields": "$who_fields",
      "blank": "$blank"
    }
  },
  "returns": "record",
  "version": 2,
  "status": "published",
  "description_nl": "2026-10-05: how long a value may be in the log, how many entries a client or firm keeps, how lists of records are lined up, and the name for changes no person made. 2026-10-06: system_by is {product} - changelog fills the portal's own name (Justify said SimplyFile).",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "value_max": 200,
        "keep_max": 20000,
        "list_keys": [
          "id",
          "n"
        ],
        "system_by": "{product}",
        "kinds": [
          "info",
          "doc"
        ],
        "yearless_in_every_year": true,
        "who_fields": [
          "name",
          "email"
        ],
        "blank": [
          null,
          "",
          false
        ]
      }
    }
  ]
}
