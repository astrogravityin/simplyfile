{
  "chip_id": "company.tax_s1",
  "kind": "accessor",
  "set": "company",
  "label": "Company: the tax, stage 1 (income, tax at normal and special rates, surcharge rate, band edge)",
  "aliases": [
    "company: the tax, stage 1 (income, tax a"
  ],
  "params": [
    {
      "name": "main",
      "type": "number",
      "default": 0,
      "label": "income at the option's rate (all normal-rate income; 115BAB: the manufacturing business)"
    },
    {
      "name": "other",
      "type": "number",
      "default": 0,
      "label": "income at the other rate (115BAB: income other than the business)"
    },
    {
      "name": "stcg_111a",
      "type": "number",
      "default": 0,
      "label": "STCG u/s 111A"
    },
    {
      "name": "ltcg_112a",
      "type": "number",
      "default": 0,
      "label": "LTCG u/s 112A (before the exemption)"
    },
    {
      "name": "ltcg_112",
      "type": "number",
      "default": 0,
      "label": "LTCG u/s 112"
    },
    {
      "name": "rate",
      "type": "number",
      "default": 25,
      "label": "the option's rate %"
    },
    {
      "name": "other_rate",
      "type": "number",
      "default": 25,
      "label": "the rate on 'other' %"
    },
    {
      "name": "steps",
      "type": "json",
      "default": [
        {
          "above": 10000000,
          "rate": 7
        },
        {
          "above": 100000000,
          "rate": 12
        }
      ],
      "label": "surcharge steps"
    },
    {
      "name": "cg",
      "type": "json",
      "default": {
        "stcg_111a": 20,
        "ltcg_112a": 12.5,
        "ltcg_112": 12.5,
        "exempt_112a": 125000
      },
      "label": "special rates (company.settings rates_by_ay cg)"
    },
    {
      "name": "cess_pct",
      "type": "number",
      "default": 4,
      "label": "cess %"
    },
    {
      "name": "round_to",
      "type": "number",
      "default": 10,
      "label": "tax rounded to (s.288B)"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "income": {
        "vop": "total",
        "values": [
          "$main",
          "$other",
          "$stcg_111a",
          "$ltcg_112a",
          "$ltcg_112"
        ]
      },
      "at_normal": {
        "vop": "total",
        "values": [
          {
            "vop": "div",
            "a": {
              "vop": "mul",
              "a": "$main",
              "b": "$rate"
            },
            "b": 100
          },
          {
            "vop": "div",
            "a": {
              "vop": "mul",
              "a": "$other",
              "b": "$other_rate"
            },
            "b": 100
          }
        ]
      },
      "on_111a": {
        "vop": "div",
        "a": {
          "vop": "mul",
          "a": "$stcg_111a",
          "b": {
            "vop": "get",
            "value": "$cg",
            "path": "stcg_111a"
          }
        },
        "b": 100
      },
      "on_112a": {
        "vop": "div",
        "a": {
          "vop": "mul",
          "a": {
            "vop": "largest",
            "values": [
              0,
              {
                "vop": "sub",
                "a": "$ltcg_112a",
                "b": {
                  "vop": "get",
                  "value": "$cg",
                  "path": "exempt_112a"
                }
              }
            ]
          },
          "b": {
            "vop": "get",
            "value": "$cg",
            "path": "ltcg_112a"
          }
        },
        "b": 100
      },
      "on_112": {
        "vop": "div",
        "a": {
          "vop": "mul",
          "a": "$ltcg_112",
          "b": {
            "vop": "get",
            "value": "$cg",
            "path": "ltcg_112"
          }
        },
        "b": 100
      },
      "at_special": {
        "vop": "total",
        "values": [
          {
            "vop": "div",
            "a": {
              "vop": "mul",
              "a": "$stcg_111a",
              "b": {
                "vop": "get",
                "value": "$cg",
                "path": "stcg_111a"
              }
            },
            "b": 100
          },
          {
            "vop": "div",
            "a": {
              "vop": "mul",
              "a": {
                "vop": "largest",
                "values": [
                  0,
                  {
                    "vop": "sub",
                    "a": "$ltcg_112a",
                    "b": {
                      "vop": "get",
                      "value": "$cg",
                      "path": "exempt_112a"
                    }
                  }
                ]
              },
              "b": {
                "vop": "get",
                "value": "$cg",
                "path": "ltcg_112a"
              }
            },
            "b": 100
          },
          {
            "vop": "div",
            "a": {
              "vop": "mul",
              "a": "$ltcg_112",
              "b": {
                "vop": "get",
                "value": "$cg",
                "path": "ltcg_112"
              }
            },
            "b": 100
          }
        ]
      },
      "rate_on": {
        "vop": "coalesce",
        "values": [
          {
            "vop": "step_rate",
            "amount": {
              "vop": "total",
              "values": [
                "$main",
                "$other",
                "$stcg_111a",
                "$ltcg_112a",
                "$ltcg_112"
              ]
            },
            "steps": "$steps"
          },
          0
        ]
      },
      "threshold": {
        "vop": "coalesce",
        "values": [
          {
            "vop": "step_rate",
            "amount": {
              "vop": "total",
              "values": [
                "$main",
                "$other",
                "$stcg_111a",
                "$ltcg_112a",
                "$ltcg_112"
              ]
            },
            "steps": "$steps",
            "field": "above"
          },
          0
        ]
      }
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-10-11: Part of chip company.tax: the income, the tax at the option's rate(s), at 111A / 112A (above the exemption) / 112, the surcharge rate for this income and the band's lower edge.",
  "test_cases": [
    {
      "args": {
        "main": 50000000
      },
      "expect_value": {
        "income": 50000000.0,
        "at_normal": 12500000.0,
        "on_111a": 0,
        "on_112a": 0,
        "on_112": 0,
        "at_special": 0.0,
        "rate_on": 7,
        "threshold": 10000000
      }
    }
  ]
}
