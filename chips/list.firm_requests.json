{
  "chip_id": "list.firm_requests",
  "kind": "accessor",
  "set": "list",
  "label": "Firm approvals list",
  "aliases": [
    "firm approvals list"
  ],
  "params": [
    {
      "name": "search_keys",
      "type": "list",
      "default": [
        "name",
        "pan",
        "email",
        "kind_label"
      ],
      "label": "search keys"
    },
    {
      "name": "sort_key",
      "type": "text",
      "default": "queue_at",
      "label": "sort key"
    },
    {
      "name": "sort_desc",
      "type": "boolean",
      "default": false,
      "label": "sort desc"
    },
    {
      "name": "sorts",
      "type": "list",
      "default": [
        "queue_at",
        "name"
      ],
      "label": "sorts"
    },
    {
      "name": "page_size",
      "type": "number",
      "default": 20,
      "label": "page size"
    },
    {
      "name": "max_page_size",
      "type": "number",
      "default": 100,
      "label": "max page size"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "search_keys": "$search_keys",
      "sort_key": "$sort_key",
      "sort_desc": "$sort_desc",
      "sorts": "$sorts",
      "page_size": "$page_size",
      "max_page_size": "$max_page_size"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-10-04: Firm approvals - waiting first, oldest first; search by name, PAN, email or kind.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "search_keys": [
          "name",
          "pan",
          "email",
          "kind_label"
        ],
        "sort_key": "queue_at",
        "sort_desc": false,
        "sorts": [
          "queue_at",
          "name"
        ],
        "page_size": 20,
        "max_page_size": 100
      }
    }
  ]
}
