    },
    {
      "name": "compound_suffixes",
      "type": "list",
      "default": [
        ".blade.php"
      ]
    },
    {
      "name": "generated_suffixes",
      "type": "list",
      "default": [
        ".designer.cs",
        ".designer.vb"
      ]
    },
    {
      "name": "max_route_length",
      "type": "number",
      "default": 80
    },
    {
      "name": "manifest_file",
      "type": "text",
      "default": "screens.json"
    },
    {
      "name": "default_key",
      "type": "text",
      "default": "screen"
    },
    {
      "name": "confidence_likely",
      "type": "text",
      "default": "likely"
    },
    {
      "name": "confidence_maybe",
      "type": "text",
      "default": "maybe"
    },
    {
      "name": "confidence_declared",
      "type": "text",
      "default": "declared"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "max_files": "$max_files",
      "read_bytes": "$read_bytes",
      "skip_dirs": "$skip_dirs",
      "skip_hidden_dirs": "$skip_hidden_dirs",
      "ui_ext": "$ui_ext",
      "screen_dirs": "$screen_dirs",
      "screen_code_ext": "$screen_code_ext",
      "markup_page": "$markup_page",
      "layout_ext": "$layout_ext",
      "compound_suffixes": "$compound_suffixes",
      "generated_suffixes": "$generated_suffixes",
      "max_route_length": "$max_route_length",
      "manifest_file": "$manifest_file",
      "default_key": "$default_key",
      "confidence_likely": "$confidence_likely",
      "confidence_maybe": "$confidence_maybe",
      "confidence_declared": "$confidence_declared"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "max_files: the walk stops after this many files. read_bytes: larger files are not read (no routes or titles from them). skip_dirs: folders never entered (exact name). skip_hidden_dirs: folders starting with a dot are skipped too. ui_ext: extensions a person looks at, every stack. screen_dirs: folder names whose contents are screens by convention. screen_code_ext: source files that count only inside a screen folder. markup_page: templates read as a whole page (their <title> names the screen). layout_ext: the extension of an Android res/layout file. compound_suffixes: two-part extensions read as one. generated_suffixes: generated files, never a screen. max_route_length: longer route strings are ignored. manifest_file: a project's own screen list, believed outright. default_key: the key when a label has no letters. confidence_*: the tag each candidate carries (the Setup grid colours 'maybe').",
