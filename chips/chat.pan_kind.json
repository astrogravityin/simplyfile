    {
      "args": {
        "letter": "H",
        "kinds": {
          "P": "an individual",
          "H": "a Hindu Undivided Family",
          "F": "a firm or LLP",
          "C": "a company",
          "A": "an association of persons",
          "B": "a body of individuals",
          "T": "a trust",
          "L": "a local authority",
          "J": "an artificial juridical person",
          "G": "a government body"
        }
      },
      "expect_value": "a Hindu Undivided Family"
    }
  ]
}
