{
  "chip_id": "wizard.prompts",
  "kind": "accessor",
  "set": "wizard",
  "label": "New filing: what the documents imply - further documents or figures to give",
  "aliases": [
    "new filing: what the documents imply - further documents or figures to give"
  ],
  "params": [
    {
      "name": "sales",
      "type": "number",
      "default": 0,
      "label": "sales"
    },
    {
      "name": "cg_docs",
      "type": "number",
      "default": 0,
      "label": "cg_docs"
    },
    {
      "name": "ia",
      "type": "number",
      "default": 0,
      "label": "ia"
    },
    {
      "name": "property_rows",
      "type": "number",
      "default": 0,
      "label": "property_rows"
    },
    {
      "name": "tans_missing",
      "type": "number",
      "default": 0,
      "label": "tans_missing"
    },
    {
      "name": "vda_seen",
      "type": "number",
      "default": 0,
      "label": "vda_seen"
    },
    {
      "name": "vda_rows",
      "type": "number",
      "default": 0,
      "label": "vda_rows"
    },
    {
      "name": "fees",
      "type": "number",
      "default": 0,
      "label": "fees"
    },
    {
      "name": "business",
      "type": "boolean",
      "default": false,
      "label": "business"
    },
    {
      "name": "gst_docs",
      "type": "number",
      "default": 0,
      "label": "gst_docs"
    },
    {
      "name": "losses",
      "type": "boolean",
      "default": false,
      "label": "losses"
    },
    {
      "name": "prev_docs",
      "type": "number",
      "default": 0,
      "label": "prev_docs"
    },
    {
      "name": "foreign",
      "type": "boolean",
      "default": false,
      "label": "foreign"
    },
    {
      "name": "fa_rows",
      "type": "number",
      "default": 0,
      "label": "fa_rows"
    },
    {
      "name": "arrears",
      "type": "boolean",
      "default": false,
      "label": "arrears"
    },
    {
      "name": "arrear_rows",
      "type": "number",
      "default": 0,
      "label": "arrear_rows"
    },
    {
      "name": "flow",
      "type": "text",
      "default": "myreturn",
      "label": "flow"
    },
    {
      "name": "books_docs",
      "type": "number",
      "default": 0,
      "label": "books_docs"
    },
    {
      "name": "gst_pick",
      "type": "boolean",
      "default": false,
      "label": "gst_pick"
    },
    {
      "name": "gst_json_docs",
      "type": "number",
      "default": 0,
      "label": "gst_json_docs"
    },
    {
      "name": "has_partners",
      "type": "boolean",
      "default": false,
      "label": "has_partners"
    },
    {
      "name": "deed_docs",
      "type": "number",
      "default": 0,
      "label": "deed_docs"
    },
    {
      "name": "stock_pick",
      "type": "boolean",
      "default": false,
      "label": "stock_pick"
    },
    {
      "name": "dep_pick",
      "type": "boolean",
      "default": false,
      "label": "dep_pick"
    },
    {
      "name": "prev5_docs",
      "type": "number",
      "default": 0,
      "label": "prev5_docs"
    },
    {
      "name": "audit_pick",
      "type": "boolean",
      "default": false,
      "label": "audit_pick"
    }
  ],
  "expr": {
    "vop": "compact",
    "values": [
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "gt",
              "left": "$tans_missing",
              "right": 0
            },
            "then": "form16_more"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "gt",
                  "left": "$sales",
                  "right": 0
                },
                {
                  "op": "eq",
                  "left": "$cg_docs",
                  "right": 0
                }
              ]
            },
            "then": "cams"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "gt",
                  "left": "$ia",
                  "right": 0
                },
                {
                  "op": "eq",
                  "left": "$property_rows",
                  "right": 0
                }
              ]
            },
            "then": "property"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "gt",
                  "left": "$vda_seen",
                  "right": 0
                },
                {
                  "op": "eq",
                  "left": "$vda_rows",
                  "right": 0
                }
              ]
            },
            "then": "vda"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "gt",
                  "left": "$fees",
                  "right": 0
                },
                {
                  "op": "not",
                  "item": "$business"
                },
                {
                  "op": "not",
                  "item": {
                    "op": "eq",
                    "left": "$flow",
                    "right": "firm"
                  }
                }
              ]
            },
            "then": "business"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "eq",
                  "left": "$business",
                  "right": true
                },
                {
                  "op": "eq",
                  "left": "$gst_docs",
                  "right": 0
                },
                {
                  "op": "not",
                  "item": {
                    "op": "eq",
                    "left": "$flow",
                    "right": "firm"
                  }
                }
              ]
            },
            "then": "gst"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "eq",
                  "left": "$losses",
                  "right": true
                },
                {
                  "op": "eq",
                  "left": "$prev_docs",
                  "right": 0
                }
              ]
            },
            "then": "last_itr"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "eq",
                  "left": "$foreign",
                  "right": true
                },
                {
                  "op": "eq",
                  "left": "$fa_rows",
                  "right": 0
                }
              ]
            },
            "then": "foreign"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "eq",
                  "left": "$arrears",
                  "right": true
                },
                {
                  "op": "eq",
                  "left": "$arrear_rows",
                  "right": 0
                }
              ]
            },
            "then": "arrears"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "eq",
                  "left": "$flow",
                  "right": "firm"
                },
                {
                  "op": "eq",
                  "left": "$books_docs",
                  "right": 0
                }
              ]
            },
            "then": "books"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "eq",
                  "left": "$flow",
                  "right": "firm"
                },
                {
                  "op": "eq",
                  "left": "$gst_pick",
                  "right": true
                },
                {
                  "op": "eq",
                  "left": "$gst_json_docs",
                  "right": 0
                }
              ]
            },
            "then": "gst_json"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "eq",
                  "left": "$flow",
                  "right": "firm"
                },
                {
                  "op": "eq",
                  "left": "$has_partners",
                  "right": true
                },
                {
                  "op": "eq",
                  "left": "$deed_docs",
                  "right": 0
                }
              ]
            },
            "then": "deed"
          }
        ],
        "else": ""
      },
      {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "eq",
                  "left": "$flow",
                  "right": "firm"
                },
                {
                  "op": "eq",
                  "left": "$stock_pick",
                  "right": true
                }
              ]
            },
            "then": "stock"
