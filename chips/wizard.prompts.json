              "items": [
                {
                  "op": "eq",
                  "left": "$flow",
                  "right": "firm"
                },
                {
                  "op": "eq",
                  "left": "$audit_pick",
                  "right": true
                }
              ]
            },
            "then": "audit_3cd"
          }
        ],
        "else": ""
      }
    ]
  },
