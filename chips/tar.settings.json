{
  "chip_id": "tar.settings",
  "kind": "accessor",
  "set": "tar",
  "label": "3CD JSON: the schemas and which form",
  "aliases": [
    "3cd json: the schemas and which form"
  ],
  "params": [
    {
      "name": "forms",
      "type": "json",
      "default": {
        "3CB": {
          "schema": "schemas/3cd/schema_3CB.json",
          "root": "F3CB",
          "wrap": "FORM3CB"
        },
        "3CA": {
          "schema": "schemas/3cd/schema_3CA.json",
          "root": "F3CA",
          "wrap": "FORM3CA"
        }
      },
      "label": "forms"
    },
    {
      "name": "default_form",
      "type": "text",
      "default": "3CB",
      "label": "default form"
    },
    {
      "name": "form_by_status",
      "type": "json",
      "default": {},
      "label": "form by status"
    },
    {
      "name": "pan_pattern",
      "type": "text",
      "default": "[A-Z]{5}[0-9]{4}[A-Z]",
      "label": "pan pattern"
    },
    {
      "name": "address_blank",
      "type": "text",
      "default": "-",
      "label": "address blank"
    },
    {
      "name": "pan_loose",
      "type": "text",
      "default": "[A-Z]{5}\\s?[0-9]{4}\\s?[A-Z]",
      "label": "pan loose"
    },
    {
      "name": "address_join",
      "type": "text",
      "default": ", ",
      "label": "address join"
    },
    {
      "name": "address_trim",
      "type": "text",
      "default": " ,.;:-\\/",
      "label": "address trim"
    },
    {
      "name": "address_max",
      "type": "json",
      "default": 150,
      "label": "address max"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "forms": "$forms",
      "default_form": "$default_form",
      "form_by_status": "$form_by_status",
      "pan_pattern": "$pan_pattern",
      "address_blank": "$address_blank",
      "pan_loose": "$pan_loose",
      "address_join": "$address_join",
      "address_trim": "$address_trim",
      "address_max": "$address_max"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "Form 3CA when the accounts are audited under another law (a company, a co-operative society), else 3CB - SimplyFy's statuses are 3CB by default (form_by_status names a status that takes 3CA). Schema V2.5, 1 April 2026, incometax.gov.in > Downloads > Income Tax Forms. The CA's details (OtherInformation1) are the CA firm's own, from its approved application. 2026-10-05 owner (3CD from a party master): a party's PAN as statements write it (AECPJ 3943 D); address_join/trim/max: the lines under a party's name become one address that fits the schema.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "forms": {
          "3CB": {
            "schema": "schemas/3cd/schema_3CB.json",
            "root": "F3CB",
            "wrap": "FORM3CB"
          },
          "3CA": {
            "schema": "schemas/3cd/schema_3CA.json",
            "root": "F3CA",
            "wrap": "FORM3CA"
          }
        },
        "default_form": "3CB",
        "form_by_status": {},
        "pan_pattern": "[A-Z]{5}[0-9]{4}[A-Z]",
        "address_blank": "-",
        "pan_loose": "[A-Z]{5}\\s?[0-9]{4}\\s?[A-Z]",
        "address_join": ", ",
        "address_trim": " ,.;:-\\/",
        "address_max": 150
      }
    }
  ]
}
