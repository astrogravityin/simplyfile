{
  "chip_id": "audit.settings",
  "kind": "accessor",
  "set": "audit",
  "label": "Tax audit settings",
  "aliases": [
    "tax audit settings"
  ],
  "params": [
    {
      "name": "tables",
      "type": "json",
      "default": [
        "PL",
        "BS"
      ],
      "label": "tables"
    },
    {
      "name": "revenue_items",
      "type": "json",
      "default": [
        "sales",
        "services",
        "professional_receipts"
      ],
      "label": "revenue items"
    },
    {
      "name": "profession_items",
      "type": "json",
      "default": [
        "professional_receipts"
      ],
      "label": "profession items"
    },
    {
      "name": "prev_pattern",
      "type": "text",
      "default": "(?i)previous|prev\\.?\\s*y|last\\s*year|preceding|\\bpy\\b|2024-25|31[./-]0?3[./-](?:20)?25",
      "label": "prev pattern"
    },
    {
      "name": "check_states",
      "type": "json",
      "default": [
        "todo",
        "done",
        "na",
        "issue"
      ],
      "label": "check states"
    },
    {
      "name": "point_states",
      "type": "json",
      "default": [
        "open",
        "cleared"
      ],
      "label": "point states"
    },
    {
      "name": "issue_raises_point",
      "type": "json",
      "default": true,
      "label": "issue raises point"
    },
    {
      "name": "fact_keys",
      "type": "json",
      "default": [
        "cash_ok",
        "presumptive_lower",
        "income_above_exempt"
      ],
      "label": "fact keys"
    },
    {
      "name": "last_year_from",
      "type": "json",
      "default": [
        "statements",
        "return",
        "column"
      ],
      "label": "last year from"
    },
    {
      "name": "return_only_current",
      "type": "json",
      "default": true,
      "label": "return only current"
    },
    {
      "name": "bs_prefix",
      "type": "text",
      "default": "PARTA_BS",
      "label": "bs prefix"
    },
    {
      "name": "issue_state",
      "type": "text",
      "default": "issue",
      "label": "issue state"
    },
    {
      "name": "done_states",
      "type": "json",
      "default": [
        "done",
        "na"
      ],
      "label": "done states"
    },
    {
      "name": "open_state",
      "type": "text",
      "default": "open",
      "label": "open state"
    },
    {
      "name": "cleared_state",
      "type": "text",
      "default": "cleared",
      "label": "cleared state"
    },
    {
      "name": "point_sources",
      "type": "json",
      "default": [
        "trend",
        "check",
        "hand"
      ],
      "label": "point sources"
    },
    {
      "name": "hand_source",
      "type": "text",
      "default": "hand",
      "label": "hand source"
    },
    {
      "name": "check_source",
      "type": "text",
      "default": "check",
      "label": "check source"
    },
    {
      "name": "trend_source",
      "type": "text",
      "default": "trend",
      "label": "trend source"
    },
    {
      "name": "title_max",
      "type": "json",
      "default": 300,
      "label": "title max"
    },
    {
      "name": "note_max",
      "type": "json",
      "default": 1000,
      "label": "note max"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "tables": "$tables",
      "revenue_items": "$revenue_items",
      "profession_items": "$profession_items",
      "prev_pattern": "$prev_pattern",
      "check_states": "$check_states",
      "point_states": "$point_states",
      "issue_raises_point": "$issue_raises_point",
      "fact_keys": "$fact_keys",
      "last_year_from": "$last_year_from",
      "return_only_current": "$return_only_current",
      "bs_prefix": "$bs_prefix",
      "issue_state": "$issue_state",
      "done_states": "$done_states",
      "open_state": "$open_state",
      "cleared_state": "$cleared_state",
      "point_sources": "$point_sources",
      "hand_source": "$hand_source",
      "check_source": "$check_source",
      "trend_source": "$trend_source",
      "title_max": "$title_max",
      "note_max": "$note_max"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-10-04: what the tax audit screen compares, what counts as turnover, how last year's column is recognised, the states of a checklist line and an audit point, and the facts a person answers.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "tables": [
          "PL",
          "BS"
        ],
        "revenue_items": [
          "sales",
          "services",
          "professional_receipts"
        ],
        "profession_items": [
          "professional_receipts"
        ],
        "prev_pattern": "(?i)previous|prev\\.?\\s*y|last\\s*year|preceding|\\bpy\\b|2024-25|31[./-]0?3[./-](?:20)?25",
        "check_states": [
          "todo",
          "done",
          "na",
          "issue"
        ],
        "point_states": [
          "open",
          "cleared"
        ],
        "issue_raises_point": true,
        "fact_keys": [
          "cash_ok",
          "presumptive_lower",
          "income_above_exempt"
        ],
        "last_year_from": [
          "statements",
          "return",
          "column"
        ],
        "return_only_current": true,
        "bs_prefix": "PARTA_BS",
        "issue_state": "issue",
        "done_states": [
          "done",
          "na"
        ],
        "open_state": "open",
        "cleared_state": "cleared",
        "point_sources": [
          "trend",
          "check",
          "hand"
        ],
        "hand_source": "hand",
        "check_source": "check",
        "trend_source": "trend",
        "title_max": 300,
        "note_max": 1000
      }
    }
  ]
}
