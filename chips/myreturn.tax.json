      "band": "$band",
      "resident": "$resident",
      "status": "$status",
      "lottery": "$lottery",
      "online_games": "$online_games",
      "vda": "$vda",
      "agri": "$agri",
      "excess_112": "$excess_112",
      "b": {
        "chip": "myreturn.tax_s4",
        "args": {
          "normal": "$normal",
          "stcg_111a": "$stcg_111a",
          "ltcg_112a": "$ltcg_112a",
          "ltcg_112": "$ltcg_112",
          "regime": "$regime",
          "band": "$band",
          "resident": "$resident",
          "status": "$status",
          "lottery": "$lottery",
