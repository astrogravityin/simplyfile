{
  "chip_id": "myreturn.tax",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: tax on total income, per regime (slabs, special rates, 87A, surcharge, cess)",
  "aliases": [
    "my return: tax on total income, per regi"
  ],
  "params": [
    {
      "name": "normal",
      "type": "number",
      "default": 0,
      "label": "total income at normal rates (after Chapter VI-A), rounded"
    },
    {
      "name": "stcg_111a",
      "type": "number",
      "default": 0,
      "label": "short-term gains on listed shares/equity funds (111A)"
    },
    {
      "name": "ltcg_112a",
      "type": "number",
      "default": 0,
      "label": "long-term gains on listed shares/equity funds (112A), before the 1.25 lakh exemption"
    },
    {
      "name": "ltcg_112",
      "type": "number",
      "default": 0,
      "label": "other long-term gains (112)"
    },
    {
      "name": "regime",
      "type": "text",
      "default": "new",
      "label": "regime"
    },
    {
      "name": "band",
      "type": "text",
      "default": "below60",
      "label": "age band"
    },
    {
      "name": "resident",
      "type": "boolean",
      "default": true,
      "label": "resident in India"
    },
    {
      "name": "status",
      "type": "text",
      "default": "individual",
      "label": "individual / huf"
    },
    {
      "name": "lottery",
      "type": "number",
      "default": 0,
      "label": "115BB winnings (lottery, crossword, races, gambling, betting)"
    },
    {
      "name": "online_games",
      "type": "number",
      "default": 0,
      "label": "115BBJ net winnings from online games"
    },
    {
      "name": "vda",
      "type": "number",
      "default": 0,
      "label": "115BBH income from virtual digital assets"
    },
    {
      "name": "agri",
      "type": "number",
      "default": 0,
      "label": "net agricultural income (exempt, but counts for the rate)"
    },
    {
      "name": "excess_112",
      "type": "number",
      "default": 0,
      "label": "proviso to s.112(1)(a): the tax at 12.5% without indexation less the tax at 20% with it, land / building bought before 23 July 2024 (chip myreturn.cg_choice) - left out of the 112 tax"
    }
  ],
  "expr": {
    "chip": "myreturn.tax_s5",
    "args": {
      "normal": "$normal",
      "stcg_111a": "$stcg_111a",
      "ltcg_112a": "$ltcg_112a",
