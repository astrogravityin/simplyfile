              "b": {
                "chip": "myreturn.tax_s2",
                "args": {
                  "normal": "$normal",
                  "stcg_111a": "$stcg_111a",
                  "ltcg_112a": "$ltcg_112a",
                  "ltcg_112": "$ltcg_112",
                  "regime": "$regime",
                  "band": "$band",
                  "resident": "$resident",
