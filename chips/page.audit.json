        "interest_income": "Interest income",
        "opening_stock": "Opening stock",
        "other_expenses": "Other expenses",
        "other_income": "Other income",
        "pf": "PF / ESI contribution",
        "power": "Power",
        "professional": "Professional fees paid",
        "professional_receipts": "Professional receipts",
        "purchases": "Purchases",
        "rent": "Rent",
        "rent_income": "Rent income",
        "repairs_building": "Repairs building",
        "repairs_machinery": "Repairs machinery",
        "salaries": "Salaries",
        "sales": "Sales",
        "services": "Services",
        "staff_welfare": "Staff welfare",
        "tax_provision_pl": "Income tax (P&L)",
        "telephone": "Telephone",
        "travel": "Travel"
      },
      "label": "items"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "need_tone": "$need_tone",
      "need_icon": "$need_icon",
      "flag_tone": "$flag_tone",
      "gst_tone": "$gst_tone",
      "gst_months": "$gst_months",
      "as_tone": "$as_tone",
      "llp_tone": "$llp_tone",
      "risk_tone": "$risk_tone",
      "state_tone": "$state_tone",
      "point_tone": "$point_tone",
      "point_order": "$point_order",
      "point_next": "$point_next",
      "point_button": "$point_button",
      "share_tables": "$share_tables",
      "money_locale": "$money_locale",
      "items": "$items"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-10-04: colours and icons on the Tax audit screen.",
