{
  "chip_id": "page.audit",
  "kind": "accessor",
  "set": "page",
  "label": "Tax audit look",
  "aliases": [
    "tax audit look"
  ],
  "params": [
    {
      "name": "need_tone",
      "type": "json",
      "default": {
        "yes": "--warn",
        "no": "--ok",
        "unknown": "--muted"
      },
      "label": "need tone"
    },
    {
      "name": "need_icon",
      "type": "json",
      "default": {
        "yes": "alert",
        "no": "check",
        "unknown": "info"
      },
      "label": "need icon"
    },
    {
      "name": "flag_tone",
      "type": "json",
      "default": {
        "new": "--brand",
        "gone": "--muted",
        "spike": "--bad",
        "drop": "--warn",
        "outpaced": "--bad"
      },
      "label": "flag tone"
    },
    {
      "name": "state_tone",
      "type": "json",
