{
  "chip_id": "page.audit",
  "kind": "accessor",
  "set": "page",
  "label": "Tax audit look",
  "aliases": [
    "tax audit look"
  ],
  "params": [
    {
      "name": "need_tone",
      "type": "json",
      "default": {
        "yes": "--warn",
        "no": "--ok",
        "unknown": "--muted"
      },
      "label": "need tone"
    },
    {
      "name": "need_icon",
      "type": "json",
      "default": {
        "yes": "alert",
        "no": "check",
        "unknown": "info"
      },
      "label": "need icon"
    },
    {
      "name": "flag_tone",
      "type": "json",
      "default": {
        "new": "--brand",
        "gone": "--muted",
        "spike": "--bad",
        "drop": "--warn",
        "outpaced": "--bad",
        "above_pattern": "--bad",
        "below_pattern": "--warn"
      },
      "label": "flag tone"
    },
    {
      "name": "gst_tone",
      "type": "json",
      "default": {
        "match": "--ok",
        "more_in_books": "--bad",
        "more_in_gst": "--warn",
        "more_in_r1": "--bad",
        "more_in_3b": "--warn",
        "differs": "--bad",
        "no_3b": "--muted",
        "no_r1": "--muted",
        "none": "--muted"
      },
      "label": "gst tone"
    },
    {
      "name": "gst_months",
      "type": "json",
      "default": [
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
        "Jan",
        "Feb",
        "Mar"
      ],
      "label": "gst months"
    },
    {
      "name": "as_tone",
      "type": "json",
      "default": {
        "full": "--brand",
        "relaxed": "--warn",
        "no": "--muted"
      },
      "label": "as tone"
    },
    {
      "name": "llp_tone",
      "type": "json",
      "default": {
        "yes": "--warn",
        "no": "--ok"
      },
      "label": "llp tone"
    },
    {
      "name": "risk_tone",
      "type": "json",
      "default": {
        "high": "--bad",
        "medium": "--warn",
        "low": "--muted"
      },
      "label": "risk tone"
    },
    {
      "name": "state_tone",
      "type": "json",
      "default": {
        "todo": "--muted",
        "done": "--ok",
        "na": "--muted",
        "issue": "--bad"
      },
      "label": "state tone"
    },
    {
      "name": "point_tone",
      "type": "json",
      "default": {
        "open": "--warn",
        "cleared": "--ok"
      },
      "label": "point tone"
    },
    {
      "name": "point_order",
      "type": "json",
      "default": [
        "open",
        "cleared"
      ],
      "label": "point order"
    },
    {
      "name": "point_next",
      "type": "json",
      "default": {
        "open": "cleared",
        "cleared": "open"
      },
      "label": "point next"
    },
    {
      "name": "point_button",
      "type": "json",
      "default": {
        "open": "clear",
        "cleared": "reopen"
      },
      "label": "point button"
    },
    {
      "name": "share_tables",
      "type": "json",
      "default": [
        "PL"
      ],
      "label": "share tables"
    },
    {
      "name": "money_locale",
      "type": "text",
      "default": "en-IN",
      "label": "money locale"
    },
    {
      "name": "items",
      "type": "json",
      "default": {
        "acc_depreciation": "Accumulated depreciation",
        "advances_given": "Advances given",
        "advances_received": "Advances received",
        "bank": "Bank",
        "capital": "Capital",
        "cash": "Cash",
        "creditors": "Creditors",
        "cwip": "Capital work in progress",
        "debtors": "Debtors",
        "deposits": "Deposits",
