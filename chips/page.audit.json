        "investments": "Investments",
        "provisions": "Provisions",
        "reserves": "Reserves",
        "secured_bank": "Secured loans from banks",
        "stock": "Stock",
        "tax_balances": "Tax paid / TDS receivable",
        "tax_provision": "Provision for tax",
        "unsecured_other": "Unsecured loans",
        "advertisement": "Advertisement",
        "audit_fee": "Audit fee",
        "bad_debts": "Bad debts",
        "bonus": "Bonus",
        "carriage": "Carriage",
        "closing_stock": "Closing stock",
        "commission": "Commission",
        "commission_income": "Commission income",
        "conveyance": "Conveyance",
        "depreciation": "Depreciation",
        "dividend": "Dividend",
        "donation": "Donation",
        "entertainment": "Entertainment",
        "freight": "Freight",
        "gift": "Gift",
        "insurance": "Insurance",
