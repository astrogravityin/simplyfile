        "loss_cf": false,
        "parents_senior": false,
        "disability": "",
        "metro": false,
        "ai_ok": false,
        "father": "",
        "employer_category": "",
        "state": "",
        "filed_on": "",
        "ack_no": "",
        "karta_name": "",
        "karta_pan": "",
