    },
    {
      "name": "losses_max",
      "type": "number",
      "default": 40,
      "label": "losses brought forward typed, at most"
    },
    {
      "name": "gifts_max",
      "type": "number",
      "default": 40,
      "label": "gifts typed, at most"
    },
    {
      "name": "from_prev",
      "type": "json",
      "default": {
        "cfl": "ScheduleCFL",
        "detail": "CarryFwdLossDetail",
        "summary": "LossSummaryDetail",
        "filed": "DateOfFiling",
        "adjusted": "AdjTotBFLossInBFLA",
        "current": "CurrentAYloss",
        "fields": {
          "stcl": "TotalSTCGPTILossCF",
          "ltcl": "TotalLTCGPTILossCF",
          "hp": "TotalHPPTILossCF"
        },
        "date": [
          "Verification.Date",
          "PartA_GEN1.FilingStatus.OrigRetFiledDate"
        ]
      },
      "label": "last year's filed return: where its Schedule CFL keeps each year's loss, what it set off, its own loss, and the day it was filed"
    },
    {
      "name": "biz_kinds",
      "type": "json",
      "default": [
        "",
        "44ADA",
        "44AD",
        "44AE",
        "business",
        "profession"
      ],
      "label": "business kinds a person may pick"
    },
    {
      "name": "pl_as",
      "type": "json",
      "default": {
        "business": "44AD",
        "profession": "44ADA"
      },
      "label": "own-P&L kinds: the presumptive section that would have applied (limits, s.44AB(e))"
    },
    {
      "name": "pl_codes",
      "type": "json",
      "default": {
        "business": [
          "ITR-3",
          "PartA_GEN2.NatOfBus.NatureOfBusiness",
          "Code"
        ],
        "profession": [
          "ITR-3",
          "PartA_GEN2.NatOfBus.NatureOfBusiness",
          "Code"
        ]
      },
      "label": "own-P&L kinds: where the department's ITR-3 schema lists the nature-of-business codes [form, path, field]"
    },
    {
      "name": "foreign_max",
      "type": "number",
      "default": 40,
      "label": "foreign income rows typed, at most"
    },
    {
      "name": "fa_max",
      "type": "number",
      "default": 60,
      "label": "foreign assets typed, at most"
    },
    {
      "name": "club_max",
      "type": "number",
      "default": 20,
      "label": "clubbed income rows typed, at most"
    },
    {
      "name": "arrears_max",
      "type": "number",
      "default": 15,
      "label": "years of salary arrears typed (Form 10E), at most"
    },
    {
      "name": "countries_from",
      "type": "text",
      "default": "CountryCodeExcludingIndia",
      "label": "the department's country list: the ITR-2 schema definition that holds it (code: name)"
    },
    {
      "name": "tan_kinds",
      "type": "json",
      "default": [
        "form16"
      ],
      "label": "kinds one per employer: a second one with the same TAN is asked about (replace / keep both)"
    },
    {
      "name": "gst_max",
      "type": "number",
      "default": 20,
      "label": "GSTINs typed, at most"
    },
    {
      "name": "itr3_cfl",
      "type": "json",
      "default": {
        "form": "ITR-3",
        "block_ay": "AY\\s*(\\d{4}-\\d{2})",
        "other_fields": {
          "bl": "BusLossOthThanSpecLossCF",
          "spec": "LossFrmSpecBusCF",
          "specified": "LossFrmSpecifiedBusCF",
          "horse": "OthSrcLossRaceHorseCF"
        }
      },
      "label": "last year's ITR-3: its Schedule CFL blocks are named by their AY (LossCFCurrentAssmntYear2025 ...) - which AY each is, read from the ITR-3 schema's own block descriptions; the business / speculation / specified-business / race-horse losses it carries"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "exts": "$exts",
      "max_mb": "$max_mb",
      "houses_max": "$houses_max",
      "late_kinds": "$late_kinds",
