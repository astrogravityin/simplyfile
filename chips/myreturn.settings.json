      "label": "answer defaults"
    },
    {
      "name": "steps",
      "type": "json",
      "default": [
        "gather",
        "check",
        "choose",
        "review",
        "file"
      ],
      "label": "steps"
    },
    {
      "name": "kinds",
      "type": "json",
      "default": [
        {
          "id": "prefill",
          "icon": "download",
          "need": true
        },
        {
          "id": "ais",
          "icon": "eye",
          "need": true
        },
        {
          "id": "form16",
          "icon": "doc",
          "need": false
        },
        {
          "id": "26as",
          "icon": "check",
          "need": false
        }
      ],
      "label": "kinds"
    },
    {
      "name": "who",
      "type": "json",
      "default": {
        "block": "PersonalInfo",
        "pan": "PAN",
        "dob": "DOB",
        "name": [
          "AssesseeName.FirstName",
          "AssesseeName.MiddleName",
          "AssesseeName.SurNameOrOrgName"
        ]
      },
      "label": "who"
    },
    {
      "name": "paid_minor",
      "type": "json",
      "default": {
        "advance": "100",
        "self": "300"
      },
      "label": "challan minor head of a typed payment"
    },
    {
      "name": "one_per_kind",
      "type": "json",
      "default": [
        "prefill",
        "ais",
        "26as",
        "filed"
      ],
      "label": "kinds a return holds one of - another asks: replace or keep both"
    },
    {
      "name": "business_sections",
      "type": "json",
      "default": [
        "194J",
        "194JA",
        "194JB",
        "194C",
        "194H",
        "194O",
        "194M"
      ],
      "label": "business sections"
    },
    {
      "name": "from_filed",
      "type": "json",
      "default": {
        "date": [
          "Verification.Date",
          "PartA_GEN1.FilingStatus.OrigRetFiledDate"
        ],
        "challans": "ScheduleIT.TaxPayment",
        "bsr": "BSRCode",
        "on": "DateDep",
        "no": "SrlNoOfChaln",
        "amount": "Amt",
        "ack_digits": 15
      },
      "label": "where a filed return keeps its date and challans"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "exts": "$exts",
      "max_mb": "$max_mb",
      "houses_max": "$houses_max",
      "late_kinds": "$late_kinds",
      "old_regime_kinds": "$old_regime_kinds",
      "questions": "$questions",
      "answer_defaults": "$answer_defaults",
      "steps": "$steps",
      "kinds": "$kinds",
      "who": "$who",
      "paid_minor": "$paid_minor",
      "one_per_kind": "$one_per_kind",
      "business_sections": "$business_sections",
      "from_filed": "$from_filed"
    }
  },
  "returns": "record",
  "version": 11,
  "status": "published",
  "description_nl": "2026-10-06: what may be dropped in (types, size), how many houses, which filing kinds pay the late fee, the yes/no questions a person answers and their defaults, the five steps, and the documents asked for (need = the journey nudges for it). 2026-10-06: who - where a filed return (JSON) names the person, so a return can start from documents and the client is made from them. 2026-10-06: paid_minor - a payment typed on Check as its challan minor head (100 advance, 300 self-assessment). 2026-10-06: one_per_kind - a second AIS / 26AS / pre-filled JSON / filed return asks first: replace it (the old kept in History) or keep both. 2026-10-06: business_sections - TDS sections whose amount paid is a receipt of a business or profession (shown beside the receipts typed). 2026-10-06: .xls (an old Excel bank statement). 2026-10-06: from_filed - this year's filed return gives the filing date (Verification Date), the acknowledgement (its file name) and each challan (Schedule IT). 2026-10-06: karta_name / karta_pan / formed_on - an HUF's Karta signs its return; its date of formation stands where a person's birth date does.",
