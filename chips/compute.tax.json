{
  "chip_id": "compute.tax",
  "kind": "accessor",
  "set": "compute",
  "label": "Compute: tax on total income (slabs, rebate, surcharge with marginal relief, cess)",
  "aliases": [
    "compute: tax on total income (slabs, reb"
  ],
  "params": [
    {
      "name": "income",
      "type": "number",
      "default": 0,
      "label": "total income"
    },
    {
      "name": "status",
      "type": "text",
      "default": "huf",
      "label": "status"
    },
    {
      "name": "slabs",
      "type": "json",
      "default": [
        {
          "upto": 400000,
          "rate": 0
        },
        {
          "upto": 800000,
          "rate": 5
        },
        {
          "upto": 1200000,
          "rate": 10
        },
        {
          "upto": 1600000,
          "rate": 15
        },
        {
          "upto": 2000000,
          "rate": 20
        },
        {
          "upto": 2400000,
          "rate": 25
        },
        {
          "upto": null,
          "rate": 30
        }
      ],
      "label": "slabs"
    },
    {
      "name": "steps",
      "type": "json",
      "default": [
        {
          "above": 5000000,
          "rate": 10
        },
        {
          "above": 10000000,
          "rate": 15
        },
        {
          "above": 20000000,
          "rate": 25
        }
      ],
      "label": "surcharge steps"
    },
    {
      "name": "cess_pct",
      "type": "number",
      "default": 4,
      "label": "cess %"
    },
    {
      "name": "round_to",
      "type": "number",
      "default": 10,
      "label": "round tax to"
    },
    {
      "name": "rebate_statuses",
      "type": "json",
      "default": [
        "individual"
      ],
      "label": "who gets the 87A rebate"
    },
    {
      "name": "rebate_upto",
      "type": "number",
      "default": 1200000,
      "label": "rebate up to income"
    },
    {
      "name": "rebate_most",
      "type": "number",
      "default": 60000,
      "label": "rebate at most"
    },
    {
      "name": "resident",
      "type": "boolean",
      "default": true,
      "label": "resident in India (87A is for residents only)"
    }
