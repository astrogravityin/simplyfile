{
  "chip_id": "narrator.settings",
  "kind": "accessor",
  "set": "narrator",
  "label": "Limits the Video Narrator works to",
  "aliases": [
    "video types",
    "narrator limits"
  ],
  "params": [
    {
      "name": "video_extensions",
      "type": "list",
      "default": [
        ".mp4",
        ".mov",
        ".webm",
        ".mkv",
        ".m4v"
      ]
    },
    {
      "name": "line_text_max",
      "type": "number",
      "default": 900
    },
    {
      "name": "chapter_max",
      "type": "number",
      "default": 80
    },
    {
      "name": "voice_max",
      "type": "number",
      "default": 80
    },
    {
      "name": "overlap_tolerance_s",
      "type": "number",
      "default": 0.01
    },
    {
      "name": "min_clipped_line_s",
      "type": "number",
      "default": 0.3
    },
    {
      "name": "manual_context_max",
      "type": "number",
      "default": 2500
    },
    {
      "name": "processing_polls",
      "type": "number",
      "default": 120
    },
    {
      "name": "processing_poll_s",
      "type": "number",
      "default": 3
    },
    {
      "name": "key_check_prompt",
      "type": "text",
      "default": "Say OK."
    },
    {
      "name": "run_title_max",
      "type": "number",
      "default": 60
    },
    {
      "name": "late_warning_s",
      "type": "number",
      "default": 0.25
    },
    {
      "name": "overrun_warning_s",
      "type": "number",
      "default": 0.3
    },
    {
      "name": "outputs",
      "type": "record",
      "default": {
        "mp4": {
          "file": "narrated.mp4",
          "type": "video/mp4",
          "tail": ""
        },
        "partial": {
          "file": "partial.mp4",
          "type": "video/mp4",
          "tail": " - unfinished"
        },
        "srt": {
          "file": "narrated.srt",
          "type": "application/x-subrip",
          "tail": " - subtitles"
        },
        "description": {
          "file": "description.txt",
          "type": "text/plain; charset=utf-8",
          "tail": " - chapters"
        }
      }
    },
    {
      "name": "mp4_suffixes",
      "type": "list",
      "default": [
        ".mp4",
        ".m4v"
      ]
    },
    {
      "name": "processing_progress_from",
      "type": "number",
      "default": 35
    },
    {
      "name": "processing_progress_to",
      "type": "number",
      "default": 55
    },
    {
      "name": "cover_at_seconds",
      "type": "number",
      "default": 2.0,
      "label": "A Video's Home cover: the frame this many seconds in (half-way in a shorter video)"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "video_extensions": "$video_extensions",
      "line_text_max": "$line_text_max",
      "chapter_max": "$chapter_max",
      "voice_max": "$voice_max",
      "overlap_tolerance_s": "$overlap_tolerance_s",
      "min_clipped_line_s": "$min_clipped_line_s",
      "manual_context_max": "$manual_context_max",
      "processing_polls": "$processing_polls",
      "processing_poll_s": "$processing_poll_s",
      "key_check_prompt": "$key_check_prompt",
      "run_title_max": "$run_title_max",
      "late_warning_s": "$late_warning_s",
      "overrun_warning_s": "$overrun_warning_s",
      "outputs": "$outputs",
      "mp4_suffixes": "$mp4_suffixes",
      "processing_progress_from": "$processing_progress_from",
      "processing_progress_to": "$processing_progress_to",
      "cover_at_seconds": "$cover_at_seconds"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "video_extensions: file types accepted as a recording. line_text_max, chapter_max, voice_max: characters kept per script line. overlap_tolerance_s: how far one line may run into the next before a save is refused. min_clipped_line_s: the shortest a drafted line is clipped to when the model overlaps it. manual_context_max: characters of a manual page given to the model. processing_polls x processing_poll_s: how long Draft with AI waits for Google to process the upload. key_check_prompt: the four words Save and test sends. run_title_max: characters of a title in a run's name. late_warning_s / overrun_warning_s: when Generate warns that a line starts late or runs into the next one.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "video_extensions": [
          ".mp4",
          ".mov",
          ".webm",
          ".mkv",
          ".m4v"
        ],
        "line_text_max": 900,
        "chapter_max": 80,
        "voice_max": 80,
        "overlap_tolerance_s": 0.01,
        "min_clipped_line_s": 0.3,
        "manual_context_max": 2500,
        "processing_polls": 120,
        "processing_poll_s": 3,
        "key_check_prompt": "Say OK.",
        "run_title_max": 60,
        "late_warning_s": 0.25,
        "overrun_warning_s": 0.3,
        "outputs": {
          "mp4": {
            "file": "narrated.mp4",
            "type": "video/mp4",
            "tail": ""
          },
          "partial": {
            "file": "partial.mp4",
            "type": "video/mp4",
            "tail": " - unfinished"
          },
          "srt": {
            "file": "narrated.srt",
            "type": "application/x-subrip",
            "tail": " - subtitles"
          },
          "description": {
            "file": "description.txt",
            "type": "text/plain; charset=utf-8",
            "tail": " - chapters"
          }
        },
        "mp4_suffixes": [
          ".mp4",
          ".m4v"
        ],
        "processing_progress_from": 35,
        "processing_progress_to": 55,
        "cover_at_seconds": 2.0
      }
    }
  ],
  "weight_basis": "Portal operating limits, no scoring. The knobs ARE the policy — edit them here, never in Python."
}
