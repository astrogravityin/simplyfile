{
  "chip_id": "ui.guideme",
  "kind": "accessor",
  "set": "ui",
  "label": "Every word on the Guide Me Builder screen",
  "aliases": [
    "guide me builder words"
  ],
  "params": [
    {
      "name": "title",
      "type": "text",
      "default": "Guide Me Builder"
    },
    {
      "name": "lede",
      "type": "text",
      "default": "Bring a Guide Me script, check it, watch it as the live tour, and export the complete code for any page of any site."
    },
    {
      "name": "import_title",
      "type": "text",
      "default": "Import a script"
    },
    {
      "name": "import_line",
      "type": "long",
      "default": "Drop or choose a script file, or paste the script below. Create Guide Me checks every rule and lists anything to fix; nothing is saved until the script is clean."
    },
    {
      "name": "drop_title",
      "type": "text",
      "default": "Choose a script file"
    },
    {
      "name": "drop_hint",
      "type": "text",
      "default": "A Guide Me script (.json)"
    },
    {
      "name": "paste_label",
      "type": "text",
      "default": "Or paste the script"
    },
    {
      "name": "paste_ph",
      "type": "text",
      "default": "Paste the whole script here, from its first line to its last"
    },
    {
      "name": "create",
      "type": "text",
      "default": "Create Guide Me"
    },
    {
      "name": "need_script",
      "type": "text",
      "default": "Choose a script file or paste one first."
    },
    {
      "name": "file_unread",
      "type": "text",
      "default": "That file could not be read. Choose it again, or paste its text."
    },
    {
      "name": "problems_title",
      "type": "text",
      "default": "Nothing was saved. Fix these, then press the button again:"
    },
    {
      "name": "list_title",
      "type": "text",
      "default": "Your Guide Me builds"
    },
    {
      "name": "search_ph",
      "type": "text",
      "default": "Search title, site or page"
    },
    {
      "name": "count",
      "type": "text",
      "default": "{n} {n:build|builds}"
    },
    {
      "name": "none_title",
      "type": "text",
      "default": "No Guide Me builds yet"
    },
    {
      "name": "none_body",
      "type": "text",
      "default": "Import a script above to create your first one."
    },
    {
      "name": "no_match",
      "type": "text",
      "default": "Nothing matches that search."
    },
    {
      "name": "col_title",
      "type": "text",
      "default": "Title"
    },
    {
      "name": "col_portal",
      "type": "text",
      "default": "Site"
