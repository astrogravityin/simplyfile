      "name": "col_updated",
      "type": "text",
      "default": "Updated"
    },
    {
      "name": "open",
      "type": "text",
      "default": "Open"
    },
    {
      "name": "export",
      "type": "text",
      "default": "Export"
    },
    {
      "name": "delete",
      "type": "text",
      "default": "Delete"
    },
    {
      "name": "prev",
      "type": "text",
      "default": "Previous"
    },
    {
      "name": "next",
      "type": "text",
      "default": "Next"
    },
    {
      "name": "page",
      "type": "text",
      "default": "Page {page} of {pages}"
