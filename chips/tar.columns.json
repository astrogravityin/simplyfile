{
  "chip_id": "tar.columns",
  "kind": "accessor",
  "set": "tar",
  "label": "3CD JSON: which column of a clause row is which figure",
  "aliases": [
    "3cd json: which column of a clause row i"
  ],
  "params": [
    {
      "name": "clauses",
      "type": "json",
      "default": {
        "18": {
          "opening": "(?i)wdv.*(01|opening|1st)|opening",
          "additions": "(?i)addition",
          "depreciation": "(?i)^depreciation|depreciation allowable",
          "closing": "(?i)wdv.*(31|closing)|closing",
          "rate": "(?i)rate"
        },
        "31(a)": {
          "accepted": "(?i)accepted|amount",
          "repaid": "(?i)repaid|repayment",
          "max": "(?i)maxim|max\\b"
        },
        "31(c)": {
          "accepted": "(?i)accepted",
          "repaid": "(?i)repaid|repayment|amount",
          "max": "(?i)maxim|max\\b"
        },
        "23": {
          "amount": "(?i)amount|paid"
        },
        "31(b)": {
          "accepted": "(?i)accepted|amount",
          "max": "(?i)maxim|max\\b"
        }
      },
      "label": "clauses"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "clauses": "$clauses"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "A 3CD schedule names its columns; each figure of a clause is the first column whose title fits. A row's PAN is found in its words (tar.settings pan_pattern); its payment mode in its words (tar.codes modes). 2026-10-05 owner (3CD from a party master): 31(a)/31(b) also read the maximum outstanding column. 2026-10-05 owner (\"yes\" to the form's own numbering): repayments are clause 31(c), as Form 3CD numbers them; 31(b) is a specified sum taken (s.269SS) - Form3cdSec269SSDtls.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "clauses": {
          "18": {
            "opening": "(?i)wdv.*(01|opening|1st)|opening",
            "additions": "(?i)addition",
            "depreciation": "(?i)^depreciation|depreciation allowable",
            "closing": "(?i)wdv.*(31|closing)|closing",
            "rate": "(?i)rate"
          },
          "31(a)": {
            "accepted": "(?i)accepted|amount",
            "repaid": "(?i)repaid|repayment",
            "max": "(?i)maxim|max\\b"
          },
          "31(c)": {
            "accepted": "(?i)accepted",
            "repaid": "(?i)repaid|repayment|amount",
            "max": "(?i)maxim|max\\b"
          },
          "23": {
            "amount": "(?i)amount|paid"
          },
          "31(b)": {
            "accepted": "(?i)accepted|amount",
            "max": "(?i)maxim|max\\b"
          }
        }
      }
    }
  ]
