{
  "chip_id": "myreturn.year_tax_s2",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: the tax of an earlier year, stage 2 of 5 (rebate, surcharge_rate)",
  "aliases": [],
  "params": [
    {
      "name": "fy",
      "type": "number",
      "default": 2019,
      "label": "the financial year (its first year)"
    },
    {
      "name": "regime",
      "type": "text",
      "default": "old",
      "label": "old / new"
    },
    {
      "name": "band",
      "type": "text",
      "default": "below60",
      "label": "below60 / 60to80 / 80plus that year"
    },
    {
      "name": "resident",
      "type": "boolean",
      "default": true,
      "label": "resident that year (the unused basic exemption against special-rate gains, 87A)"
    },
    {
      "name": "normal",
      "type": "number",
      "default": 0,
      "label": "income at the slab rates"
    },
    {
      "name": "stcg_111a",
      "type": "number",
      "default": 0,
      "label": "short-term gains taxed u/s 111A"
    },
    {
      "name": "ltcg_112a",
      "type": "number",
      "default": 0,
      "label": "long-term gains u/s 112A (before its exemption)"
    },
    {
      "name": "ltcg_112",
      "type": "number",
      "default": 0,
      "label": "long-term gains u/s 112 (after indexation when that year's 112 had it)"
    },
    {
      "name": "special",
      "type": "number",
      "default": 0,
      "label": "income at 30%: 115BB / 115BBJ / 115BBH"
    },
    {
      "name": "early",
      "type": "boolean",
      "default": false,
      "label": "FY 2024-25: the gains were on transfers before 23 July 2024"
    },
    {
      "name": "b",
      "type": "json",
      "default": {},
      "label": "what stage 1 worked out"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "known": {
        "vop": "get",
        "value": "$b",
        "path": "known"
      },
      "total": {
        "vop": "get",
        "value": "$b",
        "path": "total"
      },
      "on_normal": {
        "vop": "get",
        "value": "$b",
        "path": "on_normal"
      },
      "_raw_on_normal": {
        "vop": "get",
        "value": "$b",
        "path": "_raw_on_normal"
      },
      "on_111a": {
        "vop": "get",
        "value": "$b",
        "path": "on_111a"
      },
      "_raw_on_111a": {
        "vop": "get",
        "value": "$b",
        "path": "_raw_on_111a"
      },
      "on_112a": {
        "vop": "get",
        "value": "$b",
        "path": "on_112a"
      },
      "_raw_on_112a": {
        "vop": "get",
        "value": "$b",
        "path": "_raw_on_112a"
      },
      "on_112": {
        "vop": "get",
        "value": "$b",
        "path": "on_112"
      },
      "_raw_on_112": {
        "vop": "get",
        "value": "$b",
        "path": "_raw_on_112"
      },
      "on_special": {
        "vop": "get",
        "value": "$b",
        "path": "on_special"
      },
      "_raw_on_special": {
        "vop": "get",
        "value": "$b",
        "path": "_raw_on_special"
      },
      "rebate": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "not",
              "item": {
                "op": "eq",
                "left": "$resident",
                "right": true
              }
            },
            "then": 0
          },
          {
            "when": {
              "op": "le",
              "left": {
                "vop": "get",
                "value": "$b",
                "path": "total"
              },
              "right": {
                "vop": "get",
                "value": {
                  "chip": "myreturn.year_rates",
                  "args": {
                    "fy": "$fy",
                    "regime": "$regime",
                    "early": "$early"
                  }
                },
                "path": "rebate_upto"
              }
            },
            "then": {
              "vop": "smallest",
              "values": [
                {
                  "vop": "choose",
                  "cases": [
                    {
                      "when": {
                        "op": "eq",
                        "left": {
                          "vop": "get",
                          "value": {
                            "chip": "myreturn.year_rates",
                            "args": {
                              "fy": "$fy",
                              "regime": "$regime",
                              "early": "$early"
                            }
                          },
                          "path": "rebate_special"
                        },
                        "right": true
                      },
                      "then": {
                        "vop": "total",
                        "values": [
                          {
                            "vop": "get",
                            "value": "$b",
                            "path": "on_normal"
                          },
                          {
                            "vop": "get",
                            "value": "$b",
                            "path": "on_111a"
                          },
                          {
                            "vop": "get",
                            "value": "$b",
                            "path": "on_112"
                          },
                          {
                            "vop": "get",
                            "value": "$b",
                            "path": "on_special"
                          }
                        ]
                      }
                    }
                  ],
                  "else": {
                    "vop": "get",
                    "value": "$b",
                    "path": "on_normal"
                  }
                },
                {
                  "vop": "get",
                  "value": {
                    "chip": "myreturn.year_rates",
                    "args": {
                      "fy": "$fy",
                      "regime": "$regime",
                      "early": "$early"
                    }
                  },
                  "path": "rebate_most"
                }
              ]
            }
          },
          {
            "when": {
              "op": "eq",
              "left": {
                "vop": "get",
                "value": {
                  "chip": "myreturn.year_rates",
                  "args": {
                    "fy": "$fy",
                    "regime": "$regime",
                    "early": "$early"
                  }
                },
                "path": "marginal"
              },
              "right": true
            },
            "then": {
              "vop": "largest",
              "values": [
                0,
                {
                  "vop": "sub",
                  "a": {
                    "vop": "choose",
                    "cases": [
                      {
                        "when": {
                          "op": "eq",
                          "left": {
                            "vop": "get",
                            "value": {
                              "chip": "myreturn.year_rates",
                              "args": {
                                "fy": "$fy",
                                "regime": "$regime",
                                "early": "$early"
                              }
                            },
                            "path": "rebate_special"
                          },
                          "right": true
                        },
                        "then": {
                          "vop": "total",
                          "values": [
                            {
                              "vop": "get",
                              "value": "$b",
                              "path": "on_normal"
                            },
                            {
                              "vop": "get",
                              "value": "$b",
                              "path": "on_111a"
                            },
                            {
                              "vop": "get",
                              "value": "$b",
                              "path": "on_112"
                            },
                            {
                              "vop": "get",
                              "value": "$b",
                              "path": "on_special"
                            }
                          ]
                        }
                      }
                    ],
                    "else": {
                      "vop": "get",
                      "value": "$b",
                      "path": "on_normal"
                    }
                  },
                  "b": {
                    "vop": "sub",
                    "a": {
                      "vop": "get",
                      "value": "$b",
                      "path": "total"
                    },
                    "b": {
                      "vop": "get",
                      "value": {
                        "chip": "myreturn.year_rates",
                        "args": {
                          "fy": "$fy",
                          "regime": "$regime",
                          "early": "$early"
                        }
                      },
                      "path": "rebate_upto"
                    }
                  }
                }
              ]
            }
          }
        ],
        "else": 0
      },
      "surcharge_rate": {
        "vop": "coalesce",
        "values": [
          {
            "vop": "step_rate",
            "amount": {
              "vop": "get",
              "value": "$b",
              "path": "total"
            },
            "steps": {
              "vop": "get",
              "value": {
                "chip": "myreturn.year_rates",
                "args": {
                  "fy": "$fy",
                  "regime": "$regime",
                  "early": "$early"
                }
              },
              "path": "surcharge"
            }
          },
          0
        ]
      }
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-10-10: part of chip myreturn.year_tax, split so that no field holds a copy of another (see tools/slim_myreturn_tax.py). Stage 2 works out rebate, surcharge_rate from its knobs and what stage 1 worked out (b); the _raw_ fields are the unrounded values the next stages use.",
  "test_cases": [
    {
      "args": {
        "b": {
          "known": true,
          "total": 0.0,
          "on_normal": 0,
          "_raw_on_normal": 0,
          "on_111a": 0,
          "_raw_on_111a": 0,
          "on_112a": 0,
          "_raw_on_112a": 0,
          "on_112": 0,
          "_raw_on_112": 0,
          "on_special": 0,
          "_raw_on_special": 0
        }
      },
      "expect_value": {
        "known": true,
        "total": 0.0,
        "on_normal": 0,
        "_raw_on_normal": 0,
        "on_111a": 0,
        "_raw_on_111a": 0,
        "on_112a": 0,
        "_raw_on_112a": 0,
        "on_112": 0,
        "_raw_on_112": 0,
        "on_special": 0,
        "_raw_on_special": 0,
        "rebate": 0,
        "surcharge_rate": 0
      }
    },
    {
      "args": {
        "fy": 2022,
        "normal": 5100000,
        "stcg_111a": 400000,
        "ltcg_112a": 300000,
        "ltcg_112": 200000,
        "special": 100000,
        "regime": "old",
        "b": {
          "known": true,
          "total": 6100000.0,
          "on_normal": 1342500,
          "_raw_on_normal": 1342500,
          "on_111a": 60000,
          "_raw_on_111a": 60000,
          "on_112a": 20000,
          "_raw_on_112a": 20000,
          "on_112": 40000,
          "_raw_on_112": 40000,
          "on_special": 30000,
          "_raw_on_special": 30000
        }
      },
      "expect_value": {
        "known": true,
        "total": 6100000.0,
        "on_normal": 1342500,
        "_raw_on_normal": 1342500,
        "on_111a": 60000,
        "_raw_on_111a": 60000,
        "on_112a": 20000,
        "_raw_on_112a": 20000,
        "on_112": 40000,
        "_raw_on_112": 40000,
        "on_special": 30000,
        "_raw_on_special": 30000,
        "rebate": 0,
        "surcharge_rate": 10
      }
    }
  ]
}
