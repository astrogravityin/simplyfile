{
  "chip_id": "firm.problem",
  "kind": "accessor",
  "set": "firm",
  "label": "Firms: what is wrong with the details, if anything",
  "aliases": [
    "firms: what is wrong with the details, i"
  ],
  "params": [
    {
      "name": "name",
      "type": "text",
      "default": "",
      "label": "name"
    },
    {
      "name": "pan",
      "type": "text",
      "default": "",
      "label": "pan"
    },
    {
      "name": "tan",
      "type": "text",
      "default": "",
      "label": "tan"
    },
    {
      "name": "gstin",
      "type": "text",
      "default": "",
      "label": "gstin"
    },
    {
      "name": "frn",
      "type": "text",
      "default": "",
      "label": "frn"
    },
    {
      "name": "membership_no",
      "type": "text",
      "default": "",
      "label": "membership_no"
    },
    {
      "name": "owner_name",
      "type": "text",
      "default": "",
      "label": "owner_name"
    },
    {
      "name": "aadhaar_last4",
      "type": "text",
      "default": "",
      "label": "aadhaar_last4"
    },
    {
      "name": "phone",
      "type": "text",
      "default": "",
      "label": "phone"
    },
    {
      "name": "email",
      "type": "text",
      "default": "",
      "label": "email"
    },
    {
      "name": "address",
      "type": "text",
      "default": "",
      "label": "address"
    },
    {
      "name": "consent",
      "type": "boolean",
      "default": false,
      "label": "agreed to the terms and the KYC check"
    },
    {
      "name": "required",
      "type": "json",
      "default": [],
      "label": "the fields this kind of account must give (firm.settings kinds)"
    },
    {
      "name": "pan_letters",
      "type": "json",
      "default": [
        "F",
        "P"
      ],
      "label": "allowed 4th letters of the PAN"
    },
    {
      "name": "p_pan",
      "type": "text",
      "default": "[A-Z]{5}[0-9]{4}[A-Z]",
      "label": "pan pattern"
    },
    {
      "name": "p_tan",
      "type": "text",
      "default": "[A-Z]{4}[0-9]{5}[A-Z]",
      "label": "tan pattern"
    },
    {
      "name": "p_gstin",
      "type": "text",
      "default": "[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]Z[0-9A-Z]",
      "label": "gstin pattern"
    },
    {
      "name": "p_frn",
      "type": "text",
      "default": "[0-9]{6}[NSECW]",
      "label": "frn pattern"
    },
    {
      "name": "p_membership_no",
      "type": "text",
      "default": "[0-9]{6}",
      "label": "membership_no pattern"
    },
    {
      "name": "p_aadhaar_last4",
      "type": "text",
      "default": "[0-9]{4}",
      "label": "aadhaar_last4 pattern"
    },
    {
      "name": "p_phone",
      "type": "text",
      "default": "[6-9][0-9]{9}",
      "label": "phone pattern"
    },
    {
      "name": "p_email",
      "type": "text",
      "default": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+",
      "label": "email pattern"
    }
  ],
  "expr": {
    "vop": "choose",
    "cases": [
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "name",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$name"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_name"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "pan",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$pan"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_pan"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "gt",
              "left": {
                "vop": "text_length",
                "text": "$pan"
              },
              "right": 0
            },
            {
              "op": "not",
              "item": {
                "op": "eq",
                "left": {
                  "vop": "matches",
                  "text": "$pan",
                  "pattern": "$p_pan"
                },
                "right": true
              }
            }
          ]
        },
        "then": "bad_pan"
      },
      {
        "when": {
          "op": "not",
          "item": {
            "op": "in_set",
            "value": {
              "vop": "sub_text",
              "text": "$pan",
              "pattern": "^.{3}(.).*$",
              "replacement": "\\1"
            },
            "set": "$pan_letters"
          }
        },
        "then": "pan_letter"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "tan",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$tan"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_tan"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "gt",
              "left": {
                "vop": "text_length",
                "text": "$tan"
              },
              "right": 0
            },
            {
              "op": "not",
              "item": {
                "op": "eq",
                "left": {
                  "vop": "matches",
                  "text": "$tan",
                  "pattern": "$p_tan"
                },
                "right": true
              }
            }
          ]
        },
        "then": "bad_tan"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "gstin",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$gstin"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_gstin"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "gt",
              "left": {
                "vop": "text_length",
                "text": "$gstin"
              },
              "right": 0
            },
            {
              "op": "not",
              "item": {
                "op": "eq",
                "left": {
                  "vop": "matches",
                  "text": "$gstin",
                  "pattern": "$p_gstin"
                },
                "right": true
              }
            }
          ]
        },
        "then": "bad_gstin"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "gt",
              "left": {
                "vop": "text_length",
                "text": "$gstin"
              },
              "right": 0
            },
            {
              "op": "ne",
              "left": {
                "vop": "sub_text",
                "text": "$gstin",
                "pattern": "^..(.{10}).*$",
                "replacement": "\\1"
              },
              "right": "$pan"
            }
          ]
        },
        "then": "gstin_pan"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "frn",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$frn"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_frn"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "gt",
              "left": {
                "vop": "text_length",
                "text": "$frn"
              },
              "right": 0
            },
            {
              "op": "not",
              "item": {
                "op": "eq",
                "left": {
                  "vop": "matches",
                  "text": "$frn",
                  "pattern": "$p_frn"
                },
                "right": true
              }
            }
          ]
        },
        "then": "bad_frn"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "membership_no",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$membership_no"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_membership_no"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "gt",
              "left": {
                "vop": "text_length",
                "text": "$membership_no"
              },
              "right": 0
            },
            {
              "op": "not",
              "item": {
                "op": "eq",
                "left": {
                  "vop": "matches",
                  "text": "$membership_no",
                  "pattern": "$p_membership_no"
                },
                "right": true
              }
            }
          ]
        },
        "then": "bad_membership_no"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "owner_name",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$owner_name"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_owner_name"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "aadhaar_last4",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$aadhaar_last4"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_aadhaar_last4"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "gt",
              "left": {
                "vop": "text_length",
                "text": "$aadhaar_last4"
              },
              "right": 0
            },
            {
              "op": "not",
              "item": {
                "op": "eq",
                "left": {
                  "vop": "matches",
                  "text": "$aadhaar_last4",
                  "pattern": "$p_aadhaar_last4"
                },
                "right": true
              }
            }
          ]
        },
        "then": "bad_aadhaar_last4"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "phone",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$phone"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_phone"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "gt",
              "left": {
                "vop": "text_length",
                "text": "$phone"
              },
              "right": 0
            },
            {
              "op": "not",
              "item": {
                "op": "eq",
                "left": {
                  "vop": "matches",
                  "text": "$phone",
                  "pattern": "$p_phone"
                },
                "right": true
              }
            }
          ]
        },
        "then": "bad_phone"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "email",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$email"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_email"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "gt",
              "left": {
                "vop": "text_length",
                "text": "$email"
              },
              "right": 0
            },
            {
              "op": "not",
              "item": {
                "op": "eq",
                "left": {
                  "vop": "matches",
                  "text": "$email",
                  "pattern": "$p_email"
                },
                "right": true
              }
            }
          ]
        },
        "then": "bad_email"
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "in_set",
              "value": "address",
              "set": "$required"
            },
            {
              "op": "not",
              "item": {
                "op": "gt",
                "left": {
                  "vop": "text_length",
                  "text": "$address"
                },
                "right": 0
              }
            }
          ]
        },
        "then": "need_address"
      },
      {
        "when": {
          "op": "not",
          "item": {
            "op": "eq",
            "left": "$consent",
            "right": true
          }
        },
        "then": "need_consent"
      }
    ],
    "else": ""
  },
  "returns": "text",
  "version": 1,
  "status": "published",
  "description_nl": "The key of the first problem's sentence (ui.firm), or empty: each required field given, PAN / TAN / GSTIN / FRN / membership no. / phone / email of the right shape, the PAN's 4th letter one this kind allows (F firm or LLP, P a proprietor or a person, H a HUF), the GSTIN carrying this PAN, only the last 4 digits of Aadhaar (UIDAI: the full number is never kept), and the consent ticked.",
