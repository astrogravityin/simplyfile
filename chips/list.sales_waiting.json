{
  "chip_id": "list.sales_waiting",
  "kind": "accessor",
  "set": "list",
  "label": "Keys for sale: requests waiting for my answer",
  "aliases": [
    "waiting orders"
  ],
  "params": [
    {
      "name": "search_keys",
      "type": "list",
      "default": [
        "buyer_name",
        "buyer_email",
        "title",
        "note"
      ],
      "label": "search keys"
    },
    {
      "name": "sort_key",
      "type": "text",
      "default": "requested_at",
      "label": "sort key"
    },
    {
      "name": "sort_desc",
      "type": "boolean",
      "default": true,
      "label": "sort desc"
    },
    {
      "name": "sorts",
      "type": "list",
      "default": [
        "buyer_name",
        "amount_usd",
        "requested_at"
      ],
      "label": "sorts"
    },
    {
      "name": "page_size",
      "type": "number",
      "default": 20,
      "label": "page size"
    },
    {
      "name": "max_page_size",
      "type": "number",
      "default": 100,
      "label": "max page size"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "search_keys": "$search_keys",
      "sort_key": "$sort_key",
      "sort_desc": "$sort_desc",
      "sorts": "$sorts",
      "page_size": "$page_size",
      "max_page_size": "$max_page_size"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-09-28. A list that grows with the number of people: searched, sorted and paged on the server by op rows_view (core/lists.py); one page reaches the screen. search_keys = the fields a search looks in; sort_key/sort_desc = the order it opens in; sorts = the other fields a viewer may sort by; page_size rows a page (max_page_size at most).",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "search_keys": [
          "buyer_name",
          "buyer_email",
          "title",
          "note"
        ],
        "sort_key": "requested_at",
        "sort_desc": true,
        "sorts": [
          "buyer_name",
          "amount_usd",
          "requested_at"
        ],
        "page_size": 20,
        "max_page_size": 100
      }
    }
  ]
}
