{
  "chip_id": "ui.changes",
  "kind": "accessor",
  "set": "ui",
  "label": "Change log words",
  "aliases": [
    "change log words"
  ],
  "params": [
    {
      "name": "title",
      "type": "text",
      "default": "History",
      "label": "title"
    },
    {
      "name": "title_client",
      "type": "text",
      "default": "History · {name}",
      "label": "title client"
    },
    {
      "name": "title_firm",
      "type": "text",
      "default": "History · {firm}",
      "label": "title firm"
    },
    {
      "name": "the_firm",
      "type": "text",
      "default": "your {tenant}",
      "label": "the firm"
    },
    {
      "name": "lede",
      "type": "text",
      "default": "Every change is kept: what each field was, what it became, when, and who made it. Replaced or deleted documents are kept too - download any earlier version.",
      "label": "lede"
    },
    {
      "name": "open",
      "type": "text",
      "default": "History",
      "label": "open"
    },
    {
      "name": "all",
      "type": "text",
      "default": "Everything",
      "label": "all"
    },
    {
      "name": "info",
      "type": "text",
      "default": "Details",
      "label": "info"
    },
    {
      "name": "doc",
      "type": "text",
      "default": "Documents",
      "label": "doc"
    },
    {
      "name": "all_years",
      "type": "text",
      "default": "All years",
      "label": "all years"
    },
    {
      "name": "search",
      "type": "text",
      "default": "Search a field, a value or a person",
      "label": "search"
    },
    {
      "name": "count",
      "type": "text",
      "default": "{n} changes",
      "label": "count"
    },
    {
      "name": "count_one",
      "type": "text",
      "default": "1 change",
      "label": "count one"
    },
    {
      "name": "showing",
      "type": "text",
      "default": "Showing {from}-{to} of {total}",
      "label": "showing"
    },
    {
      "name": "prev",
      "type": "text",
      "default": "Newer",
      "label": "prev"
    },
    {
      "name": "next",
      "type": "text",
      "default": "Older",
      "label": "next"
    },
    {
      "name": "today",
      "type": "text",
      "default": "Today",
      "label": "today"
    },
    {
      "name": "yesterday",
      "type": "text",
      "default": "Yesterday",
      "label": "yesterday"
    },
    {
      "name": "ev_info",
      "type": "text",
      "default": "{who} changed {n} fields",
      "label": "ev info"
    },
    {
      "name": "ev_info_one",
      "type": "text",
      "default": "{who} changed 1 field",
      "label": "ev info one"
    },
    {
      "name": "ev_doc_added",
      "type": "text",
      "default": "{who} added a document",
      "label": "ev doc added"
    },
    {
      "name": "ev_doc_replaced",
      "type": "text",
      "default": "{who} replaced a document",
      "label": "ev doc replaced"
    },
    {
      "name": "ev_doc_removed",
      "type": "text",
      "default": "{who} removed a document",
      "label": "ev doc removed"
    },
    {
      "name": "was",
      "type": "text",
      "default": "Was",
      "label": "was"
    },
    {
      "name": "now",
      "type": "text",
      "default": "Now",
      "label": "now"
    },
    {
      "name": "blank",
      "type": "text",
      "default": "(blank)",
      "label": "blank"
    },
    {
      "name": "yes",
      "type": "text",
      "default": "Yes",
      "label": "yes"
    },
    {
      "name": "no",
      "type": "text",
      "default": "No",
      "label": "no"
    },
    {
      "name": "download",
      "type": "text",
      "default": "Download {name}",
      "label": "download"
    },
    {
      "name": "kept",
      "type": "text",
      "default": "Earlier version kept",
      "label": "kept"
    },
    {
      "name": "empty_title",
      "type": "text",
      "default": "Nothing has changed yet",
      "label": "empty title"
    },
    {
      "name": "empty_body",
      "type": "text",
      "default": "From now on every change to {what} is recorded here - what it was, what it became, when and who. Earlier versions of statements and of 26AS, AIS and TIS are kept too.",
      "label": "empty body"
    },
    {
      "name": "empty_client",
      "type": "text",
      "default": "this {client_one}",
      "label": "empty client"
    },
    {
      "name": "empty_firm",
      "type": "text",
      "default": "your {tenant}'s details and people",
      "label": "empty firm"
    },
    {
      "name": "no_match",
      "type": "text",
      "default": "No change matches your search.",
      "label": "no match"
    },
    {
      "name": "fail_title",
      "type": "text",
      "default": "History could not be loaded",
      "label": "fail title"
    },
    {
      "name": "fail_body",
      "type": "text",
      "default": "{why}",
      "label": "fail body"
    },
    {
      "name": "fail_old_server",
      "type": "text",
      "default": "This server has not been restarted since History was added. Please ask the portal admin to deploy again.",
      "label": "fail old server"
    },
    {
      "name": "retry",
      "type": "text",
      "default": "Try again",
      "label": "retry"
    },
    {
      "name": "field_of",
      "type": "text",
      "default": "{field} · {item}",
      "label": "field of"
    },
    {
      "name": "file_name",
      "type": "text",
      "default": "{name} (v{v})",
      "label": "file name"
    },
    {
      "name": "none",
      "type": "text",
      "default": "No changes yet.",
      "label": "none"
    },
    {
      "name": "add_client",
      "type": "text",
      "default": "{Client_one} added",
      "label": "add client"
    },
    {
      "name": "del_client",
      "type": "text",
      "default": "{Client_one} removed",
      "label": "del client"
    },
    {
      "name": "add_firm",
      "type": "text",
      "default": "{Tenant} created",
      "label": "add firm"
    },
    {
      "name": "del_firm",
      "type": "text",
      "default": "{Tenant} removed",
      "label": "del firm"
    },
    {
      "name": "add_team",
      "type": "text",
      "default": "Person added",
      "label": "add team"
    },
    {
      "name": "del_team",
      "type": "text",
      "default": "Person removed",
      "label": "del team"
    },
    {
      "name": "a_client",
      "type": "text",
      "default": "{Client_one} details",
      "label": "a client"
    },
    {
      "name": "a_computation",
      "type": "text",
      "default": "Compute & close",
      "label": "a computation"
    },
    {
      "name": "a_mapping",
      "type": "text",
      "default": "Intake & map",
      "label": "a mapping"
    },
    {
      "name": "a_statements",
      "type": "text",
      "default": "Statements",
      "label": "a statements"
    },
    {
      "name": "a_portal_files",
      "type": "text",
      "default": "26AS / AIS / TIS",
      "label": "a portal files"
    },
    {
      "name": "a_explanations",
      "type": "text",
      "default": "Reconcile",
      "label": "a explanations"
    },
    {
      "name": "a_tax_audit",
      "type": "text",
      "default": "Tax audit",
      "label": "a tax audit"
    },
    {
      "name": "a_firm",
      "type": "text",
      "default": "{Tenant} details",
      "label": "a firm"
    },
    {
      "name": "a_team",
      "type": "text",
      "default": "Team",
      "label": "a team"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "title": "$title",
      "title_client": "$title_client",
      "title_firm": "$title_firm",
      "the_firm": "$the_firm",
      "lede": "$lede",
      "open": "$open",
      "all": "$all",
      "info": "$info",
      "doc": "$doc",
      "all_years": "$all_years",
      "search": "$search",
      "count": "$count",
      "count_one": "$count_one",
      "showing": "$showing",
      "prev": "$prev",
      "next": "$next",
      "today": "$today",
      "yesterday": "$yesterday",
      "ev_info": "$ev_info",
      "ev_info_one": "$ev_info_one",
      "ev_doc_added": "$ev_doc_added",
      "ev_doc_replaced": "$ev_doc_replaced",
      "ev_doc_removed": "$ev_doc_removed",
      "was": "$was",
      "now": "$now",
      "blank": "$blank",
      "yes": "$yes",
      "no": "$no",
      "download": "$download",
      "kept": "$kept",
      "empty_title": "$empty_title",
      "empty_body": "$empty_body",
      "empty_client": "$empty_client",
      "empty_firm": "$empty_firm",
      "no_match": "$no_match",
      "fail_title": "$fail_title",
      "fail_body": "$fail_body",
      "fail_old_server": "$fail_old_server",
      "retry": "$retry",
      "field_of": "$field_of",
      "file_name": "$file_name",
      "none": "$none",
      "add_client": "$add_client",
      "del_client": "$del_client",
      "add_firm": "$add_firm",
      "del_firm": "$del_firm",
      "add_team": "$add_team",
      "del_team": "$del_team",
      "a_client": "$a_client",
      "a_computation": "$a_computation",
      "a_mapping": "$a_mapping",
      "a_statements": "$a_statements",
      "a_portal_files": "$a_portal_files",
      "a_explanations": "$a_explanations",
      "a_tax_audit": "$a_tax_audit",
      "a_firm": "$a_firm",
      "a_team": "$a_team"
    }
  },
  "returns": "record",
  "version": 2,
  "status": "published",
