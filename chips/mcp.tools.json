{
  "chip_id": "mcp.tools",
  "kind": "accessor",
  "set": "mcp",
  "audience": "admin",
  "label": "Connect your AI: the tools this portal offers",
  "aliases": [
    "agent & mcp: the tools"
  ],
  "params": [
    {
      "name": "tools",
      "type": "json",
      "default": [
        {
          "name": "status",
          "title": "Portal status",
          "on": true,
          "kind": "read",
          "function": "tool_status",
          "description": "Is {product} up, which build is running, and the {clients} at each stage of the year.",
          "input_schema": {
            "type": "object",
            "properties": {}
          },
          "calls": [
            {
              "method": "GET",
              "path": "/health"
            },
            {
              "method": "GET",
              "path": "/api/clients/summary"
            }
          ]
        },
        {
          "name": "year_and_stages",
          "title": "Years and stages",
          "on": true,
          "kind": "read",
          "function": "tool_year_and_stages",
          "description": "The assessment year being worked, the years open and the stages a filing moves through.",
          "input_schema": {
            "type": "object",
            "properties": {}
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/clients/settings",
              "keep": [
                "current_ay",
                "years",
                "stages",
                "statuses"
              ]
            }
          ]
        },
        {
          "name": "clients",
          "title": "Find {clients}",
          "on": true,
          "kind": "read",
          "function": "tool_clients",
          "description": "The {clients} list with its forgiving search: name, PAN, stage. Gives each one's id (cid) for the other tools.",
          "input_schema": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "description": "Words to search for (typos are fine)"
              },
              "ay": {
                "type": "string",
                "description": "Assessment year, e.g. 2026-27 (blank = the current one)"
              },
              "view": {
                "type": "string",
                "description": "Blank = active, archived = the Archived tab"
              }
            }
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/lists/clients",
              "query": {
                "q": "{q}",
                "ay": "{ay}",
                "view": "{view}"
              }
            }
          ]
        },
        {
          "name": "client",
          "title": "One {client_one}",
          "on": true,
          "kind": "read",
          "function": "tool_client",
          "description": "One {client_one} by id: details, the years and where each stands.",
          "input_schema": {
            "type": "object",
            "required": [
              "cid"
            ],
            "properties": {
              "cid": {
                "type": "string",
                "description": "The id from clients"
              }
            }
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/clients/{cid}"
            }
          ]
        },
        {
          "name": "intake",
          "title": "Intake & map",
          "on": true,
          "kind": "read",
          "function": "tool_intake",
          "description": "The statements uploaded for one year and how far each is mapped.",
          "input_schema": {
            "type": "object",
            "required": [
              "cid",
              "ay"
            ],
            "properties": {
              "cid": {
                "type": "string",
                "description": "The id from clients"
              },
              "ay": {
                "type": "string",
                "description": "Assessment year, e.g. 2026-27"
              }
            }
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/intake/{cid}/{ay}"
            }
          ]
        },
        {
          "name": "reconcile",
          "title": "Reconcile",
          "on": true,
          "kind": "read",
          "function": "tool_reconcile",
          "description": "The 26AS match for one year: each finding, red or explained.",
          "input_schema": {
            "type": "object",
            "required": [
              "cid",
              "ay"
            ],
            "properties": {
              "cid": {
                "type": "string",
                "description": "The id from clients"
              },
              "ay": {
                "type": "string",
                "description": "Assessment year, e.g. 2026-27"
              }
            }
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/recon/{cid}/{ay}"
            }
          ]
        },
        {
          "name": "reconcile_note",
          "title": "Explain a finding",
          "on": true,
          "kind": "change",
          "function": "tool_reconcile_note",
          "description": "Writes the note that explains one Reconcile finding (its id from reconcile). An explained red finding lets the year move on.",
          "input_schema": {
            "type": "object",
            "required": [
              "cid",
              "ay",
              "fid",
              "note"
            ],
            "properties": {
              "cid": {
                "type": "string",
                "description": "The id from clients"
              },
              "ay": {
                "type": "string",
                "description": "Assessment year"
              },
              "fid": {
                "type": "string",
                "description": "The finding id from reconcile"
              },
              "note": {
                "type": "string",
                "description": "The explanation, in plain words"
              }
            }
          },
          "calls": [
            {
              "method": "PUT",
              "path": "/api/recon/{cid}/{ay}/notes/{fid}",
              "body": {
                "note": "{note}"
              }
            }
          ]
        },
        {
          "name": "compute",
          "title": "Compute & close",
          "on": true,
          "kind": "read",
          "function": "tool_compute",
          "description": "The computation for one year: income, tax, TDS, the balance, and whether it is signed off or filed.",
          "input_schema": {
            "type": "object",
            "required": [
              "cid",
              "ay"
            ],
            "properties": {
              "cid": {
                "type": "string",
                "description": "The id from clients"
              },
              "ay": {
                "type": "string",
                "description": "Assessment year, e.g. 2026-27"
              }
            }
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/compute/{cid}/{ay}"
            }
          ]
        },
        {
          "name": "itr_check",
          "title": "Check the ITR JSON",
          "on": true,
          "kind": "read",
          "function": "tool_itr_check",
          "description": "Makes the ITR JSON for one year and checks it: errors, and the rules and assumptions that made it.",
          "input_schema": {
            "type": "object",
            "required": [
              "cid",
              "ay"
            ],
            "properties": {
              "cid": {
                "type": "string",
                "description": "The id from clients"
              },
              "ay": {
                "type": "string",
                "description": "Assessment year, e.g. 2026-27"
              }
            }
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/compute/{cid}/{ay}/itr-check"
            }
          ]
        },
        {
          "name": "sign_off",
          "title": "Sign off the year",
          "on": true,
          "kind": "change",
          "function": "tool_sign_off",
          "description": "Presses Sign off on Compute & close (refused while a red finding is open).",
          "input_schema": {
            "type": "object",
            "required": [
              "cid",
              "ay"
            ],
            "properties": {
              "cid": {
                "type": "string",
                "description": "The id from clients"
              },
              "ay": {
                "type": "string",
                "description": "Assessment year"
              }
            }
          },
          "calls": [
            {
              "method": "POST",
              "path": "/api/compute/{cid}/{ay}/signoff",
              "body": {
                "on": true
              }
            }
          ]
        },
        {
          "name": "tax_audit",
          "title": "Tax audit",
          "on": true,
          "kind": "read",
          "function": "tool_tax_audit",
          "description": "The tax audit for one year: whether it applies, the checklist and the points raised.",
          "input_schema": {
            "type": "object",
            "required": [
              "cid",
              "ay"
            ],
            "properties": {
              "cid": {
                "type": "string",
                "description": "The id from clients"
              },
              "ay": {
                "type": "string",
                "description": "Assessment year, e.g. 2026-27"
              }
            }
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/audit/{cid}/{ay}"
            }
          ]
        },
        {
          "name": "client_add",
          "title": "Add a {client_one}",
          "on": true,
          "kind": "change",
          "function": "tool_client_add",
          "description": "Adds a {client_one} on Clients & years (use made-up test details for a demo).",
          "input_schema": {
            "type": "object",
            "required": [
              "name",
              "status",
              "pan"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name"
              },
              "status": {
                "type": "string",
                "description": "individual, huf, firm, llp, aop, boi, company ..."
              },
              "pan": {
                "type": "string",
                "description": "PAN (10 characters)"
              }
            }
          },
          "calls": [
            {
              "method": "POST",
              "path": "/api/clients",
              "body": {
                "name": "{name}",
                "status": "{status}",
                "pan": "{pan}"
              },
              "keep": [
                "id",
                "name",
                "status"
              ]
            }
          ]
        },
        {
          "name": "year_open",
          "title": "Open a year",
          "on": true,
          "kind": "change",
          "function": "tool_year_open",
          "description": "Opens an assessment year for one {client_one}, so its work can start.",
          "input_schema": {
            "type": "object",
            "required": [
              "cid",
              "ay"
            ],
            "properties": {
              "cid": {
                "type": "string",
                "description": "The id from clients"
              },
              "ay": {
                "type": "string",
                "description": "Assessment year, e.g. 2026-27"
              }
            }
          },
          "calls": [
            {
              "method": "PUT",
              "path": "/api/clients/{cid}/years/{ay}",
              "body": {}
            }
          ]
        },
        {
          "name": "firms",
          "title": "{Tenant} approvals",
          "on": true,
          "kind": "read",
          "function": "tool_firms",
          "description": "The {tenants} that signed up and where each stands (waiting, approved, sent back).",
          "input_schema": {
            "type": "object",
            "properties": {}
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/approvals"
            }
          ]
        },
        {
          "name": "portal_analytics",
          "title": "Portal analytics",
          "on": true,
          "kind": "read",
          "function": "tool_portal_analytics",
          "description": "The portal's numbers across every {tenant}: work done, stages, activity.",
          "input_schema": {
            "type": "object",
            "properties": {}
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/portalstats"
            }
          ]
        },
        {
          "name": "tax_rules_watch",
          "title": "Tax rules watch",
          "on": true,
          "kind": "read",
          "function": "tool_tax_rules_watch",
          "description": "The tax rules being watched for the year and which changed.",
          "input_schema": {
            "type": "object",
            "properties": {}
          },
          "calls": [
            {
              "method": "GET",
              "path": "/api/taxwatch"
            }
          ]
        },
        {
          "name": "upload_documents",
          "title": "Upload the {client_one}'s documents",
          "on": true,
          "kind": "human",
          "function": "tool_upload_documents",
          "description": "A person uploads statements, 26AS and Form 16 on Intake & map or Reconcile - real papers are never sent by a tool.",
          "input_schema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "file_on_income_tax_site",
          "title": "File on the income-tax site",
          "on": true,
          "kind": "human",
          "function": "tool_file_on_income_tax_site",
          "description": "The CA uploads the ITR JSON on the income-tax e-filing site, then types the acknowledgement number on Compute & close.",
          "input_schema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "firm_decision",
          "title": "Approve or send back a {tenant}",
          "on": true,
          "kind": "human",
          "function": "tool_firm_decision",
          "description": "The portal admin reads the {tenant}'s papers on {Tenant} approvals and decides.",
          "input_schema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "payments",
          "title": "Payments and keys",
          "on": true,
          "kind": "human",
          "function": "tool_payments",
          "description": "Paying, buying or adding a key is always a person, on its own screen.",
          "input_schema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "accounts",
          "title": "Sign-in, passwords and people",
          "on": true,
          "kind": "human",
          "function": "tool_accounts",
          "description": "Signing in, passwords and adding people are a person's, on the portal's own pages.",
          "input_schema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "artifacts_scan",
          "title": "Artifacts for clean-up",
          "on": true,
          "kind": "read",
          "function": "tool_artifacts_scan",
          "description": "Every person (no passwords) and every artifact {product} holds, as facts for ValueStream CC's Clean-up: author, made, last touched, views, who else is on it, a parent or part gone, a copy, a standard missed. Portal Admin only.",
          "input_schema": {
            "type": "object",
            "properties": {
              "people_only": {
                "type": "boolean"
              },
              "user_email": {
                "type": "string",
                "maxLength": 200
              }
            },
            "additionalProperties": false
          }
        },
        {
          "name": "artifacts_delete",
          "title": "Delete artifacts",
          "on": true,
          "kind": "change",
          "function": "tool_artifacts_delete",
          "description": "Deletes the listed artifacts through {product}'s own delete routes, each as its author (an item whose author is gone is kept aside, restorable). Portal Admin only.",
          "input_schema": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array"
              }
            },
            "required": [
              "items"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "person_role",
          "title": "Change a person's role",
          "on": true,
          "kind": "change",
          "function": "tool_person_role",
          "description": "Sets one person's role in {product} (People & access).",
          "input_schema": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string",
                "maxLength": 40
              },
              "role": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "user_id",
              "role"
            ],
            "additionalProperties": false
          },
          "calls": [
            {
              "method": "PUT",
              "path": "/api/core/access/people/{user_id}/role",
              "body": {
                "role": "{role}"
              }
            }
          ]
        },
        {
          "name": "person_block",
          "title": "Block or unblock a person",
          "on": true,
          "kind": "change",
          "function": "tool_person_block",
          "description": "Blocks one person in {product} (no sign-in, every sign-in ends) or lets them in again.",
          "input_schema": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string",
                "maxLength": 40
              },
              "blocked": {
                "type": "boolean"
              }
            },
            "required": [
              "user_id",
              "blocked"
            ],
            "additionalProperties": false
          },
          "calls": [
            {
              "method": "PUT",
              "path": "/api/core/access/people/{user_id}/block",
              "body": {
                "blocked": "{blocked}"
              }
            }
          ]
        },
        {
          "name": "person_remove",
          "title": "Remove a person",
          "on": true,
          "kind": "change",
          "function": "tool_person_remove",
          "description": "Removes one person's account from {product} (People & access).",
          "input_schema": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "user_id"
            ],
            "additionalProperties": false
          },
          "calls": [
            {
              "method": "DELETE",
              "path": "/api/users/{user_id}"
            }
          ]
        }
      ],
      "label": "tools"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "tools": "$tools"
    }
  },
  "returns": "record",
  "version": 3,
  "status": "published",
  "description_nl": "2026-10-24 (Connect your AI, core/mcp.py): what an AI app may do in {product}. Each row: name, title, description, input_schema, function (gated in People & access under Connect your AI), kind read / change / human, and calls = the portal's OWN routes it presses (in-process, as the key's maker); a human row is a person's step, never run - its description says what the person does.",
