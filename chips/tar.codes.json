{
  "chip_id": "tar.codes",
  "kind": "accessor",
  "set": "tar",
  "label": "3CD JSON: our words as the schema's codes",
  "aliases": [
    "3cd json: our words as the schema's code"
  ],
  "params": [
    {
      "name": "statuses",
      "type": "json",
      "default": {
        "individual": 1,
        "huf": 2,
        "firm": 3,
        "llp": 4,
        "aop": 7,
        "boi": 12,
        "company": 5
      },
      "label": "statuses"
    },
    {
      "name": "blocks",
      "type": "json",
      "default": [
        {
          "pattern": "(?i)intangible|patent|goodwill|know-?how|licen",
          "by_rate": {
            "25": "12"
          }
        },
        {
          "pattern": "(?i)building|premises|factory",
          "by_rate": {
            "5": "8",
            "10": "9",
            "40": "47",
            "100": "10"
          }
        },
        {
          "pattern": "(?i)furniture|fittings",
          "by_rate": {
            "10": "11"
          }
        },
        {
          "pattern": "(?i)ship|vessel",
          "by_rate": {
            "20": "13"
          }
        },
        {
          "pattern": "(?i).",
          "by_rate": {
            "15": "1",
            "30": "2",
            "40": "3",
            "50": "4",
            "60": "5",
            "80": "6",
            "100": "7"
          }
        }
      ],
      "label": "blocks"
    },
    {
      "name": "modes",
      "type": "json",
      "default": [
        {
          "pattern": "(?i)\\bneft\\b",
          "code": "NEFT"
        },
        {
          "pattern": "(?i)\\brtgs\\b",
          "code": "RTGS"
        },
        {
          "pattern": "(?i)\\bimps\\b",
          "code": "IMPS"
        },
        {
          "pattern": "(?i)\\bupi\\b",
          "code": "UPI"
        },
        {
          "pattern": "(?i)cheque|\\bchq\\b",
          "code": "C"
        },
        {
          "pattern": "(?i)draft",
          "code": "BD"
        },
        {
          "pattern": "(?i)\\becs\\b",
          "code": "E"
        },
        {
          "pattern": "(?i)bank ?transfer|net ?banking|online",
          "code": "NB"
        },
        {
          "pattern": "(?i)cash",
          "code": "CR"
        }
      ],
      "label": "modes"
    },
    {
      "name": "account_payee_modes",
      "type": "json",
      "default": [
        "C",
        "BD",
        "E",
        "NB",
        "IMPS",
        "UPI",
        "RTGS",
        "NEFT"
      ],
      "label": "account payee modes"
    },
    {
      "name": "flags",
      "type": "json",
      "default": {
        "true": "Y",
        "false": "N"
      },
      "label": "flags"
    },
    {
      "name": "voice",
      "type": "json",
      "default": {
        "true": {
          "i_we": "We",
          "my_our": "Our",
          "me_us": "Us"
        },
        "false": {
          "i_we": "I",
          "my_our": "My",
          "me_us": "Me"
        }
      },
      "label": "voice"
    },
    {
      "name": "plsd",
      "type": "json",
      "default": {
        "true": "Profit",
        "false": "Loss"
      },
      "label": "plsd"
    },
    {
      "name": "type_of_account",
      "type": "text",
      "default": "Profit and loss account",
      "label": "type of account"
    },
    {
      "name": "yes_pattern",
      "type": "text",
      "default": "(?i)^\\s*(y|yes)\\b",
      "label": "yes pattern"
    },
    {
      "name": "mode_default",
      "type": "json",
      "default": {
        "true": "C",
        "false": "CR"
      },
      "label": "mode default"
    },
    {
      "name": "relation_default",
      "type": "text",
      "default": "Relative",
      "label": "relation default"
    },
    {
      "name": "natures",
      "type": "json",
      "default": [
        {
          "pattern": "(?i)interest",
          "word": "Interest"
        },
        {
          "pattern": "(?i)\\brent",
          "word": "Rent"
        },
        {
          "pattern": "(?i)salar",
          "word": "Salary"
        },
        {
          "pattern": "(?i)remunerat",
          "word": "Remuneration"
        },
        {
          "pattern": "(?i)commission",
          "word": "Commission"
        },
        {
          "pattern": "(?i)professional|consult",
          "word": "Professional fees"
        },
        {
          "pattern": "(?i)purchase",
          "word": "Purchase of goods"
        },
        {
          "pattern": "(?i)\\bsale",
          "word": "Sale of goods"
        },
        {
          "pattern": "(?i)service",
          "word": "Services"
        },
        {
          "pattern": "(?i)loan",
          "word": "Loan"
        }
      ],
      "label": "natures"
    },
    {
      "name": "nature_default",
      "type": "text",
      "default": "Payment",
      "label": "nature default"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "statuses": "$statuses",
      "blocks": "$blocks",
      "modes": "$modes",
      "account_payee_modes": "$account_payee_modes",
      "flags": "$flags",
      "voice": "$voice",
      "plsd": "$plsd",
      "type_of_account": "$type_of_account",
      "yes_pattern": "$yes_pattern",
      "mode_default": "$mode_default",
      "relation_default": "$relation_default",
      "natures": "$natures",
      "nature_default": "$nature_default"
    }
  },
  "returns": "record",
  "version": 2,
  "status": "published",
  "description_nl": "The report speaks as 'We / Our / Us' when the CA is a firm (it has an FRN), else 'I / My / Me'; Profit or Loss from the P&L. From the schema's descriptions: PartA Status 1 individual, 2 HUF, 3 firm, 4 LLP, 7 AOP, 12 BOI; depreciation blocks 1-7 plant and machinery @15/30/40/50/60/80/100%, 8/9/47/10 building @5/10/40/100%, 11 furniture @10%, 12 intangibles @25%, 13 ships @20%; payment modes C cheque, BD bank draft, E ECS, NB net banking, NEFT, RTGS, IMPS, UPI. 2026-10-05 owner (3CD from a party master): yes_pattern: a statement's Yes; mode_default: the mode when neither the statement nor the party master says (by account payee cheque, else cash); relation_default / natures / nature_default: clause 23's relationship and nature of transaction when the master or statement does not give them. 2026-10-11: Form 3CA-3CD PartA Status 5 = Company.",
