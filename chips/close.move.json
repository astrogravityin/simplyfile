{
  "chip_id": "close.move",
  "kind": "accessor",
  "set": "close",
  "label": "Close: may this filing action happen now?",
  "aliases": [
    "close: may this filing action happen now"
  ],
  "params": [
    {
      "name": "facts",
      "type": "json",
      "default": {},
      "label": "action (file / withdraw / revise / discard), signed, ack_ok, kind, filed, revising, has_note, may_revise, may_update"
    },
    {
      "name": "rules",
      "type": "json",
      "default": [
        {
          "when": {
            "action": "file",
            "signed": false
          },
          "set": {
            "ok": false,
            "say": "need_signoff"
          }
        },
        {
          "when": {
            "action": "file",
            "ack_ok": false
          },
          "set": {
            "ok": false,
            "say": "need_ack"
          }
        },
        {
          "when": {
            "action": "file",
            "kind": "too_late"
          },
          "set": {
            "ok": false,
            "say": "too_late"
          }
        },
        {
          "when": {
            "action": "file",
            "future": true
          },
          "set": {
            "ok": false,
            "say": "future_date"
          }
        },
        {
          "when": {
            "action": "file",
            "kind": "updated",
            "itru_ok": false
          },
          "set": {
            "ok": false,
            "say": "itru_not_more"
          }
        },
        {
          "when": {
            "action": "file",
            "kind": "updated",
            "itru_confirmed": false
          },
          "set": {
            "ok": false,
            "say": "itru_confirm_needed"
          }
        },
        {
          "when": {
            "action": "file",
            "filed": true
          },
          "set": {
            "ok": false,
            "say": "already_filed"
          }
        },
        {
          "when": {
            "action": "withdraw",
            "filed": false
          },
          "set": {
            "ok": false,
            "say": "nothing_filed"
          }
        },
        {
          "when": {
            "action": "withdraw",
            "has_note": false
          },
          "set": {
            "ok": false,
            "say": "need_reason"
          }
        },
        {
          "when": {
            "action": "revise",
            "filed": false
          },
          "set": {
            "ok": false,
            "say": "nothing_filed"
          }
        },
        {
          "when": {
            "action": "revise",
            "may_revise": false,
            "may_update": false
          },
          "set": {
            "ok": false,
            "say": "no_revision_window"
          }
        },
        {
          "when": {
            "action": "discard",
            "revising": false
          },
          "set": {
            "ok": false,
            "say": "not_revising"
          }
        }
      ],
      "label": "First matching row wins"
    },
    {
      "name": "otherwise",
      "type": "json",
      "default": {
        "ok": true,
        "say": ""
      },
      "label": "When no row matches"
    }
  ],
  "expr": {
    "vop": "decision_table",
    "facts": "$facts",
    "rules": "$rules",
    "current": "$otherwise"
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "Mark filed: signed off, a 15-digit acknowledgement, within the dates. Undo 'filed' (marked by mistake, wrong ack): with a reason, the filing is kept as withdrawn. Start a revision: while a revised (139(5)) or updated (ITR-U) return is still possible. Discard a revision: back to the return that stands. Nothing filed is ever deleted.",
  "test_cases": [
    {
      "args": {
        "facts": {
          "action": "file",
          "signed": false,
          "ack_ok": true
        }
      },
      "expect_value": {
        "ok": false,
        "say": "need_signoff"
      }
    },
    {
      "args": {
        "facts": {
          "action": "file",
          "signed": true,
          "ack_ok": false
        }
      },
      "expect_value": {
        "ok": false,
        "say": "need_ack"
      }
    },
    {
      "args": {
        "facts": {
          "action": "file",
          "signed": true,
          "ack_ok": true,
          "kind": "original",
          "filed": false
        }
      },
      "expect_value": {
        "ok": true,
        "say": ""
      }
    },
    {
      "args": {
        "facts": {
          "action": "withdraw",
          "filed": true,
          "has_note": false
        }
      },
      "expect_value": {
        "ok": false,
        "say": "need_reason"
      }
    },
    {
      "args": {
        "facts": {
          "action": "revise",
          "filed": true,
          "may_revise": false,
          "may_update": false
        }
      },
      "expect_value": {
        "ok": false,
        "say": "no_revision_window"
      }
    },
    {
      "args": {
        "facts": {
          "action": "revise",
          "filed": true,
          "may_revise": true,
          "may_update": false
        }
      },
      "expect_value": {
        "ok": true,
        "say": ""
      }
    },
    {
      "args": {
        "facts": {
          "action": "discard",
          "revising": false
        }
      },
      "expect_value": {
        "ok": false,
        "say": "not_revising"
      }
    }
  ]
}
