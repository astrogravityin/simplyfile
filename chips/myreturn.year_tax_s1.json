  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-10-10: part of chip myreturn.year_tax, split so that no field holds a copy of another (see tools/slim_myreturn_tax.py). Stage 1 works out known, total, on_normal, on_111a, on_112a, on_112, on_special; the _raw_ fields are the unrounded values the next stages use.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "known": true,
        "total": 0.0,
        "on_normal": 0,
        "_raw_on_normal": 0,
        "on_111a": 0,
        "_raw_on_111a": 0,
        "on_112a": 0,
        "_raw_on_112a": 0,
        "on_112": 0,
        "_raw_on_112": 0,
        "on_special": 0,
        "_raw_on_special": 0
      }
    },
    {
      "args": {
        "fy": 2022,
        "normal": 5100000,
        "stcg_111a": 400000,
        "ltcg_112a": 300000,
        "ltcg_112": 200000,
        "special": 100000,
        "regime": "old"
      },
      "expect_value": {
        "known": true,
        "total": 6100000.0,
        "on_normal": 1342500,
        "_raw_on_normal": 1342500,
        "on_111a": 60000,
        "_raw_on_111a": 60000,
        "on_112a": 20000,
        "_raw_on_112a": 20000,
        "on_112": 40000,
        "_raw_on_112": 40000,
        "on_special": 30000,
        "_raw_on_special": 30000
      }
    }
  ]
}
