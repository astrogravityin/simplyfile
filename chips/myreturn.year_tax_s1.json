{
  "chip_id": "myreturn.year_tax_s1",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: the tax of an earlier year, stage 1 of 5 (known, total, on_normal, on_111a, on_112a, on_112, on_special)",
  "aliases": [],
  "params": [
    {
      "name": "fy",
      "type": "number",
      "default": 2019,
      "label": "the financial year (its first year)"
    },
    {
      "name": "regime",
      "type": "text",
      "default": "old",
      "label": "old / new"
    },
    {
      "name": "band",
      "type": "text",
      "default": "below60",
      "label": "below60 / 60to80 / 80plus that year"
    },
    {
      "name": "resident",
      "type": "boolean",
      "default": true,
      "label": "resident that year (the unused basic exemption against special-rate gains, 87A)"
    },
    {
      "name": "normal",
      "type": "number",
      "default": 0,
      "label": "income at the slab rates"
    },
    {
      "name": "stcg_111a",
      "type": "number",
      "default": 0,
      "label": "short-term gains taxed u/s 111A"
    },
    {
      "name": "ltcg_112a",
      "type": "number",
      "default": 0,
      "label": "long-term gains u/s 112A (before its exemption)"
    },
    {
      "name": "ltcg_112",
      "type": "number",
      "default": 0,
      "label": "long-term gains u/s 112 (after indexation when that year's 112 had it)"
    },
    {
      "name": "special",
      "type": "number",
      "default": 0,
      "label": "income at 30%: 115BB / 115BBJ / 115BBH"
    },
    {
      "name": "early",
      "type": "boolean",
      "default": false,
      "label": "FY 2024-25: the gains were on transfers before 23 July 2024"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "known": {
        "vop": "get",
        "value": {
          "chip": "myreturn.year_rates",
          "args": {
            "fy": "$fy",
            "regime": "$regime",
            "early": "$early"
          }
        },
        "path": "known"
      },
      "total": {
        "vop": "total",
        "values": [
          "$normal",
          "$stcg_111a",
          "$ltcg_112a",
          "$ltcg_112",
          "$special"
        ]
      },
      "on_normal": {
        "vop": "round_to",
        "value": {
          "vop": "slab_tax",
          "amount": {
            "vop": "largest",
            "values": [
              "$normal",
              0
            ]
          },
          "slabs": {
            "vop": "get",
            "value": {
              "chip": "myreturn.slabs_by_year",
              "args": {}
            },
            "path": {
              "vop": "template",
              "text": "years.{y}.{r}.slabs.{b}",
              "values": {
                "vop": "record",
                "fields": {
                  "y": "$fy",
                  "r": "$regime",
                  "b": "$band"
                }
              }
            }
          }
        }
      },
      "_raw_on_normal": {
        "vop": "slab_tax",
        "amount": {
          "vop": "largest",
          "values": [
            "$normal",
            0
          ]
        },
        "slabs": {
          "vop": "get",
          "value": {
            "chip": "myreturn.slabs_by_year",
            "args": {}
          },
          "path": {
            "vop": "template",
            "text": "years.{y}.{r}.slabs.{b}",
            "values": {
              "vop": "record",
              "fields": {
                "y": "$fy",
                "r": "$regime",
                "b": "$band"
              }
            }
          }
        }
      },
      "on_111a": {
        "vop": "round_to",
        "value": {
          "vop": "mul",
          "a": {
            "vop": "largest",
            "values": [
              {
                "vop": "sub",
                "a": "$stcg_111a",
                "b": {
                  "vop": "choose",
                  "cases": [
                    {
                      "when": {
                        "op": "eq",
                        "left": "$resident",
                        "right": true
                      },
                      "then": {
                        "vop": "largest",
                        "values": [
                          {
                            "vop": "sub",
                            "a": {
                              "vop": "coalesce",
                              "values": [
                                {
                                  "vop": "get",
                                  "value": {
                                    "chip": "myreturn.slabs_by_year",
                                    "args": {}
                                  },
                                  "path": {
                                    "vop": "template",
                                    "text": "years.{y}.{r}.slabs.{b}.0.upto",
                                    "values": {
                                      "vop": "record",
                                      "fields": {
                                        "y": "$fy",
                                        "r": "$regime",
                                        "b": "$band"
                                      }
                                    }
                                  }
                                },
                                0
                              ]
                            },
                            "b": "$normal"
                          },
                          0
                        ]
                      }
                    }
                  ],
                  "else": 0
                }
              },
              0
            ]
          },
          "b": {
            "vop": "div",
            "a": {
              "vop": "get",
              "value": {
                "chip": "myreturn.year_rates",
                "args": {
                  "fy": "$fy",
                  "regime": "$regime",
                  "early": "$early"
                }
              },
              "path": "r111a"
            },
            "b": 100
          }
        }
      },
      "_raw_on_111a": {
        "vop": "mul",
        "a": {
          "vop": "largest",
          "values": [
            {
              "vop": "sub",
              "a": "$stcg_111a",
              "b": {
                "vop": "choose",
                "cases": [
                  {
                    "when": {
                      "op": "eq",
                      "left": "$resident",
                      "right": true
                    },
                    "then": {
                      "vop": "largest",
                      "values": [
                        {
                          "vop": "sub",
                          "a": {
                            "vop": "coalesce",
                            "values": [
                              {
                                "vop": "get",
                                "value": {
                                  "chip": "myreturn.slabs_by_year",
                                  "args": {}
                                },
                                "path": {
                                  "vop": "template",
                                  "text": "years.{y}.{r}.slabs.{b}.0.upto",
                                  "values": {
                                    "vop": "record",
                                    "fields": {
                                      "y": "$fy",
                                      "r": "$regime",
                                      "b": "$band"
                                    }
                                  }
                                }
                              },
                              0
                            ]
                          },
                          "b": "$normal"
                        },
                        0
                      ]
                    }
                  }
                ],
                "else": 0
              }
            },
            0
          ]
        },
        "b": {
          "vop": "div",
          "a": {
            "vop": "get",
            "value": {
              "chip": "myreturn.year_rates",
              "args": {
                "fy": "$fy",
                "regime": "$regime",
                "early": "$early"
              }
            },
            "path": "r111a"
          },
          "b": 100
        }
      },
      "on_112a": {
        "vop": "round_to",
        "value": {
          "vop": "mul",
          "a": {
            "vop": "largest",
            "values": [
              {
                "vop": "sub",
                "a": {
                  "vop": "largest",
                  "values": [
                    {
                      "vop": "sub",
                      "a": "$ltcg_112a",
                      "b": {
                        "vop": "get",
                        "value": {
                          "chip": "myreturn.year_rates",
                          "args": {
                            "fy": "$fy",
                            "regime": "$regime",
                            "early": "$early"
                          }
                        },
                        "path": "x112a"
                      }
                    },
                    0
                  ]
                },
                "b": {
                  "vop": "largest",
                  "values": [
                    {
                      "vop": "sub",
                      "a": {
                        "vop": "choose",
                        "cases": [
                          {
                            "when": {
                              "op": "eq",
                              "left": "$resident",
                              "right": true
                            },
                            "then": {
                              "vop": "largest",
                              "values": [
                                {
                                  "vop": "sub",
                                  "a": {
                                    "vop": "coalesce",
                                    "values": [
                                      {
                                        "vop": "get",
                                        "value": {
                                          "chip": "myreturn.slabs_by_year",
                                          "args": {}
                                        },
                                        "path": {
                                          "vop": "template",
                                          "text": "years.{y}.{r}.slabs.{b}.0.upto",
                                          "values": {
                                            "vop": "record",
                                            "fields": {
                                              "y": "$fy",
                                              "r": "$regime",
