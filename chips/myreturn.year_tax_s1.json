                                            }
                                          }
                                        }
                                      },
                                      0
                                    ]
                                  },
                                  "b": "$normal"
                                },
                                0
                              ]
                            }
                          }
                        ],
                        "else": 0
                      },
                      "b": "$stcg_111a"
                    },
                    0
                  ]
                }
              },
              0
            ]
          },
          "b": {
            "vop": "div",
            "a": {
              "vop": "get",
              "value": {
                "chip": "myreturn.year_rates",
                "args": {
                  "fy": "$fy",
                  "regime": "$regime",
                  "early": "$early"
                }
              },
              "path": "r112a"
            },
            "b": 100
          }
        }
      },
      "_raw_on_112a": {
        "vop": "mul",
        "a": {
          "vop": "largest",
          "values": [
            {
              "vop": "sub",
              "a": {
                "vop": "largest",
                "values": [
                  {
                    "vop": "sub",
                    "a": "$ltcg_112a",
                    "b": {
                      "vop": "get",
                      "value": {
                        "chip": "myreturn.year_rates",
                        "args": {
                          "fy": "$fy",
                          "regime": "$regime",
                          "early": "$early"
                        }
                      },
                      "path": "x112a"
                    }
                  },
                  0
                ]
              },
              "b": {
                "vop": "largest",
                "values": [
                  {
                    "vop": "sub",
                    "a": {
                      "vop": "choose",
                      "cases": [
                        {
                          "when": {
                            "op": "eq",
                            "left": "$resident",
                            "right": true
                          },
                          "then": {
                            "vop": "largest",
                            "values": [
                              {
                                "vop": "sub",
                                "a": {
                                  "vop": "coalesce",
                                  "values": [
                                    {
                                      "vop": "get",
                                      "value": {
                                        "chip": "myreturn.slabs_by_year",
                                        "args": {}
                                      },
                                      "path": {
                                        "vop": "template",
                                        "text": "years.{y}.{r}.slabs.{b}.0.upto",
                                        "values": {
                                          "vop": "record",
                                          "fields": {
                                            "y": "$fy",
                                            "r": "$regime",
                                            "b": "$band"
                                          }
                                        }
                                      }
                                    },
                                    0
                                  ]
                                },
                                "b": "$normal"
                              },
                              0
                            ]
                          }
                        }
                      ],
                      "else": 0
                    },
                    "b": "$stcg_111a"
                  },
                  0
                ]
              }
            },
            0
          ]
        },
        "b": {
          "vop": "div",
          "a": {
            "vop": "get",
            "value": {
              "chip": "myreturn.year_rates",
              "args": {
                "fy": "$fy",
