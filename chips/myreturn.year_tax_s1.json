                        "values": [
                          {
                            "vop": "sub",
                            "a": "$ltcg_112a",
                            "b": {
                              "vop": "get",
                              "value": {
                                "chip": "myreturn.year_rates",
                                "args": {
                                  "fy": "$fy",
                                  "regime": "$regime",
                                  "early": "$early"
                                }
                              },
                              "path": "x112a"
                            }
                          },
                          0
                        ]
