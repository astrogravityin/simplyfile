                "vop": "sub",
                "a": "$ltcg_112",
                "b": {
                  "vop": "largest",
                  "values": [
                    {
                      "vop": "sub",
                      "a": {
                        "vop": "largest",
                        "values": [
                          {
                            "vop": "sub",
                            "a": {
                              "vop": "choose",
                              "cases": [
                                {
                                  "when": {
                                    "op": "eq",
                                    "left": "$resident",
                                    "right": true
                                  },
                                  "then": {
                                    "vop": "largest",
                                    "values": [
                                      {
                                        "vop": "sub",
                                        "a": {
                                          "vop": "coalesce",
                                          "values": [
                                            {
                                              "vop": "get",
                                              "value": {
                                                "chip": "myreturn.slabs_by_year",
                                                "args": {}
                                              },
                                              "path": {
                                                "vop": "template",
                                                "text": "years.{y}.{r}.slabs.{b}.0.upto",
                                                "values": {
                                                  "vop": "record",
                                                  "fields": {
                                                    "y": "$fy",
                                                    "r": "$regime",
                                                    "b": "$band"
                                                  }
                                                }
                                              }
                                            },
                                            0
                                          ]
                                        },
                                        "b": "$normal"
                                      },
