{
  "chip_id": "page.recon",
  "kind": "accessor",
  "set": "page",
  "label": "Reconcile page settings",
  "aliases": [
    "page recon"
  ],
  "params": [
    {
      "name": "severity_tag",
      "type": "json",
      "default": {
        "red": "tag bad",
        "amber": "tag warn",
        "ok": "tag ok"
      },
      "label": "severity tag"
    },
    {
      "name": "exts",
      "type": "list",
      "default": [
        ".txt",
        ".csv",
        ".xls",
        ".xlsx"
      ],
      "label": "exts offered in the upload box (recon.settings decides what is taken)"
    },
    {
      "name": "checks",
      "type": "json",
      "default": [
        {
          "id": "tds",
          "kinds": [
            "tds",
            "tds_claim"
          ],
          "icon": "shield"
        },
        {
          "id": "income",
          "kinds": [
            "income"
          ],
          "icon": "money"
        },
        {
          "id": "paid",
          "kinds": [
            "paid",
            "paid_claim"
          ],
          "icon": "check"
        }
      ],
      "label": "checks"
    },
    {
      "name": "severity_color",
      "type": "json",
      "default": {
        "red": "--bad",
        "amber": "--warn",
        "ok": "--ok"
      },
      "label": "severity color"
    },
    {
      "name": "cleared_severities",
      "type": "json",
      "default": [
        "ok"
      ],
      "label": "cleared severities"
    },
    {
      "name": "explained_clears",
      "type": "json",
      "default": true,
      "label": "explained clears"
    },
    {
      "name": "sources",
      "type": "json",
      "default": [
        "26as",
        "ais",
        "tis"
      ],
      "label": "sources"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "severity_tag": "$severity_tag",
      "exts": "$exts",
      "checks": "$checks",
      "severity_color": "$severity_color",
      "cleared_severities": "$cleared_severities",
      "explained_clears": "$explained_clears",
      "sources": "$sources"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "How the Reconcile screen colours a finding by its severity.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "severity_tag": {
          "red": "tag bad",
          "amber": "tag warn",
          "ok": "tag ok"
        },
        "exts": [
          ".txt",
          ".csv",
          ".xls",
          ".xlsx"
        ],
        "checks": [
          {
            "id": "tds",
            "kinds": [
              "tds",
              "tds_claim"
            ],
            "icon": "shield"
          },
          {
            "id": "income",
            "kinds": [
              "income"
            ],
            "icon": "money"
          },
          {
            "id": "paid",
            "kinds": [
              "paid",
              "paid_claim"
            ],
            "icon": "check"
          }
        ],
        "severity_color": {
          "red": "--bad",
          "amber": "--warn",
          "ok": "--ok"
        },
        "cleared_severities": [
          "ok"
        ],
        "explained_clears": true,
        "sources": [
          "26as",
          "ais",
          "tis"
        ]
      }
    }
  ]
}
