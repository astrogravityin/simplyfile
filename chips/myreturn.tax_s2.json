        "vop": "round_to",
        "value": {
          "vop": "total",
          "values": [
            {
              "vop": "get",
              "value": "$b",
              "path": "_raw_on_111a"
            },
            {
              "vop": "get",
              "value": "$b",
              "path": "_raw_on_112a"
            },
            {
              "vop": "get",
              "value": "$b",
              "path": "_raw_on_112"
            },
            {
              "vop": "total",
              "values": [
                {
                  "vop": "get",
                  "value": "$b",
                  "path": "_raw_on_115bb"
                },
                {
                  "vop": "get",
                  "value": "$b",
                  "path": "_raw_on_115bbj"
                },
                {
                  "vop": "get",
                  "value": "$b",
                  "path": "_raw_on_115bbh"
