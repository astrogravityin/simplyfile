{
  "chip_id": "page.intake",
  "kind": "accessor",
  "set": "page",
  "label": "Intake & map page settings",
  "aliases": [
    "page intake"
  ],
  "params": [
    {
      "name": "state_tag",
      "type": "json",
      "default": {
        "tagged": "tag ok",
        "suggested": "tag brand",
        "untagged": "tag warn",
        "invalid": "tag bad",
        "total": "tag"
      },
      "label": "state tag"
    },
    {
      "name": "open_states",
      "type": "list",
      "default": [
        "suggested",
        "untagged",
        "invalid"
      ],
      "label": "open states"
    },
    {
      "name": "money_locale",
      "type": "text",
      "default": "en-IN",
      "label": "money locale"
    },
    {
      "name": "money_digits",
      "type": "number",
      "default": 2,
      "label": "money digits"
    },
    {
      "name": "numbers_shown",
      "type": "number",
      "default": 3,
      "label": "numbers shown"
    },
    {
      "name": "heading_chars",
      "type": "number",
      "default": 90,
      "label": "heading chars"
    },
    {
      "name": "ring",
      "type": "json",
      "default": [
        "tagged",
        "total",
        "suggested",
        "untagged",
        "invalid"
      ],
      "label": "ring"
    },
    {
      "name": "ring_color",
      "type": "json",
      "default": {
        "tagged": "--ok",
        "total": "--muted",
        "suggested": "--brand",
        "untagged": "--warn",
        "invalid": "--bad"
      },
      "label": "ring color"
    },
    {
      "name": "done_states",
      "type": "json",
      "default": [
        "tagged",
        "total"
      ],
      "label": "done states"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "state_tag": "$state_tag",
      "open_states": "$open_states",
      "money_locale": "$money_locale",
      "money_digits": "$money_digits",
      "numbers_shown": "$numbers_shown",
      "heading_chars": "$heading_chars",
      "ring": "$ring",
      "ring_color": "$ring_color",
      "done_states": "$done_states"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "How the Intake & map screen draws a row's state (tag class per state) and which states 'Needs a person' shows.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "state_tag": {
          "tagged": "tag ok",
          "suggested": "tag brand",
          "untagged": "tag warn",
          "invalid": "tag bad",
          "total": "tag"
        },
        "open_states": [
          "suggested",
          "untagged",
          "invalid"
        ],
        "money_locale": "en-IN",
        "money_digits": 2,
        "numbers_shown": 3,
        "heading_chars": 90,
        "ring": [
          "tagged",
          "total",
          "suggested",
          "untagged",
          "invalid"
        ],
        "ring_color": {
          "tagged": "--ok",
          "total": "--muted",
          "suggested": "--brand",
          "untagged": "--warn",
          "invalid": "--bad"
        },
        "done_states": [
          "tagged",
          "total"
        ]
      }
    }
  ]
}
