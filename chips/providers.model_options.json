          },
          {
            "id": "f",
            "have_key": true,
            "status": "active",
            "quality": 5,
            "cost_usd": null
          }
        ]
      },
      "expect_value": {
        "models": [
          {
            "id": "a",
            "have_key": true,
            "status": "active",
            "quality": 5,
            "cost_usd": 0.04
          },
          {
            "id": "f",
            "have_key": true,
            "status": "active",
            "quality": 5,
            "cost_usd": null
          },
          {
            "id": "b",
            "have_key": true,
            "status": "active",
            "quality": 4,
