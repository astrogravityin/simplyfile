{
  "chip_id": "itr.settings",
  "kind": "accessor",
  "set": "itr",
  "label": "ITR JSON: the schemas and how the export behaves",
  "aliases": [
    "itr json: the schemas and how the export"
  ],
  "params": [
    {
      "name": "forms",
      "type": "json",
      "default": {
        "ITR-3": {
          "schema": "schemas/itr/ITR-3_2026_Main_V1.1.json",
          "root": "ITR3"
        },
        "ITR-5": {
          "schema": "schemas/itr/ITR-5_2026_Main_V1.1.json",
          "root": "ITR5"
        },
        "ITR-1": {
          "schema": "schemas/itr/ITR-1_2026_Main_V1.1.json",
          "root": "ITR1"
        },
        "ITR-2": {
          "schema": "schemas/itr/ITR-2_2026_Main_V1.2.json",
          "root": "ITR2"
        },
        "ITR-4": {
          "schema": "schemas/itr/ITR-4_2026_Main_V1.1.json",
          "root": "ITR4"
        }
      },
      "label": "forms"
    },
    {
      "name": "enum_default",
      "type": "text",
      "default": "N",
      "label": "enum default"
    },
    {
      "name": "errors_shown",
      "type": "json",
      "default": 60,
      "label": "errors shown"
    },
    {
      "name": "error_chars",
      "type": "json",
      "default": 220,
      "label": "error chars"
    },
    {
      "name": "sw_id",
      "type": "text",
      "default": "SW00000000",
      "label": "sw id"
    },
    {
      "name": "sw_version",
      "type": "text",
      "default": "1.0",
      "label": "sw version"
    },
    {
      "name": "own_maps",
      "type": "json",
      "default": {
        "ITR-3": "ITR-3 myreturn"
      },
      "label": "My return's own itr.map rows for a form the CA side fills from books"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "forms": "$forms",
      "enum_default": "$enum_default",
      "errors_shown": "$errors_shown",
      "error_chars": "$error_chars",
      "sw_id": "$sw_id",
      "sw_version": "$sw_version",
      "own_maps": "$own_maps"
    }
  },
  "returns": "record",
  "version": 4,
  "status": "published",
  "description_nl": "The CBDT's JSON Schema per form for AY 2026-27 (incometax.gov.in > Downloads, V1.1). A new AY = new schema files and new paths here. sw_id: the software ID the CBDT gives a registered utility (SW + 8 digits); until SimplyFile has one, the JSON is opened in the department's offline utility, which writes its own and uploads it. 2026-10-06: ITR-1 (V1.1) and ITR-2 (V1.2) for My return. 2026-10-06: ITR-4 (Sugam) AY 2026-27 schema V1.1 (the department's, 30-Jun-2026). 2026-10-07: own_maps - My return's ITR-3 has its own itr.map rows (ITR-3 myreturn); the CA side's ITR-3 rows (a trial balance) stay as they are.",
  "test_cases": [
    {
      "args": {},
      "expect_value": {
        "forms": {
          "ITR-3": {
            "schema": "schemas/itr/ITR-3_2026_Main_V1.1.json",
            "root": "ITR3"
          },
          "ITR-5": {
            "schema": "schemas/itr/ITR-5_2026_Main_V1.1.json",
            "root": "ITR5"
          },
          "ITR-1": {
            "schema": "schemas/itr/ITR-1_2026_Main_V1.1.json",
            "root": "ITR1"
          },
          "ITR-2": {
            "schema": "schemas/itr/ITR-2_2026_Main_V1.2.json",
            "root": "ITR2"
          },
          "ITR-4": {
            "schema": "schemas/itr/ITR-4_2026_Main_V1.1.json",
            "root": "ITR4"
          }
        },
        "enum_default": "N",
        "errors_shown": 60,
        "error_chars": 220,
        "sw_id": "SW00000000",
        "sw_version": "1.0",
        "own_maps": {
          "ITR-3": "ITR-3 myreturn"
        }
      }
    }
  ]
}
