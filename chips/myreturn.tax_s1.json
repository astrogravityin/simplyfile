{
  "chip_id": "myreturn.tax_s1",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: the tax, stage 1 of 5 (total, basic_left, on_normal, on_aggregate, agri_rebate, on_111a, on_112a, on_112, on_115bb, on_115bbj, on_115bbh, surcharge_rate)",
  "aliases": [],
  "params": [
    {
      "name": "normal",
      "type": "number",
      "default": 0,
      "label": "total income at normal rates (after Chapter VI-A), rounded"
    },
    {
      "name": "stcg_111a",
      "type": "number",
      "default": 0,
      "label": "short-term gains on listed shares/equity funds (111A)"
    },
    {
      "name": "ltcg_112a",
      "type": "number",
      "default": 0,
      "label": "long-term gains on listed shares/equity funds (112A), before the 1.25 lakh exemption"
    },
    {
      "name": "ltcg_112",
      "type": "number",
      "default": 0,
      "label": "other long-term gains (112)"
    },
    {
      "name": "regime",
      "type": "text",
      "default": "new",
      "label": "regime"
    },
    {
      "name": "band",
      "type": "text",
      "default": "below60",
      "label": "age band"
    },
    {
      "name": "resident",
      "type": "boolean",
      "default": true,
      "label": "resident in India"
    },
    {
      "name": "status",
      "type": "text",
      "default": "individual",
      "label": "individual / huf"
    },
    {
      "name": "lottery",
      "type": "number",
      "default": 0,
      "label": "115BB winnings (lottery, crossword, races, gambling, betting)"
    },
    {
      "name": "online_games",
      "type": "number",
      "default": 0,
      "label": "115BBJ net winnings from online games"
    },
    {
      "name": "vda",
      "type": "number",
      "default": 0,
      "label": "115BBH income from virtual digital assets"
    },
    {
      "name": "agri",
      "type": "number",
      "default": 0,
      "label": "net agricultural income (exempt, but counts for the rate)"
    },
    {
      "name": "excess_112",
      "type": "number",
      "default": 0,
      "label": "proviso to s.112(1)(a): the tax at 12.5% without indexation less the tax at 20% with it, land / building bought before 23 July 2024 (chip myreturn.cg_choice) - left out of the 112 tax"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "total": {
        "vop": "total",
        "values": [
          "$normal",
          "$stcg_111a",
          {
            "vop": "largest",
            "values": [
              {
                "vop": "sub",
                "a": "$ltcg_112a",
                "b": {
                  "vop": "get",
                  "value": {
                    "chip": "myreturn.rates",
                    "args": {}
                  },
                  "path": "exempt_112a"
                }
              },
              0
            ]
          },
          "$ltcg_112",
          "$lottery",
          "$online_games",
          "$vda"
        ]
      },
      "basic_left": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "eq",
              "left": "$resident",
              "right": true
            },
            "then": {
              "vop": "largest",
              "values": [
                {
                  "vop": "sub",
                  "a": {
                    "vop": "get",
                    "value": {
                      "chip": "myreturn.rates",
                      "args": {}
                    },
                    "path": {
                      "vop": "template",
                      "text": "basic.{a}.{b}",
                      "values": {
                        "vop": "record",
                        "fields": {
                          "a": "$regime",
                          "b": "$band"
                        }
                      }
                    }
                  },
                  "b": "$normal"
                },
                0
              ]
            }
          }
        ],
        "else": 0
      },
      "on_normal": {
        "vop": "round_to",
        "value": {
          "vop": "get",
          "value": {
            "chip": "myreturn.slab_normal",
            "args": {
              "normal": "$normal",
              "agri": "$agri",
              "total": {
                "vop": "total",
                "values": [
                  "$normal",
                  "$stcg_111a",
                  {
                    "vop": "largest",
                    "values": [
                      {
                        "vop": "sub",
                        "a": "$ltcg_112a",
                        "b": {
                          "vop": "get",
                          "value": {
                            "chip": "myreturn.rates",
                            "args": {}
                          },
                          "path": "exempt_112a"
