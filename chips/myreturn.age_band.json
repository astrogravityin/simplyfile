{
  "chip_id": "myreturn.age_band",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: age band on the last day of the year",
  "aliases": [
    "my return: age band on the last day of t"
  ],
  "params": [
    {
      "name": "age",
      "type": "number",
      "default": 40,
      "label": "age on 31 March of the financial year"
    },
    {
      "name": "status",
      "type": "text",
      "default": "individual",
      "label": "individual / huf"
    },
    {
      "name": "resident",
      "type": "boolean",
      "default": true,
      "label": "resident in India (a non-resident has no senior / very senior basic exemption, 80TTB or senior 80D)"
    }
  ],
  "expr": {
    "vop": "choose",
    "cases": [
      {
        "when": {
          "op": "eq",
          "left": "$resident",
          "right": false
        },
        "then": "below60"
      }
    ],
    "else": {
      "vop": "choose",
      "cases": [
        {
          "when": {
            "op": "eq",
            "left": "$status",
            "right": "huf"
          },
          "then": "below60"
        }
      ],
      "else": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "ge",
              "left": "$age",
              "right": {
                "vop": "get",
                "value": {
                  "chip": "myreturn.rates",
                  "args": {}
                },
                "path": "very_senior_age"
              }
            },
            "then": "80plus"
          },
          {
            "when": {
              "op": "ge",
              "left": "$age",
              "right": {
                "vop": "get",
                "value": {
                  "chip": "myreturn.rates",
                  "args": {}
                },
                "path": "senior_age"
              }
            },
            "then": "60to80"
          }
        ],
        "else": "below60"
      }
    }
  },
  "returns": "record",
  "version": 3,
  "status": "published",
  "description_nl": "2026-10-06: below 60, 60 to 80 (senior) and 80 or more (very senior) - the old regime's basic exemption and 80D/80TTB follow it. 2026-10-06: an HUF has no age - always the below-60 slabs. 2026-10-07: resident: a non-resident is in the below-60 band whatever the age - the old regime's 3 / 5 lakh basic exemption, 80TTB and the senior citizen's 80D limit are for an individual resident in India (Finance Act Part I; s.80TTB, s.80D(4)).",
  "test_cases": [
    {
      "args": {
        "age": 59
      },
      "expect_value": "below60"
    },
    {
      "args": {
        "age": 60
      },
      "expect_value": "60to80"
    },
    {
      "args": {
        "age": 85
      },
      "expect_value": "80plus"
    },
    {
      "args": {
        "age": 70,
        "status": "huf"
      },
      "expect_value": "below60"
    },
    {
      "args": {
        "age": 65,
        "resident": false
      },
      "expect_value": "below60"
    },
    {
      "args": {
        "age": 65
      },
      "expect_value": "60to80"
    },
    {
      "args": {
        "age": 85,
        "resident": false
      },
      "expect_value": "below60"
    }
  ]
}
