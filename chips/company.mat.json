{
  "chip_id": "company.mat",
  "kind": "accessor",
  "set": "company",
  "label": "Company: MAT u/s 115JB and the MAT credit u/s 115JAA",
  "aliases": [
    "company: mat u/s 115jb and the mat credi"
  ],
  "params": [
    {
      "name": "normal_total",
      "type": "number",
      "default": 0,
      "label": "tax on total income under the normal provisions, incl. surcharge and cess (company.tax total)"
    },
    {
      "name": "book_profit",
      "type": "number",
      "default": 0,
      "label": "book profit u/s 115JB"
    },
    {
      "name": "applies",
      "type": "boolean",
      "default": true,
      "label": "MAT applies (company.rate mat)"
    },
    {
      "name": "mat_rate",
      "type": "number",
      "default": 15,
      "label": "MAT %"
    },
    {
      "name": "steps",
      "type": "json",
      "default": [
        {
          "above": 10000000,
          "rate": 7
        },
        {
          "above": 100000000,
          "rate": 12
        }
      ],
      "label": "surcharge steps on MAT"
    },
    {
      "name": "cess_pct",
      "type": "number",
      "default": 4,
      "label": "cess %"
    },
    {
      "name": "round_to",
      "type": "number",
      "default": 10,
      "label": "rounded to"
    },
    {
      "name": "credit_available",
      "type": "number",
      "default": 0,
      "label": "MAT credit brought forward and still within 15 AYs"
