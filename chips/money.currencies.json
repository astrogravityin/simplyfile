{
  "chip_id": "money.currencies",
  "kind": "accessor",
  "set": "money",
  "audience": "admin",
  "label": "The currencies a person may see money in, and each one's rate to the US dollar",
  "aliases": [
    "currency",
    "INR",
    "exchange rate"
  ],
  "params": [
    {
      "name": "default_code",
      "type": "text",
      "default": "USD"
    },
    {
      "name": "no_such",
      "type": "text",
      "default": "{code} is not a currency this portal shows. Pick one from the list."
    },
    {
      "name": "feed_url",
      "type": "text",
      "default": "https://open.er-api.com/v6/latest/USD"
    },
    {
      "name": "feed_key",
      "type": "text",
      "default": "rates"
    },
    {
      "name": "feed_at_key",
      "type": "text",
      "default": "time_last_update_utc"
    },
    {
      "name": "feed_timeout_s",
      "type": "number",
      "default": 6
    },
    {
      "name": "refresh_hours",
      "type": "number",
      "default": 24
    },
    {
      "name": "retry_minutes",
      "type": "number",
      "default": 60
    },
    {
      "name": "rows",
      "type": "list",
      "default": [
        {"code": "USD", "label": "US dollar", "symbol": "$", "per_usd": 1, "decimals": 2},
        {"code": "INR", "label": "Indian rupee", "symbol": "₹", "per_usd": 84, "decimals": 2},
        {"code": "EUR", "label": "Euro", "symbol": "€", "per_usd": 0.92, "decimals": 2},
        {"code": "GBP", "label": "British pound", "symbol": "£", "per_usd": 0.78, "decimals": 2},
        {"code": "JPY", "label": "Japanese yen", "symbol": "¥", "per_usd": 150, "decimals": 0},
        {"code": "CNY", "label": "Chinese yuan", "symbol": "CN¥", "per_usd": 7.2, "decimals": 2},
        {"code": "AUD", "label": "Australian dollar", "symbol": "A$", "per_usd": 1.5, "decimals": 2},
        {"code": "CAD", "label": "Canadian dollar", "symbol": "CA$", "per_usd": 1.36, "decimals": 2},
        {"code": "CHF", "label": "Swiss franc", "symbol": "CHF ", "per_usd": 0.88, "decimals": 2},
        {"code": "SGD", "label": "Singapore dollar", "symbol": "S$", "per_usd": 1.34, "decimals": 2},
        {"code": "AED", "label": "UAE dirham", "symbol": "AED ", "per_usd": 3.67, "decimals": 2},
        {"code": "SAR", "label": "Saudi riyal", "symbol": "SAR ", "per_usd": 3.75, "decimals": 2},
        {"code": "HKD", "label": "Hong Kong dollar", "symbol": "HK$", "per_usd": 7.8, "decimals": 2},
        {"code": "KRW", "label": "South Korean won", "symbol": "₩", "per_usd": 1350, "decimals": 0},
        {"code": "BRL", "label": "Brazilian real", "symbol": "R$", "per_usd": 5.4, "decimals": 2},
        {"code": "MXN", "label": "Mexican peso", "symbol": "MX$", "per_usd": 18.5, "decimals": 2}
      ]
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "default_code": "$default_code",
      "no_such": "$no_such",
      "feed_url": "$feed_url",
      "feed_key": "$feed_key",
      "feed_at_key": "$feed_at_key",
      "feed_timeout_s": "$feed_timeout_s",
      "refresh_hours": "$refresh_hours",
      "retry_minutes": "$retry_minutes",
      "rows": "$rows"
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "Every provider bills in US dollars, and the portal's books stay in US dollars. A person picks the currency they THINK in (Account & key → Budget), and every amount on every screen - costs, budgets, what is left - is shown in it at the per_usd rate here; a budget typed in that currency is divided by the rate on the way in. per_usd in the rows is the FALLBACK rate; once a day (refresh_hours) the portal asks feed_url (a free, key-less feed; feed_key names the table in its answer, feed_at_key its date) and keeps the live rates in the store file `rates`, retrying a failed fetch no sooner than retry_minutes. A blank feed_url means fixed rates only. Money shown is a guide to what a run costs, never an invoice. decimals: how many places a budget shows (a cost shows two more, since a model call is fractions of a cent).",
  "test_cases": [
    {
      "args": {
        "rows": [
          {"code": "USD", "label": "US dollar", "symbol": "$", "per_usd": 1, "decimals": 2},
          {"code": "INR", "label": "Indian rupee", "symbol": "₹", "per_usd": 84, "decimals": 2}
        ]
      },
      "expect_value": {
        "default_code": "USD",
        "no_such": "{code} is not a currency this portal shows. Pick one from the list.",
        "feed_url": "https://open.er-api.com/v6/latest/USD",
        "feed_key": "rates",
        "feed_at_key": "time_last_update_utc",
        "feed_timeout_s": 6,
        "refresh_hours": 24,
        "retry_minutes": 60,
        "rows": [
          {"code": "USD", "label": "US dollar", "symbol": "$", "per_usd": 1, "decimals": 2},
          {"code": "INR", "label": "Indian rupee", "symbol": "₹", "per_usd": 84, "decimals": 2}
        ]
      }
    }
  ],
  "weight_basis": "Add a currency or change a rate here. Never in Python or JavaScript."
}
