{
  "chip_id": "close.dates",
  "kind": "accessor",
  "set": "close",
  "label": "Close: the year's due dates and what a return filed on a day is",
  "aliases": [
    "close: the year's due dates and what a r"
  ],
  "params": [
    {
      "name": "ay_year",
      "type": "number",
      "default": 2026,
      "label": "the AY's first year (2026 for 2026-27)"
    },
    {
      "name": "audit",
      "type": "boolean",
      "default": false,
      "label": "tax audit (3CD) applies"
    },
    {
      "name": "tp",
      "type": "boolean",
      "default": false,
      "label": "transfer pricing report (Form 3CEB, s.92E) applies"
    },
    {
      "name": "form",
      "type": "text",
      "default": "",
      "label": "the year's ITR form"
    },
    {
      "name": "business_forms",
      "type": "json",
      "default": [
        "ITR-3",
        "ITR-4",
        "ITR-5"
      ],
      "label": "forms with business / profession income: non-audit due date 31 August (Finance Act 2026)"
    },
    {
      "name": "business_from_year",
      "type": "number",
      "default": 2026,
      "label": "the 31 August date applies from AY 2026-27 (earlier years: 31 July)"
    },
    {
      "name": "due_business_mmdd",
      "type": "number",
      "default": 831,
      "label": "s.139(1) due date, business or profession without audit: 31 August (from AY 2026-27)"
    },
    {
      "name": "due_tp_mmdd",
      "type": "number",
      "default": 1130,
      "label": "s.139(1) due date with a Form 3CEB report: 30 November"
    },
    {
      "name": "filed_on",
      "type": "number",
      "default": 0,
      "label": "the day the return is filed, yyyymmdd"
    },
    {
      "name": "today",
      "type": "number",
      "default": 0,
      "label": "today, yyyymmdd"
    },
    {
      "name": "has_current",
      "type": "boolean",
      "default": false,
      "label": "a filed return already stands"
    },
    {
      "name": "has_updated",
      "type": "boolean",
      "default": false,
      "label": "an ITR-U was already filed"
    },
    {
      "name": "due_mmdd",
      "type": "number",
      "default": 731,
      "label": "s.139(1) due date, no audit: 31 July"
    },
    {
      "name": "due_audit_mmdd",
      "type": "number",
      "default": 1031,
      "label": "s.139(1) due date with tax audit: 31 October"
    },
    {
      "name": "revise_mmdd",
      "type": "number",
      "default": 1231,
      "label": "s.139(4) belated / s.139(5) revised: by 31 December of the AY"
    },
    {
      "name": "updated_mmdd",
      "type": "number",
      "default": 331,
      "label": "s.139(8A) ITR-U: within 48 months of the end of the AY ..."
    },
    {
      "name": "updated_years_after",
      "type": "number",
      "default": 5,
      "label": "... = 31 March, AY's first year + 5"
    },
    {
      "name": "extensions",
      "type": "json",
      "default": {
        "2026": {
          "due_audit_mmdd": 1121,
          "audit_report_mmdd": 1021,
          "why": "CBDT Circular No. 07/2026 dated 28 September 2026",
          "source": "https://www.incometax.gov.in/iec/foportal/latest-news"
        }
      },
      "label": "one year's due dates as CBDT extended them (by circular) - {AY start year: {date: MMDD, why, source}}"
    },
    {
      "name": "audit_report_mmdd",
      "type": "number",
      "default": 930,
      "label": "tax audit report (s.44AB) due, MMDD"
    },
    {
      "name": "revise_long_from_year",
      "type": "number",
      "default": 2026,
      "label": "from this AY a return can be revised to 31 March of the AY (Finance Act 2026)"
    },
    {
      "name": "revise_late_mmdd",
      "type": "number",
      "default": 331,
      "label": "last day to revise (in the year after the AY starts), with the s.234I fee"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "due": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "eq",
              "left": "$tp",
              "right": true
            },
            "then": {
              "vop": "add",
              "a": {
                "vop": "mul",
                "a": {
                  "vop": "add",
                  "a": "$ay_year",
                  "b": 0
                },
                "b": 10000
              },
              "b": {
                "vop": "coalesce",
                "values": [
                  {
                    "vop": "get",
                    "value": "$extensions",
                    "path": {
                      "vop": "template",
                      "text": "{y}.due_tp_mmdd",
                      "values": {
                        "vop": "record",
                        "fields": {
                          "y": "$ay_year"
                        }
                      }
                    }
                  },
                  "$due_tp_mmdd"
                ]
              }
            }
          },
          {
            "when": {
              "op": "eq",
              "left": "$audit",
              "right": true
            },
            "then": {
              "vop": "add",
              "a": {
                "vop": "mul",
                "a": {
                  "vop": "add",
                  "a": "$ay_year",
                  "b": 0
                },
                "b": 10000
              },
              "b": {
                "vop": "coalesce",
                "values": [
                  {
                    "vop": "get",
                    "value": "$extensions",
                    "path": {
                      "vop": "template",
                      "text": "{y}.due_audit_mmdd",
                      "values": {
                        "vop": "record",
                        "fields": {
                          "y": "$ay_year"
                        }
                      }
                    }
                  },
                  "$due_audit_mmdd"
                ]
              }
            }
          },
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "in_set",
                  "value": "$form",
                  "set": "$business_forms"
                },
                {
                  "op": "ge",
                  "left": "$ay_year",
                  "right": "$business_from_year"
                }
              ]
            },
            "then": {
              "vop": "add",
              "a": {
                "vop": "mul",
                "a": {
                  "vop": "add",
                  "a": "$ay_year",
                  "b": 0
                },
                "b": 10000
              },
              "b": {
                "vop": "coalesce",
                "values": [
                  {
                    "vop": "get",
                    "value": "$extensions",
                    "path": {
                      "vop": "template",
                      "text": "{y}.due_business_mmdd",
                      "values": {
                        "vop": "record",
                        "fields": {
                          "y": "$ay_year"
                        }
                      }
                    }
                  },
                  "$due_business_mmdd"
                ]
              }
            }
          }
        ],
        "else": {
          "vop": "add",
          "a": {
            "vop": "mul",
            "a": {
              "vop": "add",
              "a": "$ay_year",
              "b": 0
            },
            "b": 10000
          },
          "b": {
            "vop": "coalesce",
            "values": [
              {
                "vop": "get",
                "value": "$extensions",
                "path": {
                  "vop": "template",
                  "text": "{y}.due_mmdd",
                  "values": {
                    "vop": "record",
                    "fields": {
                      "y": "$ay_year"
                    }
                  }
                }
              },
              "$due_mmdd"
            ]
          }
        }
      },
      "revise_by": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "ge",
              "left": "$ay_year",
              "right": "$revise_long_from_year"
            },
            "then": {
              "vop": "add",
              "a": {
                "vop": "mul",
                "a": {
                  "vop": "add",
                  "a": "$ay_year",
                  "b": 1
                },
                "b": 10000
              },
              "b": "$revise_late_mmdd"
            }
          }
        ],
        "else": {
          "vop": "add",
          "a": {
            "vop": "mul",
            "a": {
              "vop": "add",
              "a": "$ay_year",
              "b": 0
            },
            "b": 10000
          },
          "b": "$revise_mmdd"
        }
      },
      "updated_by": {
        "vop": "add",
        "a": {
          "vop": "mul",
          "a": {
            "vop": "add",
            "a": "$ay_year",
            "b": "$updated_years_after"
          },
          "b": 10000
        },
        "b": "$updated_mmdd"
      },
      "kind": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "eq",
              "left": "$has_current",
              "right": true
            },
            "then": {
              "vop": "choose",
              "cases": [
                {
                  "when": {
                    "op": "le",
                    "left": "$filed_on",
                    "right": {
                      "vop": "choose",
                      "cases": [
                        {
                          "when": {
                            "op": "ge",
                            "left": "$ay_year",
                            "right": "$revise_long_from_year"
                          },
                          "then": {
                            "vop": "add",
                            "a": {
                              "vop": "mul",
                              "a": {
                                "vop": "add",
                                "a": "$ay_year",
                                "b": 1
                              },
                              "b": 10000
                            },
                            "b": "$revise_late_mmdd"
                          }
                        }
                      ],
                      "else": {
                        "vop": "add",
                        "a": {
                          "vop": "mul",
                          "a": {
                            "vop": "add",
                            "a": "$ay_year",
                            "b": 0
                          },
                          "b": 10000
                        },
                        "b": "$revise_mmdd"
                      }
                    }
                  },
                  "then": "revised"
                },
                {
                  "when": {
                    "op": "all",
                    "items": [
                      {
                        "op": "le",
                        "left": "$filed_on",
                        "right": {
                          "vop": "add",
                          "a": {
                            "vop": "mul",
                            "a": {
                              "vop": "add",
                              "a": "$ay_year",
                              "b": "$updated_years_after"
                            },
                            "b": 10000
                          },
                          "b": "$updated_mmdd"
                        }
                      },
                      {
                        "op": "not",
                        "item": {
                          "op": "eq",
                          "left": "$has_updated",
                          "right": true
                        }
                      }
                    ]
                  },
                  "then": "updated"
                }
              ],
              "else": "too_late"
            }
          },
          {
            "when": {
              "op": "le",
              "left": "$filed_on",
              "right": {
                "vop": "choose",
                "cases": [
                  {
                    "when": {
                      "op": "eq",
                      "left": "$tp",
                      "right": true
                    },
                    "then": {
                      "vop": "add",
                      "a": {
                        "vop": "mul",
                        "a": {
                          "vop": "add",
                          "a": "$ay_year",
                          "b": 0
                        },
                        "b": 10000
                      },
                      "b": {
                        "vop": "coalesce",
                        "values": [
                          {
                            "vop": "get",
                            "value": "$extensions",
                            "path": {
                              "vop": "template",
                              "text": "{y}.due_tp_mmdd",
                              "values": {
                                "vop": "record",
                                "fields": {
                                  "y": "$ay_year"
                                }
                              }
                            }
                          },
                          "$due_tp_mmdd"
                        ]
                      }
                    }
                  },
                  {
                    "when": {
                      "op": "eq",
                      "left": "$audit",
                      "right": true
                    },
                    "then": {
                      "vop": "add",
                      "a": {
                        "vop": "mul",
                        "a": {
                          "vop": "add",
                          "a": "$ay_year",
                          "b": 0
                        },
                        "b": 10000
                      },
                      "b": {
                        "vop": "coalesce",
                        "values": [
                          {
                            "vop": "get",
                            "value": "$extensions",
                            "path": {
                              "vop": "template",
                              "text": "{y}.due_audit_mmdd",
                              "values": {
                                "vop": "record",
                                "fields": {
                                  "y": "$ay_year"
                                }
                              }
                            }
                          },
                          "$due_audit_mmdd"
                        ]
                      }
                    }
                  },
                  {
                    "when": {
                      "op": "all",
                      "items": [
                        {
                          "op": "in_set",
                          "value": "$form",
                          "set": "$business_forms"
                        },
                        {
                          "op": "ge",
                          "left": "$ay_year",
                          "right": "$business_from_year"
                        }
                      ]
                    },
                    "then": {
                      "vop": "add",
                      "a": {
                        "vop": "mul",
                        "a": {
                          "vop": "add",
                          "a": "$ay_year",
                          "b": 0
                        },
                        "b": 10000
                      },
                      "b": {
                        "vop": "coalesce",
                        "values": [
                          {
                            "vop": "get",
                            "value": "$extensions",
                            "path": {
                              "vop": "template",
                              "text": "{y}.due_business_mmdd",
                              "values": {
                                "vop": "record",
                                "fields": {
                                  "y": "$ay_year"
                                }
                              }
                            }
                          },
                          "$due_business_mmdd"
                        ]
                      }
                    }
                  }
                ],
                "else": {
                  "vop": "add",
                  "a": {
                    "vop": "mul",
                    "a": {
                      "vop": "add",
                      "a": "$ay_year",
                      "b": 0
                    },
                    "b": 10000
                  },
                  "b": {
                    "vop": "coalesce",
                    "values": [
                      {
                        "vop": "get",
                        "value": "$extensions",
                        "path": {
                          "vop": "template",
                          "text": "{y}.due_mmdd",
                          "values": {
                            "vop": "record",
                            "fields": {
                              "y": "$ay_year"
                            }
                          }
                        }
                      },
                      "$due_mmdd"
                    ]
                  }
                }
              }
            },
            "then": "original"
          },
          {
            "when": {
              "op": "le",
              "left": "$filed_on",
              "right": {
                "vop": "choose",
                "cases": [
                  {
                    "when": {
                      "op": "ge",
                      "left": "$ay_year",
                      "right": "$revise_long_from_year"
                    },
                    "then": {
                      "vop": "add",
                      "a": {
                        "vop": "mul",
                        "a": {
                          "vop": "add",
                          "a": "$ay_year",
                          "b": 1
                        },
                        "b": 10000
                      },
                      "b": "$revise_late_mmdd"
                    }
                  }
                ],
                "else": {
                  "vop": "add",
                  "a": {
                    "vop": "mul",
                    "a": {
                      "vop": "add",
                      "a": "$ay_year",
                      "b": 0
                    },
                    "b": 10000
                  },
                  "b": "$revise_mmdd"
                }
              }
            },
            "then": "belated"
          },
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "le",
                  "left": "$filed_on",
                  "right": {
                    "vop": "add",
                    "a": {
                      "vop": "mul",
                      "a": {
                        "vop": "add",
                        "a": "$ay_year",
                        "b": "$updated_years_after"
                      },
                      "b": 10000
                    },
                    "b": "$updated_mmdd"
                  }
                },
                {
                  "op": "not",
                  "item": {
                    "op": "eq",
                    "left": "$has_updated",
                    "right": true
                  }
                }
              ]
            },
            "then": "updated"
          }
        ],
        "else": "too_late"
      },
      "may_revise": {
        "op": "all",
        "items": [
          {
            "op": "eq",
            "left": "$has_current",
            "right": true
          },
          {
            "op": "le",
            "left": "$today",
            "right": {
              "vop": "choose",
              "cases": [
                {
                  "when": {
                    "op": "ge",
                    "left": "$ay_year",
                    "right": "$revise_long_from_year"
                  },
                  "then": {
                    "vop": "add",
                    "a": {
                      "vop": "mul",
                      "a": {
                        "vop": "add",
                        "a": "$ay_year",
                        "b": 1
                      },
                      "b": 10000
                    },
                    "b": "$revise_late_mmdd"
                  }
                }
              ],
              "else": {
                "vop": "add",
                "a": {
                  "vop": "mul",
                  "a": {
                    "vop": "add",
                    "a": "$ay_year",
                    "b": 0
                  },
                  "b": 10000
                },
                "b": "$revise_mmdd"
              }
            }
          }
        ]
      },
      "may_update": {
        "op": "all",
        "items": [
          {
            "op": "eq",
            "left": "$has_current",
            "right": true
          },
          {
            "op": "not",
            "item": {
              "op": "eq",
              "left": "$has_updated",
              "right": true
            }
          },
          {
            "op": "gt",
            "left": "$today",
            "right": {
              "vop": "choose",
              "cases": [
                {
                  "when": {
                    "op": "ge",
                    "left": "$ay_year",
                    "right": "$revise_long_from_year"
                  },
                  "then": {
                    "vop": "add",
                    "a": {
                      "vop": "mul",
                      "a": {
                        "vop": "add",
                        "a": "$ay_year",
                        "b": 1
                      },
                      "b": 10000
                    },
                    "b": "$revise_late_mmdd"
                  }
                }
              ],
              "else": {
                "vop": "add",
                "a": {
                  "vop": "mul",
                  "a": {
                    "vop": "add",
                    "a": "$ay_year",
                    "b": 0
                  },
                  "b": 10000
                },
                "b": "$revise_mmdd"
              }
            }
          },
          {
            "op": "le",
            "left": "$today",
            "right": {
              "vop": "add",
              "a": {
                "vop": "mul",
                "a": {
                  "vop": "add",
                  "a": "$ay_year",
                  "b": "$updated_years_after"
                },
                "b": 10000
              },
              "b": "$updated_mmdd"
            }
          }
        ]
      },
      "revise_free_by": {
        "vop": "add",
        "a": {
          "vop": "mul",
          "a": {
            "vop": "add",
            "a": "$ay_year",
            "b": 0
          },
          "b": 10000
        },
        "b": "$revise_mmdd"
      },
      "fee_234i": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "all",
              "items": [
                {
                  "op": "ge",
                  "left": "$ay_year",
                  "right": "$revise_long_from_year"
                },
                {
                  "op": "eq",
                  "left": "$has_current",
                  "right": true
                },
                {
                  "op": "gt",
                  "left": "$filed_on",
                  "right": {
                    "vop": "add",
                    "a": {
                      "vop": "mul",
                      "a": {
                        "vop": "add",
                        "a": "$ay_year",
                        "b": 0
                      },
                      "b": 10000
                    },
                    "b": "$revise_mmdd"
                  }
                },
                {
                  "op": "le",
                  "left": "$filed_on",
                  "right": {
                    "vop": "add",
                    "a": {
                      "vop": "mul",
                      "a": {
                        "vop": "add",
                        "a": "$ay_year",
                        "b": 1
                      },
                      "b": 10000
                    },
                    "b": "$revise_late_mmdd"
                  }
                }
              ]
            },
            "then": true
          }
        ],
        "else": false
      },
      "audit_report_by": {
        "vop": "add",
        "a": {
          "vop": "mul",
          "a": {
            "vop": "add",
            "a": "$ay_year",
            "b": 0
          },
          "b": 10000
        },
        "b": {
          "vop": "coalesce",
          "values": [
            {
              "vop": "get",
              "value": "$extensions",
              "path": {
                "vop": "template",
                "text": "{y}.audit_report_mmdd",
                "values": {
                  "vop": "record",
                  "fields": {
                    "y": "$ay_year"
                  }
                }
              }
            },
            "$audit_report_mmdd"
          ]
        }
      },
      "extended_by": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "eq",
              "left": "$audit",
              "right": true
            },
            "then": {
              "vop": "coalesce",
              "values": [
                {
                  "vop": "get",
                  "value": "$extensions",
                  "path": {
                    "vop": "template",
                    "text": "{y}.why",
                    "values": {
                      "vop": "record",
                      "fields": {
                        "y": "$ay_year"
                      }
                    }
                  }
                },
                ""
              ]
            }
          }
        ],
        "else": ""
      }
    }
  },
  "returns": "record",
  "version": 2,
  "status": "published",
  "description_nl": "Income-tax Act dates as amended by the Finance Acts 2025 and 2026: due date u/s 139(1) 31 July (ITR-1 / ITR-2), 31 August for business or profession without audit (ITR-3 / 4 / 5, Finance Act 2026), 31 October with a tax audit, 30 November with a transfer pricing report in Form 3CEB u/s 92E); a belated (139(4)) or revised (139(5)) return by 31 December of the AY; an updated return (ITR-U, 139(8A)) once, within 48 months from the end of the AY. Dates are numbers yyyymmdd so the chip compares them. 2026-10-06: extensions - a year's dates as CBDT extended them by circular (AY 2026-27, Circular 07/2026: audit cases' return 21 November, audit report 21 October); every other year keeps the rule's dates. From AY 2026-27 (Finance Act 2026) a return may be revised to 31 March of the AY - free to 31 December (revise_free_by), then with the s.234I fee (fee_234i). extended_by names the circular only for the returns it covers (audit cases); fee_234i only within the revise window.",
  "test_cases": [
    {
      "args": {
        "ay_year": 2026,
        "audit": true,
        "filed_on": 20261015,
        "today": 20261015
      },
      "expect_value": {
