            "pattern": "\\bpath\\(\\s*r?[\"']([^\"']*)[\"']"
          },
          {
            "framework": "Rails/Express-ish",
            "pattern": "\\b(?:get|post)\\s+[\"']([^\"']+)[\"']\\s*(?:,|=>)"
          },
          {
            "framework": "Laravel",
            "pattern": "\\bRoute::(?:get|post|view)\\(\\s*[\"']([^\"']+)"
          },
          {
            "framework": "Express",
            "pattern": "\\brouter\\.(?:get|post)\\(\\s*[\"'`]([^\"'`]+)"
          },
          {
            "framework": "Spring MVC",
            "pattern": "@(?:Get|Post|Request)Mapping\\(\\s*(?:value\\s*=\\s*)?[\"']([^\"']+)"
          },
          {
            "framework": "JAX-RS",
            "pattern": "@Path\\(\\s*[\"']([^\"']+)"
          },
          {
            "framework": "Struts",
            "pattern": "<action\\s[^>]*path=[\"']([^\"']+)"
          },
          {
            "framework": "ASP.NET attribute routing",
            "pattern": "\\[Route\\(\\s*[\"']([^\"']+)"
          },
          {
            "framework": "Blazor / Razor Pages",
            "pattern": "@page\\s+[\"']([^\"']+)[\"']"
          },
          {
            "framework": ".NET minimal APIs",
            "pattern": "\\bMap(?:Get|Post|Razor|Fallback)?\\w*\\(\\s*[\"']([^\"']+)"
          }
        ],
        "api_route": "(?i)^/?(api|v\\d+|graphql|health|static|assets|_)(/|$)",
        "not_a_screen": "(?i)^(index|_app|_document|layout|_layout|_viewstart|_viewimports|_host|main|app|base|partial|head|header|footer|nav|menu|sidebar|program|startup|global|assemblyinfo|routes|router|styles|theme|themes|resources|strings|colors|dimens)$",
        "code_behind": "(?i)\\.(aspx|ascx|master|razor|xaml|axaml|cshtml)\\.(cs|vb)$",
        "resource_layout": "(?i)(^|/)res/layout[^/]*/",
        "titles": [
          "(?is)<title[^>]*>([^<]{2,80})</title>",
          "(?is)<h1[^>]*>([^<]{2,80})</h1>"
        ],
        "title_rejects": [
          "{{",
          "{%"
        ],
        "file_extension": "\\.[A-Za-z0-9]{1,9}$",
        "role_suffix": "(?i)\\.(page|screen|view|component|designer|razor|xaml|aspx|ascx)$",
        "word_separators": [
          "_",
          "-"
        ],
        "camel_boundary": "([a-z0-9])([A-Z])",
        "camel_replacement": "\\1 \\2",
        "key_unsafe": "[^a-z0-9]+"
      }
    }
  ],
  "weight_basis": "Portal business setting of the Training & Video Portal. The knobs ARE the policy — edit them here, never in Python."
}
