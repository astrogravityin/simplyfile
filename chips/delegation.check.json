      "args": {
        "kind": "filing",
        "kinds": [
          "filing",
          "client",
          "year_some",
          "year_all",
          "portal"
        ],
        "from_owner": false,
        "self": false,
        "to_ok": true,
        "to_in_firm": true,
        "grants": [
          "compute.signoff"
        ],
        "mine": [
          "clients",
          "clients.create",
          "clients.archive",
          "intake",
          "intake.delete",
          "recon",
          "recon.delete",
          "compute",
          "compute.signoff",
          "compute.file",
          "compute.reopen",
          "itrimport",
          "audit",
          "audit.clear"
        ],
        "n_clients": 1,
        "has_ay": true,
        "days": 30,
        "max_days": 366
      },
      "expect_value": {
        "ok": true,
        "say": "d_made"
      }
    },
