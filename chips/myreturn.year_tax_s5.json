{
  "chip_id": "myreturn.year_tax_s5",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: the tax of an earlier year, stage 5 of 5 (tax)",
  "aliases": [],
  "params": [
    {
      "name": "fy",
      "type": "number",
      "default": 2019,
      "label": "the financial year (its first year)"
    },
    {
      "name": "regime",
      "type": "text",
      "default": "old",
      "label": "old / new"
    },
    {
      "name": "band",
      "type": "text",
      "default": "below60",
      "label": "below60 / 60to80 / 80plus that year"
    },
    {
      "name": "resident",
      "type": "boolean",
      "default": true,
      "label": "resident that year (the unused basic exemption against special-rate gains, 87A)"
    },
    {
      "name": "normal",
      "type": "number",
      "default": 0,
      "label": "income at the slab rates"
    },
    {
      "name": "stcg_111a",
      "type": "number",
      "default": 0,
      "label": "short-term gains taxed u/s 111A"
    },
    {
      "name": "ltcg_112a",
      "type": "number",
      "default": 0,
      "label": "long-term gains u/s 112A (before its exemption)"
    },
    {
      "name": "ltcg_112",
      "type": "number",
      "default": 0,
      "label": "long-term gains u/s 112 (after indexation when that year's 112 had it)"
    },
    {
      "name": "special",
      "type": "number",
      "default": 0,
      "label": "income at 30%: 115BB / 115BBJ / 115BBH"
    },
    {
      "name": "early",
      "type": "boolean",
      "default": false,
      "label": "FY 2024-25: the gains were on transfers before 23 July 2024"
    },
    {
      "name": "b",
      "type": "json",
      "default": {},
      "label": "what stage 4 worked out"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "known": {
        "vop": "get",
        "value": "$b",
        "path": "known"
      },
      "total": {
        "vop": "get",
        "value": "$b",
        "path": "total"
      },
      "on_normal": {
        "vop": "get",
        "value": "$b",
        "path": "on_normal"
      },
      "on_111a": {
        "vop": "get",
        "value": "$b",
        "path": "on_111a"
      },
      "on_112a": {
        "vop": "get",
        "value": "$b",
        "path": "on_112a"
      },
      "on_112": {
        "vop": "get",
        "value": "$b",
        "path": "on_112"
      },
      "on_special": {
        "vop": "get",
        "value": "$b",
        "path": "on_special"
      },
      "rebate": {
        "vop": "get",
        "value": "$b",
        "path": "rebate"
      },
      "surcharge_rate": {
        "vop": "get",
        "value": "$b",
        "path": "surcharge_rate"
      },
      "surcharge": {
        "vop": "get",
        "value": "$b",
        "path": "surcharge"
      },
      "cess": {
        "vop": "get",
        "value": "$b",
        "path": "cess"
      },
      "tax": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "eq",
              "left": {
                "vop": "get",
                "value": "$b",
                "path": "known"
              },
              "right": true
            },
            "then": {
              "vop": "round_to",
              "value": {
                "vop": "total",
                "values": [
                  {
                    "vop": "sub",
                    "a": {
                      "vop": "total",
                      "values": [
                        {
                          "vop": "get",
                          "value": "$b",
                          "path": "on_normal"
                        },
                        {
                          "vop": "get",
                          "value": "$b",
                          "path": "on_111a"
                        },
                        {
                          "vop": "get",
                          "value": "$b",
                          "path": "on_112a"
                        },
                        {
                          "vop": "get",
                          "value": "$b",
                          "path": "on_112"
                        },
                        {
                          "vop": "get",
                          "value": "$b",
                          "path": "on_special"
                        }
                      ]
                    },
                    "b": {
                      "vop": "get",
                      "value": "$b",
                      "path": "rebate"
                    }
                  },
                  {
                    "vop": "get",
                    "value": "$b",
                    "path": "surcharge"
                  },
                  {
                    "vop": "get",
                    "value": "$b",
                    "path": "cess"
                  }
                ]
              }
            }
          }
        ],
        "else": 0
      }
    }
  },
  "returns": "record",
  "version": 1,
  "status": "published",
  "description_nl": "2026-10-10: part of chip myreturn.year_tax, split so that no field holds a copy of another (see tools/slim_myreturn_tax.py). Stage 5 works out tax from its knobs and what stage 4 worked out (b) - and answers the whole record.",
  "test_cases": [
    {
      "args": {
        "b": {
          "known": null,
          "total": null,
          "on_normal": null,
          "_raw_on_normal": null,
          "on_111a": null,
          "_raw_on_111a": null,
          "on_112a": null,
          "_raw_on_112a": null,
          "on_112": null,
          "_raw_on_112": null,
          "on_special": null,
          "_raw_on_special": null,
          "rebate": null,
          "surcharge_rate": null,
          "surcharge": null,
          "cess": null,
          "_raw_cess": null
        }
      },
      "expect_value": {
        "known": null,
        "total": null,
        "on_normal": null,
        "on_111a": null,
        "on_112a": null,
        "on_112": null,
        "on_special": null,
        "rebate": null,
        "surcharge_rate": null,
        "surcharge": null,
        "cess": null,
        "tax": 0
      }
    },
    {
      "args": {
        "fy": 2022,
        "normal": 5100000,
        "stcg_111a": 400000,
        "ltcg_112a": 300000,
        "ltcg_112": 200000,
        "special": 100000,
        "regime": "old",
        "b": {
          "known": null,
          "total": null,
          "on_normal": null,
          "_raw_on_normal": null,
          "on_111a": null,
          "_raw_on_111a": null,
          "on_112a": null,
          "_raw_on_112a": null,
          "on_112": null,
          "_raw_on_112": null,
          "on_special": null,
          "_raw_on_special": null,
          "rebate": null,
          "surcharge_rate": null,
          "surcharge": null,
          "cess": null,
          "_raw_cess": null
        }
      },
      "expect_value": {
        "known": null,
        "total": null,
        "on_normal": null,
        "on_111a": null,
        "on_112a": null,
        "on_112": null,
        "on_special": null,
        "rebate": null,
        "surcharge_rate": null,
        "surcharge": null,
        "cess": null,
        "tax": 0
      }
    }
  ]
}
