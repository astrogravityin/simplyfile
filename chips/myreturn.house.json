{
  "chip_id": "myreturn.house",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: one house property, per regime",
  "aliases": [
    "my return: one house property, per regim"
  ],
  "params": [
    {
      "name": "kind",
      "type": "text",
      "default": "self",
      "label": "self (self-occupied) or let (let out / deemed let out)"
    },
    {
      "name": "rent",
      "type": "number",
      "default": 0,
      "label": "rent received for the year"
    },
    {
      "name": "municipal_tax",
      "type": "number",
      "default": 0,
      "label": "municipal tax paid"
    },
    {
      "name": "interest",
      "type": "number",
      "default": 0,
      "label": "home-loan interest u/s 24(b)"
    },
    {
      "name": "regime",
      "type": "text",
      "default": "new",
      "label": "regime"
    },
    {
      "name": "share",
      "type": "number",
      "default": 100,
      "label": "the person's share of the property, percent (s.26: each co-owner is assessed on their share)"
    },
    {
      "name": "pre_total",
      "type": "number",
      "default": 0,
      "label": "s.24(b): interest for the period before the house was bought / built"
    },
    {
      "name": "completed",
      "type": "text",
      "default": "",
      "label": "the day the house was bought / finished, YYYY-MM-DD"
    },
    {
      "name": "fy",
      "type": "number",
      "default": 2025,
      "label": "this return's financial year (the year it starts)"
    }
  ],
  "expr": {
    "vop": "record",
    "fields": {
      "share": "$share",
      "balance": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "eq",
              "left": "$kind",
              "right": "self"
            },
            "then": 0
          }
        ],
        "else": {
          "vop": "largest",
          "values": [
            {
              "vop": "sub",
              "a": "$rent",
              "b": "$municipal_tax"
            },
            0
          ]
        }
      },
      "nav": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "eq",
              "left": "$kind",
              "right": "self"
            },
            "then": 0
          }
        ],
        "else": {
          "vop": "largest",
          "values": [
            {
              "vop": "sub",
              "a": {
                "vop": "round_to",
                "value": {
                  "vop": "div",
                  "a": {
                    "vop": "mul",
                    "a": "$rent",
                    "b": "$share"
                  },
                  "b": 100
                }
              },
              "b": {
                "vop": "round_to",
                "value": {
                  "vop": "div",
                  "a": {
                    "vop": "mul",
                    "a": "$municipal_tax",
                    "b": "$share"
                  },
                  "b": 100
                }
              }
            },
            0
          ]
        }
      },
      "std": {
        "vop": "round_to",
        "value": {
          "vop": "mul",
          "a": {
            "vop": "choose",
            "cases": [
              {
                "when": {
                  "op": "eq",
                  "left": "$kind",
                  "right": "self"
                },
                "then": 0
              }
            ],
            "else": {
              "vop": "largest",
              "values": [
                {
                  "vop": "sub",
                  "a": {
                    "vop": "round_to",
                    "value": {
                      "vop": "div",
                      "a": {
                        "vop": "mul",
                        "a": "$rent",
                        "b": "$share"
                      },
                      "b": 100
                    }
                  },
                  "b": {
                    "vop": "round_to",
                    "value": {
                      "vop": "div",
                      "a": {
                        "vop": "mul",
                        "a": "$municipal_tax",
                        "b": "$share"
                      },
                      "b": 100
                    }
                  }
                },
                0
              ]
            }
          },
          "b": {
            "vop": "div",
            "a": {
              "vop": "get",
              "value": {
                "chip": "myreturn.rates",
                "args": {}
              },
              "path": "hp_std_pct"
            },
            "b": 100
          }
        }
      },
      "interest": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "eq",
              "left": "$kind",
              "right": "self"
            },
            "then": {
              "vop": "smallest",
              "values": [
                {
                  "vop": "round_to",
                  "value": {
                    "vop": "div",
                    "a": {
                      "vop": "mul",
                      "a": {
                        "vop": "add",
                        "a": "$interest",
                        "b": {
                          "vop": "get",
                          "value": {
                            "chip": "myreturn.pre_construction",
                            "args": {
                              "total": "$pre_total",
                              "completed": "$completed",
                              "fy": "$fy"
                            }
                          },
                          "path": "this_year"
                        }
                      },
                      "b": "$share"
                    },
                    "b": 100
                  }
                },
                {
                  "vop": "get",
                  "value": {
                    "chip": "myreturn.rates",
                    "args": {}
                  },
                  "path": {
                    "vop": "template",
                    "text": "self_interest_cap.{r}",
                    "values": {
                      "vop": "record",
                      "fields": {
                        "r": "$regime"
                      }
                    }
                  }
                }
              ]
            }
          }
        ],
        "else": {
          "vop": "round_to",
          "value": {
            "vop": "div",
            "a": {
              "vop": "mul",
              "a": {
                "vop": "add",
                "a": "$interest",
                "b": {
                  "vop": "get",
                  "value": {
                    "chip": "myreturn.pre_construction",
                    "args": {
                      "total": "$pre_total",
                      "completed": "$completed",
                      "fy": "$fy"
                    }
                  },
                  "path": "this_year"
                }
              },
              "b": "$share"
            },
            "b": 100
          }
        }
      },
      "net": {
        "vop": "sub",
        "a": {
          "vop": "sub",
          "a": {
            "vop": "choose",
            "cases": [
              {
                "when": {
                  "op": "eq",
                  "left": "$kind",
                  "right": "self"
                },
                "then": 0
              }
            ],
            "else": {
              "vop": "largest",
              "values": [
                {
                  "vop": "sub",
                  "a": {
                    "vop": "round_to",
                    "value": {
                      "vop": "div",
                      "a": {
                        "vop": "mul",
                        "a": "$rent",
                        "b": "$share"
                      },
                      "b": 100
                    }
                  },
                  "b": {
                    "vop": "round_to",
                    "value": {
                      "vop": "div",
                      "a": {
                        "vop": "mul",
                        "a": "$municipal_tax",
                        "b": "$share"
                      },
                      "b": 100
                    }
                  }
                },
                0
              ]
            }
          },
          "b": {
            "vop": "round_to",
            "value": {
              "vop": "mul",
              "a": {
                "vop": "choose",
                "cases": [
                  {
                    "when": {
                      "op": "eq",
                      "left": "$kind",
                      "right": "self"
                    },
                    "then": 0
                  }
                ],
                "else": {
                  "vop": "largest",
                  "values": [
                    {
                      "vop": "sub",
                      "a": {
                        "vop": "round_to",
                        "value": {
                          "vop": "div",
                          "a": {
                            "vop": "mul",
                            "a": "$rent",
                            "b": "$share"
                          },
                          "b": 100
                        }
                      },
                      "b": {
                        "vop": "round_to",
                        "value": {
                          "vop": "div",
                          "a": {
                            "vop": "mul",
                            "a": "$municipal_tax",
                            "b": "$share"
                          },
                          "b": 100
                        }
                      }
                    },
                    0
                  ]
                }
              },
              "b": {
                "vop": "div",
                "a": {
                  "vop": "get",
                  "value": {
                    "chip": "myreturn.rates",
                    "args": {}
                  },
                  "path": "hp_std_pct"
                },
                "b": 100
              }
            }
          }
        },
        "b": {
          "vop": "choose",
          "cases": [
            {
              "when": {
                "op": "eq",
                "left": "$kind",
                "right": "self"
              },
              "then": {
                "vop": "smallest",
                "values": [
                  {
                    "vop": "round_to",
                    "value": {
                      "vop": "div",
                      "a": {
                        "vop": "mul",
                        "a": {
                          "vop": "add",
                          "a": "$interest",
                          "b": {
                            "vop": "get",
                            "value": {
                              "chip": "myreturn.pre_construction",
                              "args": {
                                "total": "$pre_total",
                                "completed": "$completed",
                                "fy": "$fy"
                              }
                            },
                            "path": "this_year"
                          }
                        },
                        "b": "$share"
                      },
                      "b": 100
                    }
                  },
                  {
                    "vop": "get",
                    "value": {
                      "chip": "myreturn.rates",
                      "args": {}
                    },
                    "path": {
                      "vop": "template",
                      "text": "self_interest_cap.{r}",
                      "values": {
                        "vop": "record",
                        "fields": {
                          "r": "$regime"
                        }
                      }
                    }
                  }
                ]
              }
            }
          ],
          "else": {
            "vop": "round_to",
            "value": {
              "vop": "div",
              "a": {
                "vop": "mul",
                "a": {
                  "vop": "add",
                  "a": "$interest",
                  "b": {
                    "vop": "get",
                    "value": {
                      "chip": "myreturn.pre_construction",
                      "args": {
                        "total": "$pre_total",
                        "completed": "$completed",
                        "fy": "$fy"
                      }
                    },
                    "path": "this_year"
                  }
                },
                "b": "$share"
              },
              "b": 100
            }
          }
        }
      }
    }
  },
  "returns": "record",
  "version": 3,
  "status": "published",
  "description_nl": "2026-10-06: self-occupied: annual value nil, interest up to 2 lakh (old regime; nil in the new). Let out: rent less municipal tax, 30% off, then interest in full. 2026-10-07: co-owned (s.26): rent, municipal tax and loan interest each by the person's share; the 30% is on the share's annual value; a self-occupied house's 2 lakh cap applies to each co-owner on their share. balance is the whole property's annual value (Schedule HP BalanceALV), nav the share. 2026-10-07: pre-construction interest (s.24(b) Explanation): one fifth of it in each of five years from the year the house was bought / finished (chip myreturn.pre_construction), added to the year's interest - inside the 2 lakh cap for a self-occupied house, by the share for a co-owner.",
  "test_cases": [
    {
      "args": {
        "kind": "self",
        "interest": 350000,
        "regime": "old"
      },
      "expect_value": {
        "share": 100,
        "balance": 0,
        "nav": 0,
        "std": 0,
        "interest": 200000,
        "net": -200000
      }
    },
    {
      "args": {
        "kind": "self",
        "interest": 350000,
        "regime": "new"
      },
      "expect_value": {
        "share": 100,
        "balance": 0,
        "nav": 0,
        "std": 0,
        "interest": 0,
        "net": 0
      }
    },
    {
      "args": {
        "kind": "let",
        "rent": 300000,
        "municipal_tax": 20000,
        "interest": 100000,
        "regime": "new"
      },
      "expect_value": {
        "share": 100,
        "balance": 280000,
        "nav": 280000,
        "std": 84000,
        "interest": 100000,
        "net": 96000
      }
    },
    {
      "args": {
        "kind": "self",
        "interest": 500000,
        "regime": "old",
        "share": 50
      },
      "expect_value": {
        "share": 50,
        "balance": 0,
        "nav": 0,
        "std": 0,
        "interest": 200000,
        "net": -200000
      }
    },
    {
      "args": {
        "kind": "let",
        "rent": 300000,
        "municipal_tax": 20000,
        "interest": 100000,
        "regime": "old",
        "share": 50
      },
      "expect_value": {
        "share": 50,
        "balance": 280000,
        "nav": 140000,
        "std": 42000,
        "interest": 50000,
        "net": 48000
      }
    },
    {
      "args": {
        "kind": "self",
        "interest": 180000,
        "regime": "old",
        "pre_total": 250000,
        "completed": "2023-09-01"
      },
      "expect_value": {
        "share": 100,
        "balance": 0,
        "nav": 0,
        "std": 0,
        "interest": 200000,
        "net": -200000
      }
    },
    {
      "args": {
        "kind": "let",
        "rent": 300000,
        "municipal_tax": 0,
        "interest": 100000,
        "regime": "new",
        "pre_total": 250000,
        "completed": "2023-09-01"
      },
      "expect_value": {
        "share": 100,
        "balance": 300000,
        "nav": 300000,
        "std": 90000,
        "interest": 150000,
        "net": 60000
      }
    },
    {
      "args": {
        "kind": "let",
        "rent": 300000,
        "interest": 100000,
        "regime": "new",
        "pre_total": 250000,
        "completed": "2023-09-01",
        "share": 50
      },
      "expect_value": {
        "share": 50,
        "balance": 300000,
        "nav": 150000,
        "std": 45000,
        "interest": 75000,
        "net": 30000
      }
    }
  ]
}
