  "expr": {
    "vop": "record",
    "fields": {
      "known": {
        "vop": "choose",
        "cases": [
          {
            "when": {
              "op": "ge",
              "left": {
                "vop": "coalesce",
                "values": [
                  {
                    "vop": "get",
                    "value": {
                      "chip": "myreturn.slabs_by_year",
                      "args": {}
                    },
                    "path": {
                      "vop": "template",
                      "text": "years.{y}.{r}.rebate_upto",
                      "values": {
                        "vop": "record",
                        "fields": {
                          "y": "$fy",
                          "r": "$regime"
                        }
                      }
                    }
                  },
                  0
                ]
              },
              "right": 1
            },
            "then": true
          }
        ],
        "else": false
      },
      "rebate_upto": {
        "vop": "get",
        "value": {
          "chip": "myreturn.slabs_by_year",
          "args": {}
        },
        "path": {
          "vop": "template",
          "text": "years.{y}.{r}.rebate_upto",
          "values": {
            "vop": "record",
            "fields": {
              "y": "$fy",
              "r": "$regime"
            }
          }
        }
