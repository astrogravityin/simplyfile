      "default": [
        {
          "id": "private",
          "label": "Private limited",
          "code": "7"
        },
        {
          "id": "public",
          "label": "Public limited (unlisted)",
          "code": "6"
        },
        {
          "id": "listed",
          "label": "Public limited (listed)",
          "code": "6",
          "listed": true
        },
        {
          "id": "opc",
          "label": "One person company",
          "code": "7"
        }
      ],
      "label": "kinds of domestic company (the code is ITR-6 StatusOrCompanyType: 6 public, 7 private)"
    },
    {
      "name": "options",
      "type": "json",
      "default": [
        {
          "id": "normal",
          "label": "Normal provisions (25% / 30%, MAT applies)"
        },
        {
          "id": "115BA",
          "label": "s.115BA (25%, manufacturing, opted earlier)"
        },
        {
          "id": "115BAA",
          "label": "s.115BAA (22% + 10% surcharge, no MAT)"
        },
        {
          "id": "115BAB",
          "label": "s.115BAB (15% new manufacturing + 10% surcharge, no MAT)"
        }
      ],
      "label": "the tax options a domestic company may be under"
    },
    {
      "name": "designations",
      "type": "json",
      "default": [
        {
          "id": "MD",
          "label": "Managing director"
        },
        {
          "id": "DIR",
          "label": "Director"
        },
        {
          "id": "CFO",
          "label": "CFO"
        },
        {
          "id": "SEC",
          "label": "Company secretary"
        }
      ],
      "label": "key persons' designations (ITR-6 KeyPersons codes)"
