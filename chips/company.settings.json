      "label": "the verification capacity of a signing key person"
    },
    {
      "name": "cin_pattern",
      "type": "text",
      "default": "^[LU][0-9]{5}[A-Z]{2}[0-9]{4}(PTC|PLC|OPC|NPL|ULL|ULT|FTC|GOI|SGC|GAT|GAP)[0-9]{6}$",
      "label": "CIN shape (MCA: 21 characters)"
    },
    {
      "name": "din_pattern",
      "type": "text",
      "default": "^[0-9]{8}$",
      "label": "DIN shape (8 digits)"
    },
    {
      "name": "default_ay",
      "type": "text",
      "default": "2026-27",
      "label": "the AY whose rates are verified; another AY uses them with a warning"
    },
    {
      "name": "rates_by_ay",
      "type": "json",
      "default": {
        "2026-27": {
          "turnover_limit": 4000000000,
          "turnover_py": "2023-24",
          "base_low": 25,
          "base_high": 30,
          "bands": [
            {
              "above": 10000000,
              "rate": 7
            },
            {
              "above": 100000000,
              "rate": 12
            }
          ],
          "options": {
            "115BA": {
              "rate": 25,
              "steps": [
                {
                  "above": 10000000,
                  "rate": 7
                },
                {
                  "above": 100000000,
                  "rate": 12
                }
              ],
              "mat": true,
              "addl_dep": false,
              "via": "all"
            },
            "115BAA": {
              "rate": 22,
              "steps": [
                {
                  "above": 0,
                  "rate": 10
                }
              ],
              "mat": false,
              "addl_dep": false,
              "via": "baa"
            },
            "115BAB": {
              "rate": 15,
              "other_rate": 22,
              "steps": [
                {
                  "above": 0,
                  "rate": 10
                }
              ],
              "mat": false,
              "addl_dep": false,
              "via": "baa",
              "split_business": true
            }
          },
          "mat_rate": 15,
          "cess_pct": 4,
          "round_to": 10,
          "cg": {
            "stcg_111a": 20,
            "ltcg_112a": 12.5,
            "ltcg_112": 12.5,
            "exempt_112a": 125000
          },
          "source": "Finance Act 2026, First Schedule Part I-A Para E (rates unchanged from AY 2025-26 - Memorandum to the Finance Bill 2026, https://www.indiabudget.gov.in/doc/memo.pdf); CBDT ITR-6 validation rules V1.0 AY 2026-27 (rates table), https://www.incometax.gov.in/iec/foportal/downloads"
        }
