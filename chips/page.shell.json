      "name": "deck",
      "type": "record",
      "default": {
        "api": "/api/decks",
        "screen": "decks",
        "keep": "sm.deck",
        "formats": [
          "pdf",
          "pptx"
        ],
        "words": "decks",
        "theme_keep": "deck.theme",
        "order": "name"
      },
      "label": "Decks (2026-09-30): the routes a PDF & PowerPoint button calls, the screen Save to Decks opens and the key it keeps order: how ticked works line up before a person moves one - 'name' = by name, numbers counted (Ch 2 before Ch 10); 'ticked' = as ticked (2026-09-30 owner: six chapters came out 1 2 3 6 5 4)"
    },
    {
      "name": "off_buttons",
      "type": "any",
      "default": {
        "toast": "warn",
        "seconds": 6,
        "fallback_word": "off_default"
      },
      "label": "off buttons"
    },
    {
      "name": "pick_many",
      "type": "json",
      "default": {
        "rows": 40
      },
      "label": "pickMany: at most this many tick rows drawn at once (type to narrow the rest)"
