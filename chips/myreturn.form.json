{
  "chip_id": "myreturn.form",
  "kind": "accessor",
  "set": "myreturn",
  "label": "My return: which ITR form (1, 2, 3 or 4), and why",
  "aliases": [
    "my return: itr-1 or itr-2, and why"
  ],
  "params": [
    {
      "name": "resident",
      "type": "boolean",
      "default": true,
      "label": "resident (ordinarily)"
    },
    {
      "name": "total",
      "type": "number",
      "default": 0,
      "label": "total income"
    },
    {
      "name": "houses",
      "type": "number",
      "default": 0,
      "label": "house properties"
    },
    {
      "name": "ltcg_112a",
      "type": "number",
      "default": 0,
      "label": "112A gains"
    },
    {
      "name": "other_cg",
      "type": "boolean",
      "default": false,
      "label": "any other capital gain or loss (111A, 112, a loss)"
    },
    {
      "name": "agri",
      "type": "number",
      "default": 0,
      "label": "agricultural income"
    },
    {
      "name": "director",
      "type": "boolean",
      "default": false,
      "label": "a company director"
    },
    {
      "name": "unlisted",
      "type": "boolean",
      "default": false,
      "label": "held unlisted shares in the year"
    },
    {
      "name": "foreign",
      "type": "boolean",
      "default": false,
      "label": "foreign assets or income"
    },
    {
      "name": "loss_cf",
      "type": "boolean",
      "default": false,
      "label": "losses brought or carried forward"
    },
    {
      "name": "other",
      "type": "boolean",
      "default": false,
      "label": "lottery, ESOP deferral, a second set of specials"
    },
    {
      "name": "business",
      "type": "boolean",
      "default": false,
      "label": "presumptive business / profession income (44AD, 44ADA)"
    },
    {
      "name": "over_limit",
      "type": "boolean",
      "default": false,
      "label": "receipts over the presumptive limit"
    },
    {
      "name": "huf",
      "type": "boolean",
      "default": false,
      "label": "a Hindu undivided family"
    },
    {
      "name": "special",
      "type": "boolean",
      "default": false,
      "label": "winnings (115BB / 115BBJ) or virtual digital assets (115BBH)"
    },
    {
      "name": "books",
      "type": "boolean",
      "default": false,
      "label": "business / profession income from the person's own profit and loss (not presumptive)"
    },
    {
      "name": "clubbing",
      "type": "boolean",
      "default": false,
      "label": "a spouse's / minor child's income clubbed (s.64) - shown in Schedule SPI, which ITR-1 / ITR-4 do not have"
    }
  ],
  "expr": {
    "vop": "choose",
    "cases": [
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "eq",
              "left": "$business",
              "right": true
            },
            {
              "op": "eq",
              "left": "$over_limit",
              "right": true
            }
          ]
        },
        "then": {
          "vop": "record",
          "fields": {
            "form": "ITR-3",
            "why": "why_biz_limit"
          }
        }
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "eq",
              "left": "$business",
              "right": true
            },
            {
              "op": "eq",
              "left": "$books",
              "right": true
            }
          ]
        },
        "then": {
          "vop": "record",
          "fields": {
            "form": "ITR-3",
            "why": "why_biz_books"
          }
        }
      },
      {
        "when": {
          "op": "all",
          "items": [
            {
              "op": "eq",
              "left": "$business",
              "right": true
            },
            {
              "op": "eq",
              "left": {
                "vop": "get",
                "value": {
                  "vop": "choose",
                  "cases": [
                    {
                      "when": {
                        "op": "not",
                        "item": {
