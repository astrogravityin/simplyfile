{
  "prod_base": "https://sf.valuestream.in",
  "voice": "en-IN-NeerjaNeural",
  "rate": "+0%",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "blur": [
    "#whoami",
    "#userpop .head"
  ],
  "page_key": "sf-case-salary-cg-property",
  "title": "Salary, funds sold and a plot sold",
  "start_url": "/#/wizard",
  "covers": [
    "who it is for",
    "what applies",
    "which form",
    "documents you'll need",
    "drop them in",
    "the client, made for you",
    "what the documents imply",
    "review, then the return"
  ],
  "steps": [
    {
      "chapter": "Salary, funds sold and a plot sold",
      "say": "Salary, mutual funds sold and a plot sold - the documents point to everything else.",
      "do": [
        {
          "wait_for": ".wz-start"
        },
        {
          "wait": 1
        }
      ]
    },
    {
      "chapter": "Who it is for",
      "say": "A person, an HUF, a partnership firm, an LLP, an AOP or BOI, or a company - each card starts its own filing. A trust says Not yet, with what to do meanwhile.",
      "do": [
        {
          "highlight_target": ".wz-who-groups",
          "optional": true,
          "timeout": 5
        },
        {
          "click": "[data-start='individual']"
        },
        {
          "wait_for": ".wz-who"
        },
        {
          "wait": 1
        }
      ]
    },
    {
      "chapter": "What applies",
      "say": "Two employers, shares or funds sold, land sold - the form becomes ITR-2, for the capital gains.",
      "do": [
        {
          "click": "[data-pick='employers']"
        },
        {
          "wait": 0.7
        },
        {
          "click": "[data-pick='shares']"
        },
        {
          "wait": 0.7
        },
        {
          "click": "[data-pick='property']"
        },
        {
          "wait": 0.7
        },
        {
          "highlight_target": ".wz-work|.wz-what",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Which form",
      "say": "The form follows from the picks, with its reason in one line - ITR-1, 2, 3 or 4 for a person or an HUF, ITR-5 for a firm, an LLP or an AOP, ITR-6 for a company.",
      "do": [
        {
          "highlight_target": ".wz-form",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Documents you'll need",
      "say": "Needed, good to have, and what you type in - each with what it is and where to get it: TRACES, the AIS, your employer, CAMS or KFintech, the GST portal, the firm's deed and its books.",
      "do": [
        {
          "click": "[data-go='docs']"
        },
        {
          "wait_for": ".wz-docs"
        },
        {
          "wait": 1
        },
        {
          "highlight_target": ".wz-docs",
          "optional": true,
          "timeout": 5
        },
        {
          "scroll": 420
        }
      ]
    },
    {
      "chapter": "Drop them in",
      "say": "His Form 16 and the AIS go in first. The Form 16 names his PAN but not his name, and the AIS is locked.",
      "do": [
        {
          "click": "[data-go='upload']"
        },
        {
          "wait_for": "[data-drop='wz-file']"
        },
        {
          "wait": 0.5
        },
        {
          "upload": "#wz-file",
          "files": [
            "showcase/wizard-sal/1 Form 16 - Demo Analytics - AY 2026-27.pdf",
            "showcase/wizard-sal/2 AIS - ZZDPR0047N - FY 2025-26.pdf"
          ]
        },
        {
          "wait": 5.0
        }
      ]
    },
    {
      "chapter": "The client, made for you",
      "say": "The popup asks his name and date of birth. With the date, the locked AIS opens by itself.",
      "do": [
        {
          "wait_for": ".wz-ask-modal",
          "timeout": 40
        },
        {
          "wait": 1.5
        },
        {
          "fill": "[data-ask='name']",
          "text": "Ravi Demo Salaried",
          "optional": true
        },
        {
          "fill": "[data-ask='dob']",
          "text": "1986-02-11",
          "optional": true
        },
        {
          "wait": 1
        },
        {
          "click": ".wz-ask-modal [data-save]"
        },
        {
          "wait": 3
        },
        {
          "highlight_target": ".wz-client",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "What the documents imply",
      "say": "The AIS shows fund sales - upload the CAMS statement. The 26AS shows 194IA TDS on a plot - enter the sale. Another employer's TAN - its Form 16.",
      "do": [
        {
          "upload": "#wz-file",
          "files": [
            "showcase/wizard-sal/3 26AS - ZZDPR0047N - AY 2026-27.txt",
            "showcase/wizard-sal/4 Form 16 - Demo Cloud Services - AY 2026-27.pdf",
            "showcase/wizard-sal/5 CAMS capital gains - ZZDPR0047N - FY 2025-26.pdf"
          ]
        },
        {
          "wait": 6.5
        },
        {
          "wait": 1
        },
        {
          "highlight_target": ".wz-prompts",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Review, then the return",
      "say": "Every needed document in; the plot's sale figures wait in My return's Review.",
      "do": [
        {
          "click": "[data-go='review']"
        },
        {
          "wait_for": ".wz-review"
        },
        {
          "wait": 1.5
        },
        {
          "highlight_target": ".wz-go|.wz-review",
          "optional": true,
          "timeout": 5
        },
        {
          "wait": 1
        },
        {
          "click": "#wz-go"
        },
        {
          "wait": 3
        },
        {
          "wait_for": ".mr-rail-card",
          "timeout": 20,
          "optional": true
        },
        {
          "wait": 2
        }
      ]
    }
  ]
}
