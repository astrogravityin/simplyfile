{
  "prod_base": "https://sf.valuestream.in",
  "voice": "en-IN-NeerjaNeural",
  "rate": "+0%",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "blur": [
    "#whoami",
    "#userpop .head"
  ],
  "page_key": "sf-issues",
  "title": "Reported issues",
  "start_url": "/#/issues",
  "covers": [
    "reported issues",
    "the queue",
    "push to",
    "the road it takes",
    "where it goes",
    "kind, title and details",
    "push"
  ],
  "steps": [
    {
      "chapter": "Reported issues",
      "say": "Answer what people report in {product}, or push an issue to CodyFy to be built.",
      "do": [
        {
          "wait_for": "header.pagehead"
        },
        {
          "wait": 1
        }
      ]
    },
    {
      "chapter": "Reported issues",
      "say": "Everything people report from any screen in {product} lands here: who sent it, from which screen, and what is wrong.",
      "do": [
        {
          "highlight_target": "header.pagehead",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "The queue",
      "say": "Open, Resolved and All sort the queue. Each row shows the report, where it came from, and any answer already given.",
      "do": [
        {
          "highlight_target": "#is-list",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Push to",
      "say": "When an issue needs a code change, the portal admin presses Push to on its row.",
      "do": [
        {
          "highlight_target": "[data-push-open]",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "The road it takes",
      "say": "The picture shows the road: this issue becomes a CodyFy request, its build machine writes the change, and a pull request comes back for your review.",
      "do": [
        {
          "click": "[data-push-open]",
          "optional": true
        },
        {
          "wait": 1.2
        },
        {
          "highlight_target": ".push-flow",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Where it goes",
      "say": "The card names the company and project it lands in. The first time, press Connect CodyFy, sign in there and press Allow; nothing to copy. After that the card simply says Connected.",
      "do": [
        {
          "highlight_target": ".push-dests",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Kind, title and details",
      "say": "Pick the kind of request. The title and details come from the issue; change them if you like.",
      "do": [
        {
          "highlight_target": ".push-kinds",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Push",
      "say": "Press Push. The row then shows the request and its stage, with a link to open it in CodyFy.",
      "do": [
        {
          "highlight_target": "#push-go",
          "optional": true,
          "timeout": 5
        }
      ]
    }
  ]
}
