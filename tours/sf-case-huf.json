{
  "prod_base": "https://sf.valuestream.in",
  "voice": "en-IN-NeerjaNeural",
  "rate": "+0%",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "blur": [
    "#whoami",
    "#userpop .head"
  ],
  "page_key": "sf-case-huf",
  "title": "An HUF with a house and capital gains",
  "start_url": "/#/wizard",
  "covers": [
    "who it is for",
    "what applies",
    "which form",
    "documents you'll need",
    "drop them in",
    "the client, made for you",
    "what the documents imply",
    "review, then the return"
  ],
  "steps": [
    {
      "chapter": "An HUF with a house and capital gains",
      "say": "A Hindu undivided family: deposits, a flat let out, and mutual funds sold.",
      "do": [
        {
          "wait_for": ".wz-start"
        },
        {
          "wait": 1
        }
      ]
    },
    {
      "chapter": "Who it is for",
      "say": "A person, an HUF, a partnership firm, an LLP, an AOP or BOI, or a company - each card starts its own filing. A trust says Not yet, with what to do meanwhile.",
      "do": [
        {
          "highlight_target": ".wz-who-groups",
          "optional": true,
          "timeout": 5
        },
        {
          "click": "[data-start='huf']"
        },
        {
          "wait_for": ".wz-who"
        },
        {
          "wait": 1
        }
      ]
    },
    {
      "chapter": "What applies",
      "say": "A family HUF - no salary cards for it. A house, interest, shares or funds sold: ITR-2.",
      "do": [
        {
          "click": "[data-pick='house']"
        },
        {
          "wait": 0.7
        },
        {
          "click": "[data-pick='interest']"
        },
        {
          "wait": 0.7
        },
        {
          "click": "[data-pick='shares']"
        },
        {
          "wait": 0.7
        },
        {
          "highlight_target": ".wz-work|.wz-what",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Which form",
      "say": "The form follows from the picks, with its reason in one line - ITR-1, 2, 3 or 4 for a person or an HUF, ITR-5 for a firm, an LLP or an AOP, ITR-6 for a company.",
      "do": [
        {
          "highlight_target": ".wz-form",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Documents you'll need",
      "say": "Needed, good to have, and what you type in - each with what it is and where to get it: TRACES, the AIS, your employer, CAMS or KFintech, the GST portal, the firm's deed and its books.",
      "do": [
        {
          "click": "[data-go='docs']"
        },
        {
          "wait_for": ".wz-docs"
        },
        {
          "wait": 1
        },
        {
          "highlight_target": ".wz-docs",
          "optional": true,
          "timeout": 5
        },
        {
          "scroll": 420
        }
      ]
    },
    {
      "chapter": "Drop them in",
      "say": "The 26AS and the AIS go in; the 26AS names the HUF, its PAN's fourth letter is H.",
      "do": [
        {
          "click": "[data-go='upload']"
        },
        {
          "wait_for": "[data-drop='wz-file']"
        },
        {
          "wait": 0.5
        },
        {
          "upload": "#wz-file",
          "files": [
            "showcase/wizard-huf/1 26AS - ZZDHW0046M - AY 2026-27.txt",
            "showcase/wizard-huf/2 AIS - ZZDHW0046M - FY 2025-26.csv"
          ]
        },
        {
          "wait": 5.0
        }
      ]
    },
    {
      "chapter": "The client, made for you",
      "say": "The client is made. The popup asks only for the Karta - name and PAN.",
      "do": [
        {
          "wait_for": ".wz-ask-modal",
          "timeout": 40
        },
        {
          "wait": 1.5
        },
        {
          "fill": "[data-ask='karta_name']",
          "text": "Mohan Demo Verma",
          "optional": true
        },
        {
          "fill": "[data-ask='karta_pan']",
          "text": "ZZDPV0046K",
          "optional": true
        },
        {
          "wait": 1
        },
        {
          "click": ".wz-ask-modal [data-save]"
        },
        {
          "wait": 3
        },
        {
          "highlight_target": ".wz-client",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "What the documents imply",
      "say": "The AIS shows a fund sale - upload the CAMS statement. In it goes; the hint is answered.",
      "do": [
        {
          "upload": "#wz-file",
          "files": [
            "showcase/wizard-huf/3 CAMS capital gains - ZZDHW0046M - FY 2025-26.pdf"
          ]
        },
        {
          "wait": 3.5
        },
        {
          "wait": 1
        },
        {
          "highlight_target": ".wz-prompts",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Review, then the return",
      "say": "Into My return for the HUF: the rent, the fund sale and the deposits - signed by the Karta.",
      "do": [
        {
          "click": "[data-go='review']"
        },
        {
          "wait_for": ".wz-review"
        },
        {
          "wait": 1.5
        },
        {
          "highlight_target": ".wz-go|.wz-review",
          "optional": true,
          "timeout": 5
        },
        {
          "wait": 1
        },
        {
          "click": "#wz-go"
        },
        {
          "wait": 3
        },
        {
          "wait_for": ".mr-rail-card",
          "timeout": 20,
          "optional": true
        },
        {
          "wait": 2
        }
      ]
    }
  ]
}
