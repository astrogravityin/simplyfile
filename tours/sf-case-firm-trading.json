{
  "prod_base": "https://sf.valuestream.in",
  "voice": "en-IN-NeerjaNeural",
  "rate": "+0%",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "blur": [
    "#whoami",
    "#userpop .head"
  ],
  "page_key": "sf-case-firm-trading",
  "title": "A trading firm with GST and a tax audit",
  "start_url": "/#/wizard",
  "covers": [
    "who it is for",
    "what applies",
    "which form",
    "documents you'll need",
    "drop them in",
    "the client, made for you",
    "what the documents imply",
    "review, then the return"
  ],
  "steps": [
    {
      "chapter": "A trading firm with GST and a tax audit",
      "say": "A partnership firm that trades, with a GST number and a turnover that needs a tax audit.",
      "do": [
        {
          "wait_for": ".wz-start"
        },
        {
          "wait": 1
        }
      ]
    },
    {
      "chapter": "Who it is for",
      "say": "A person, an HUF, a partnership firm, an LLP, an AOP or BOI, or a company - each card starts its own filing. A trust says Not yet, with what to do meanwhile.",
      "do": [
        {
          "highlight_target": ".wz-who-groups",
          "optional": true,
          "timeout": 5
        },
        {
          "click": "[data-start='firm']"
        },
        {
          "wait_for": ".wz-who"
        },
        {
          "wait": 1
        }
      ]
    },
    {
      "chapter": "What applies",
      "say": "A partnership firm, then the kind of work: trading, GST, a tax audit, partners' salary and interest, stock, depreciation. ITR-5, with Form 3CD.",
      "do": [
        {
          "click": "[data-pick='trading']"
        },
        {
          "wait": 0.7
        },
        {
          "click": "[data-pick='gst']"
        },
        {
          "wait": 0.7
        },
        {
          "click": "[data-pick='audit']"
        },
        {
          "wait": 0.7
        },
        {
          "click": "[data-pick='partners_pay']"
        },
        {
          "wait": 0.7
        },
        {
          "click": "[data-pick='stock']"
        },
        {
          "wait": 0.7
        },
        {
          "click": "[data-pick='depreciation']"
        },
        {
          "wait": 0.7
        },
        {
          "highlight_target": ".wz-work|.wz-what",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Which form",
      "say": "The form follows from the picks, with its reason in one line - ITR-1, 2, 3 or 4 for a person or an HUF, ITR-5 for a firm, an LLP or an AOP, ITR-6 for a company.",
      "do": [
        {
          "highlight_target": ".wz-form",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Documents you'll need",
      "say": "Needed, good to have, and what you type in - each with what it is and where to get it: TRACES, the AIS, your employer, CAMS or KFintech, the GST portal, the firm's deed and its books.",
      "do": [
        {
          "click": "[data-go='docs']"
        },
        {
          "wait_for": ".wz-docs"
        },
        {
          "wait": 1
        },
        {
          "highlight_target": ".wz-docs",
          "optional": true,
          "timeout": 5
        },
        {
          "scroll": 420
        }
      ]
    },
    {
      "chapter": "Drop them in",
      "say": "The GST certificate and the partnership deed first. The certificate gives the GSTIN, the legal name and the constitution.",
      "do": [
        {
          "click": "[data-go='upload']"
        },
        {
          "wait_for": "[data-drop='wz-file']"
        },
        {
          "wait": 0.5
        },
        {
          "upload": "#wz-file",
          "files": [
            "showcase/case-firm-trading/1 GST certificate - Demo Balaji Traders.pdf",
            "showcase/case-firm-trading/2 Partnership deed - Demo Balaji Traders.pdf"
          ]
        },
        {
          "wait": 5.0
        }
      ]
    },
    {
      "chapter": "The client, made for you",
      "say": "The client is made from the certificate - a partnership firm, its GSTIN on it. The popup shows the deed's partners and shares, to confirm.",
      "do": [
        {
          "wait_for": ".wz-ask-modal",
          "timeout": 40
        },
        {
          "wait": 1.5
        },
        {
          "wait": 1
        },
        {
          "click": ".wz-ask-modal [data-save]"
        },
        {
          "wait": 3
        },
        {
          "highlight_target": ".wz-client",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "What the documents imply",
      "say": "Then the 26AS, the books, the GSTR-3B returns and last year's ITR-5. Each goes where the firm's work happens: the books to Intake & map, the 26AS to Reconcile, the GST returns to the tax audit.",
      "do": [
        {
          "upload": "#wz-file",
          "files": [
            "showcase/case-firm-trading/3 26AS - ZZDFB0057J - AY 2026-27.txt",
            "showcase/case-firm-trading/4 Demo Balaji Traders - Trading, P&L and Balance Sheet AY 2026-27.xlsx",
            "showcase/case-firm-trading/5 Demo Balaji Traders - IT Stmt, Dep, Loans AY 2026-27.xlsx",
            "showcase/case-firm-trading/6 GSTR-3B - 36ZZDFB0057J1Z3 - FY 2025-26.zip",
            "showcase/case-firm-trading/7 ITR-5 AY 2025-26 - Demo Balaji Traders - ZZDFB0057J.json"
          ]
        },
        {
          "wait": 9.5
        },
        {
          "wait": 1
        },
        {
          "highlight_target": ".wz-prompts",
          "optional": true,
          "timeout": 5
        }
      ]
    },
    {
      "chapter": "Review, then the return",
      "say": "Review: the books came with their SF Refs and the 26AS is in, so the next screen is the Tax audit - Form 3CD by risk, then Compute & close.",
      "do": [
        {
          "click": "[data-go='review']"
        },
        {
          "wait_for": ".wz-review"
        },
        {
          "wait": 1.5
        },
        {
          "highlight_target": ".wz-go|.wz-review",
          "optional": true,
          "timeout": 5
        },
        {
          "wait": 1
        },
        {
          "click": "#wz-go"
        },
        {
          "wait": 3
        },
        {
          "wait_for": "#au-ay",
          "timeout": 20,
          "optional": true
        },
        {
          "wait": 2
        }
      ]
    }
  ]
}
